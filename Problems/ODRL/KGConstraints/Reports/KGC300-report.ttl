@prefix vrep: <https://w3id.org/odrl-verdict-report#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:KGC300-report a vrep:OperandReport ;
    dcterms:identifier "KGC300" ;
    vrep:leftOperand odrl:language ;
    vrep:sort vrep:nom ;
    vrep:resource <https://example.org/resources/bcp47> ;
    vrep:backgroundTheory <https://example.org/bt/bcp47-uniqueness> ;
    vrep:verdict vrep:Incompatible .
