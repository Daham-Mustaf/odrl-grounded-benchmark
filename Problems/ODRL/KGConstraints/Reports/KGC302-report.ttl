@prefix vrep: <https://w3id.org/odrl-verdict-report#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:KGC302-report a vrep:OperandReport ;
    dcterms:identifier "KGC302" ;
    vrep:leftOperand odrl:spatial ;
    vrep:sort vrep:mer ;
    vrep:resource <https://example.org/resources/geonames-europe> ;
    vrep:backgroundTheory <https://example.org/bt/geonames-admin-siblings> ;
    vrep:verdict vrep:Compatible .
