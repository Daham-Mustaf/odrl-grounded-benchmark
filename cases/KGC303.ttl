# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-303-1 a odrl:Set ;
    odrl:uid drk:policy-303-1 ;
    dcterms:title "Use in exactly one of France and Germany"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC303-p1-r1 .

kgc:KGC303-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC303-p1-lc .

kgc:KGC303-p1-lc a odrl:LogicalConstraint ;
    odrl:xone ( kgc:KGC303-p1-c1 kgc:KGC303-p1-c2 ) .

kgc:KGC303-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand <https://sws.geonames.org/3017382/> .

kgc:KGC303-p1-c2 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand <https://sws.geonames.org/2921044/> .

drk:policy-303-2 a odrl:Set ;
    odrl:uid drk:policy-303-2 ;
    dcterms:title "Use in France"@en ;
    odrl:permission kgc:KGC303-p2-r1 .

kgc:KGC303-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC303-p2-c1 .

kgc:KGC303-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand <https://sws.geonames.org/3017382/> .

### Expected result #######################################################

drk:KGC303-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC303" ;
    vrep:referencePolicy drk:policy-303-1 ;
    vrep:comparedPolicy drk:policy-303-2 ;
    vrep:referenceConstraint kgc:KGC303-p1-lc ;
    vrep:comparedConstraint kgc:KGC303-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-geonames> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/geonames-europe/empty> ;
    vrep:readAgainst drk:KGC304-report ;
    rdfs:comment """GeoNames does not state that France and Germany are different. If they are identified, both alternatives hold and 'exactly one' fails, so the verdict is Unknown."""@en ;
    dcterms:description """A library permits use in exactly one of France and Germany. A researcher's policy commits to use in France."""@en ;
    vrep:compatibilityState vrep:Unknown ;
    vrep:unknownReason vrep:Epistemic .
