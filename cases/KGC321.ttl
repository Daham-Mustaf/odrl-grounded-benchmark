# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ft:      <http://publications.europa.eu/resource/authority/file-type/> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-321-1 a odrl:Set ;
    odrl:uid drk:policy-321-1 ;
    dcterms:title "BSB: PDF"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC321-p1-r1 .

kgc:KGC321-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC321-p1-c1 .

kgc:KGC321-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:fileFormat ;
    odrl:operator odrl:eq ;
    odrl:rightOperand ft:PDF .

drk:policy-321-2 a odrl:Set ;
    odrl:uid drk:policy-321-2 ;
    dcterms:title "BnF: PDF/A-1a"@en ;
    odrl:assignee drk:researcher ;
    odrl:permission kgc:KGC321-p2-r1 .

kgc:KGC321-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC321-p2-c1 .

kgc:KGC321-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:fileFormat ;
    odrl:operator odrl:eq ;
    odrl:rightOperand ft:PDFA1A .

### Expected result #######################################################

drk:KGC321-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC321" ;
    vrep:referencePolicy drk:policy-321-1 ;
    vrep:comparedPolicy drk:policy-321-2 ;
    vrep:referenceConstraint kgc:KGC321-p1-c1 ;
    vrep:comparedConstraint kgc:KGC321-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-fileformat> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/eu-file-type/declared> ;
    vrep:readAgainst drk:KGC320-report ;
    rdfs:comment """The two constraints require ft:PDF and ft:PDFA1A to denote the same element, while the background assertion requires them to denote different elements. The two conditions cannot both hold."""@en ;
    dcterms:description """As KGC320, with the two formats declared distinct."""@en ;
    vrep:compatibilityState vrep:Incompatible ;
    vrep:certificate <certificates/KGC321-1.tstp> .
