@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpvo:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-361 a odrl:Offer ;
    dcterms:title "Use is permitted where encryption and access control are both in place"@en ;
    rdfs:comment "The kind of clause the DPV-ODRL guidance describes for this operand: access to a dataset permitted only where stated measures are implemented. Both are required, not one of them, which is what distinguishes isAllOf from isAnyOf here."@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC361-offer-r1 .

kgc:KGC361-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC361-offer-c1 .

kgc:KGC361-offer-c1 a odrl:Constraint ;
    odrl:leftOperand dpvo:TechnicalOrganisationalMeasure ;
    odrl:operator odrl:isAllOf ;
    odrl:rightOperand ( dpv:Encryption dpv:AccessControlMethod ) .

drk:request-361 a odrl:Request ;
    dcterms:title "Access control is not among the measures applied"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC361-request-r1 .

kgc:KGC361-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC361-request-c1 .

kgc:KGC361-request-c1 a odrl:Constraint ;
    odrl:leftOperand dpvo:TechnicalOrganisationalMeasure ;
    odrl:operator odrl:isNoneOf ;
    odrl:rightOperand ( dpv:AccessControlMethod ) .

### Expected result #######################################################

drk:KGC361-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC361" ;
    report:policy drk:offer-361 ;
    report:policyRequest drk:request-361 ;
    report:constraint kgc:KGC361-offer-c1 ;
    vrep:constraintRequest kgc:KGC361-request-c1 ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-tom/empty> ;
    report:satisfactionState report:Unsatisfied ;
    vrep:certificate drk:KGC361-certificate .

drk:KGC361-certificate a vrep:Refutation ;
    rdfs:comment """No premise of the vocabulary or of the parties is used. The refutation rests on the query formula and on reflexivity of identity: the witness condition requires access control to lie inside a set from which the request excludes it, which is the literal that access control differs from itself."""@en ;
    vrep:clashingConstraint kgc:KGC361-offer-c1, kgc:KGC361-request-c1 ;
    vrep:premise [ vrep:premiseSource vrep:fromEqualityAxiom ;
                   rdfs:label "reflexivity: dpv:AccessControlMethod is itself"@en ] .
