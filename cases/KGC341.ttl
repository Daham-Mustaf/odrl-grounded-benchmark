@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-341-1 a odrl:Set ;
    odrl:uid drk:policy-341-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use is permitted under given or renewed consent"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC341-p1-r1 .
kgc:KGC341-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC341-p1-c1 .
kgc:KGC341-p1-c1 a odrl:LogicalConstraint ;
    odrl:or ( kgc:KGC341-p1-a1 kgc:KGC341-p1-a2 ) .

kgc:KGC341-p1-a1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentGiven .

kgc:KGC341-p1-a2 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:RenewedConsentGiven .

drk:policy-341-2 a odrl:Set ;
    odrl:uid drk:policy-341-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Processing only under renewed consent"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC341-p2-r1 .
kgc:KGC341-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC341-p2-c1 .
kgc:KGC341-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:RenewedConsentGiven .

### Expected result #######################################################

drk:KGC341-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC341" ;
    vrep:referencePolicy drk:policy-341-1 ;
    vrep:comparedPolicy drk:policy-341-2 ;
    vrep:referenceConstraint kgc:KGC341-p1-c1 ;
    vrep:comparedConstraint kgc:KGC341-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-consent-status> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-consent/empty> ;
    rdfs:comment """The required state is one the first policy names, so the constraints settle the verdict without the resource."""@en ;
    dcterms:description """A controller permits use under given or renewed consent. A processor's policy commits to processing only under renewed consent."""@en ;
    vrep:compatibilityState vrep:Compatible ;
