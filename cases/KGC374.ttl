# Generated by the scripts in generators/.

@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-374-1 a odrl:Set ;
    odrl:uid drk:policy-374-1 ;
    dcterms:title "Distribution in German"@en ;
    odrl:assigner drk:publisher ;
    odrl:permission kgc:KGC374-p1-r1 .

kgc:KGC374-p1-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC374-p1-c1 .

kgc:KGC374-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:de .

drk:policy-374-2 a odrl:Set ;
    odrl:uid drk:policy-374-2 ;
    dcterms:title "Anything but French"@en ;
    odrl:assignee drk:reuser ;
    odrl:permission kgc:KGC374-p2-r1 .

kgc:KGC374-p2-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC374-p2-c1 .

kgc:KGC374-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:neq ;
    odrl:rightOperand bcp47:fr .

### Expected result #######################################################

drk:KGC374-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC374" ;
    vrep:referencePolicy drk:policy-374-1 ;
    vrep:comparedPolicy drk:policy-374-2 ;
    vrep:referenceConstraint kgc:KGC374-p1-c1 ;
    vrep:comparedConstraint kgc:KGC374-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/bcp47/uniqueness> ;
    dcterms:description """A publisher distributes in German, while a reuser accepts any language except French."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC374-2.tstp> .
