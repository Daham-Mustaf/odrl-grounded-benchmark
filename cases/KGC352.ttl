# Generated by the scripts in generators/.

@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix eu-gdpr: <https://w3id.org/dpv/legal/eu/gdpr#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:dataset a dcat:Dataset ;
    dcterms:title "Personal data held by a controller"@en .

# The rule's deontic role is not modelled: the verdict decides whether two
# constraint sets admit a common use, not which rule prevails where they do.

drk:policy-352-1 a odrl:Set ;
    odrl:uid drk:policy-352-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use on at least one of the legal bases of Article 6(1)"@en ;
    dcterms:source <https://ai.wu.ac.at/policies/orcp/regulatory-model.html> ;
    rdfs:comment "Adapted from the Article 6 example of the ODRL Regulatory Compliance Profile (ORCP), section 'Article 6 Lawfulness of processing': odrl:predicateConstraint is written as odrl:constraint, orcp:legalBasis as dpv-odrl:LegalBasis, and the seven values ORCP lists for Article 6(1) as DPV concepts, with ExerciseOfOfficialAuthority read as dpv:OfficialAuthorityOfController."@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC352-p1-r1 .

kgc:KGC352-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC352-p1-c1 .

kgc:KGC352-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:LegalBasis ;
    odrl:operator odrl:isAnyOf ;
    odrl:rightOperand ( dpv:Consent
        dpv:Contract
        dpv:LegalObligation
        dpv:VitalInterest
        dpv:PublicInterest
        dpv:OfficialAuthorityOfController
        dpv:LegitimateInterest ) .

drk:policy-352-2 a odrl:Set ;
    odrl:uid drk:policy-352-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use on the basis of explicit consent under Article 6(1)(a) only"@en ;
    odrl:assignee drk:recipient ;
    odrl:permission kgc:KGC352-p2-r1 .

kgc:KGC352-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC352-p2-c1 .

kgc:KGC352-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:LegalBasis ;
    odrl:operator odrl:eq ;
    odrl:rightOperand eu-gdpr:A6-1-a-explicit-consent .

### Expected result #######################################################

drk:KGC352-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC352" ;
    vrep:referencePolicy drk:policy-352-1 ;
    vrep:comparedPolicy drk:policy-352-2 ;
    vrep:referenceConstraint kgc:KGC352-p1-c1 ;
    vrep:comparedConstraint kgc:KGC352-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-legalbasis> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-gdpr-legal-basis/declared> ;
    vrep:readAgainst drk:KGC351-report ;
    rdfs:comment """The declarations declare explicit consent distinct from each of the seven values listed by isAnyOf, so the basis the recipient relies on cannot satisfy the first policy."""@en ;
    dcterms:description """As KGC351, with explicit consent declared distinct from each of the seven bases."""@en ;
    vrep:compatibilityState vrep:Incompatible ;
    vrep:certificate <certificates/KGC352-1.tstp> .
