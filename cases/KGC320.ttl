# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ft:      <http://publications.europa.eu/resource/authority/file-type/> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .

drk:policy-320-1 a odrl:Set ;
    odrl:uid drk:policy-320-1 ;
    dcterms:title "Use in PDF only"@en ;
    odrl:assigner drk:german-library ;
    odrl:permission kgc:KGC320-p1-r1 .

kgc:KGC320-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC320-p1-c1 .

kgc:KGC320-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:fileFormat ;
    odrl:operator odrl:eq ;
    odrl:rightOperand ft:PDF .

drk:policy-320-2 a odrl:Set ;
    odrl:uid drk:policy-320-2 ;
    dcterms:title "Use in PDF/A-1a only"@en ;
    odrl:assignee drk:french-library ;
    odrl:permission kgc:KGC320-p2-r1 .

kgc:KGC320-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC320-p2-c1 .

kgc:KGC320-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:fileFormat ;
    odrl:operator odrl:eq ;
    odrl:rightOperand ft:PDFA1A .

### Expected result #######################################################

drk:KGC320-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC320" ;
    vrep:referencePolicy drk:policy-320-1 ;
    vrep:comparedPolicy drk:policy-320-2 ;
    vrep:referenceConstraint kgc:KGC320-p1-c1 ;
    vrep:comparedConstraint kgc:KGC320-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-fileformat> ;
    vrep:declarations <https://w3id.org/odrl-kb/eu-file-type/empty> ;
    vrep:readAgainst drk:KGC321-report ;
    rdfs:comment """The two constraints can be satisfied both when ft:PDF and ft:PDFA1A denote the same element and when they denote different elements. No resource statement or declaration selects between these possibilities."""@en ;
    dcterms:description """A German library permits use in PDF only. A French library's policy commits to use in PDF/A-1a only."""@en ;
    vrep:compatibilityState vrep:Unknown .
