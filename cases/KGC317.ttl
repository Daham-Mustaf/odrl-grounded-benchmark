# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-317-1 a odrl:Set ;
    odrl:uid drk:policy-317-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Any purpose other than marketing"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC317-p1-r1 .

kgc:KGC317-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC317-p1-c1 .

kgc:KGC317-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:isNoneOf ;
    odrl:rightOperand ( dpv:Marketing ) .

drk:policy-317-2 a odrl:Set ;
    odrl:uid drk:policy-317-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Marketing"@en ;
    odrl:assignee drk:researcher ;
    odrl:permission kgc:KGC317-p2-r1 .

kgc:KGC317-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC317-p2-c1 .

kgc:KGC317-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:Marketing .

### Expected result #######################################################

drk:KGC317-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC317" ;
    vrep:referencePolicy drk:policy-317-1 ;
    vrep:comparedPolicy drk:policy-317-2 ;
    vrep:referenceConstraint kgc:KGC317-p1-c1 ;
    vrep:comparedConstraint kgc:KGC317-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-purposes/empty> ;
    rdfs:comment """The first policy excludes exactly the purpose the second requires, so the verdict is Incompatible without any resource or background assertion."""@en ;
    dcterms:description """A library permits use for any purpose other than marketing. A researcher's policy commits to use for marketing."""@en ;
    vrep:compatibilityState vrep:Incompatible ;
    vrep:certificate <certificates/KGC317-1.tstp> .
