# Generated by the scripts in generators/.

@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:work a dcterms:BibliographicResource ;
    dcterms:title "A work distributed by a publisher"@en .

drk:policy-398-1 a odrl:Set ;
    odrl:uid drk:policy-398-1 ;
    dcterms:title "Distribute in at least one of German and French"@en ;
    odrl:assigner drk:publisher ;
    odrl:permission kgc:KGC398-p1-r1 .

kgc:KGC398-p1-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:work ;
    odrl:constraint kgc:KGC398-p1-c1 .

kgc:KGC398-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:isAnyOf ;
    odrl:rightOperand ( bcp47:de bcp47:fr ) .

drk:policy-398-2 a odrl:Set ;
    odrl:uid drk:policy-398-2 ;
    dcterms:title "Distribute in both Dutch and French"@en ;
    odrl:assignee drk:licensee ;
    odrl:permission kgc:KGC398-p2-r1 .

kgc:KGC398-p2-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:work ;
    odrl:constraint kgc:KGC398-p2-c1 .

kgc:KGC398-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:isAllOf ;
    odrl:rightOperand ( bcp47:nl bcp47:fr ) .

### Expected result #######################################################

drk:KGC398-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC398" ;
    vrep:referencePolicy drk:policy-398-1 ;
    vrep:comparedPolicy drk:policy-398-2 ;
    vrep:referenceConstraint kgc:KGC398-p1-c1 ;
    vrep:comparedConstraint kgc:KGC398-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47> ;
    vrep:declarations <https://w3id.org/odrl-kb/bcp47/empty> ;
    rdfs:comment """French is on the licence's list and in the licensee's pair, so a use in Dutch and French meets both policies whatever the IANA registry leaves open."""@en ;
    dcterms:description """A translation licence covers at least one of a German and a French edition. The licensee publishes in both Dutch and French."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC398-2.tstp> .
