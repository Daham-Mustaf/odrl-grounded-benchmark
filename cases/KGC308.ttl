# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .

drk:policy-308-1 a odrl:Set ;
    odrl:uid drk:policy-308-1 ;
    dcterms:title "Use within Germany"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC308-p1-r1 .

kgc:KGC308-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC308-p1-c1 .

kgc:KGC308-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand <https://sws.geonames.org/2921044/> .

drk:policy-308-2 a odrl:Set ;
    odrl:uid drk:policy-308-2 ;
    dcterms:title "Use in France only"@en ;
    odrl:assignee drk:researcher ;
    odrl:permission kgc:KGC308-p2-r1 .

kgc:KGC308-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC308-p2-c1 .

kgc:KGC308-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand <https://sws.geonames.org/3017382/> .

### Expected result #######################################################

drk:KGC308-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC308" ;
    vrep:referencePolicy drk:policy-308-1 ;
    vrep:comparedPolicy drk:policy-308-2 ;
    vrep:referenceConstraint kgc:KGC308-p1-c1 ;
    vrep:comparedConstraint kgc:KGC308-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-geonames> ;
    vrep:declarations <https://w3id.org/odrl-kb/geonames-europe/declared> ;
    vrep:readAgainst drk:KGC309-report ;
    rdfs:comment """GeoNames places France and Germany within Europe, and the declarations state that they are different countries, but different areas can still lie one within the other. If France lay within Germany, a use in France would meet both policies; if it does not, no use does. Nothing in GeoNames or the declarations decides it, so the verdict is Unknown."""@en ;
    dcterms:description """A library permits use within Germany. A researcher's policy commits to use in France. France and Germany are declared distinct."""@en ;
    vrep:compatibilityState vrep:Unknown .
