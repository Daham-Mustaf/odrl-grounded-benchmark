# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:traffic-data a dcat:Dataset ;
    dcterms:title "Traffic sensor data of a city"@en .

drk:policy-318-1 a odrl:Set ;
    odrl:uid drk:policy-318-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for any purpose except marketing"@en ;
    odrl:assigner drk:data-platform ;
    odrl:permission kgc:KGC318-p1-r1 .
kgc:KGC318-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC318-p1-c1 .
kgc:KGC318-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:neq ;
    odrl:rightOperand dpv:Marketing .
drk:policy-318-2 a odrl:Set ;
    odrl:uid drk:policy-318-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for scientific research only"@en ;
    odrl:assignee drk:data-user ;
    odrl:permission kgc:KGC318-p2-r1 .
kgc:KGC318-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC318-p2-c1 .
kgc:KGC318-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ScientificResearch .

### Expected result #######################################################

drk:KGC318-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC318" ;
    vrep:referencePolicy drk:policy-318-1 ;
    vrep:comparedPolicy drk:policy-318-2 ;
    vrep:referenceConstraint kgc:KGC318-p1-c1 ;
    vrep:comparedConstraint kgc:KGC318-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-purposes/declared> ;
    rdfs:comment """Scientific research is declared distinct from marketing, so a use for scientific research is a use for a purpose other than marketing and satisfies both policies."""@en ;
    dcterms:description """A city's traffic data platform permits use for any purpose other than marketing. A university commits to use for scientific research. Scientific research is declared distinct from marketing."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC318-2.tstp> .
