# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-311-1 a odrl:Set ;
    odrl:uid drk:policy-311-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Any declared purpose"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC311-p1-r1 .

kgc:KGC311-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC311-p1-c1 .

kgc:KGC311-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:Purpose .

drk:policy-311-2 a odrl:Set ;
    odrl:uid drk:policy-311-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Non-commercial research"@en ;
    odrl:assignee drk:researcher ;
    odrl:permission kgc:KGC311-p2-r1 .

kgc:KGC311-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC311-p2-c1 .

kgc:KGC311-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:NonCommercialResearch .

### Expected result #######################################################

drk:KGC311-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC311" ;
    vrep:referencePolicy drk:policy-311-1 ;
    vrep:comparedPolicy drk:policy-311-2 ;
    vrep:referenceConstraint kgc:KGC311-p1-c1 ;
    vrep:comparedConstraint kgc:KGC311-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-purposes/empty> ;
    rdfs:comment """NonCommercialResearch is below ResearchAndDevelopment, which is below Purpose; the certificate uses this two-step path."""@en ;
    dcterms:description """A library permits use for any DPV purpose, and a researcher requests use for non-commercial research."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC311-2.tstp> .
