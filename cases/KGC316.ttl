# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .

drk:policy-316-1 a odrl:Set ;
    odrl:uid drk:policy-316-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for scientific research purposes only"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC316-p1-r1 .
kgc:KGC316-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC316-p1-c1 .
kgc:KGC316-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:ScientificResearch .
drk:policy-316-2 a odrl:Set ;
    odrl:uid drk:policy-316-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for research and development only"@en ;
    odrl:assignee drk:researcher ;
    odrl:permission kgc:KGC316-p2-r1 .
kgc:KGC316-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC316-p2-c1 .
kgc:KGC316-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ResearchAndDevelopment .

### Expected result #######################################################

drk:KGC316-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC316" ;
    vrep:referencePolicy drk:policy-316-1 ;
    vrep:comparedPolicy drk:policy-316-2 ;
    vrep:referenceConstraint kgc:KGC316-p1-c1 ;
    vrep:comparedConstraint kgc:KGC316-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-purposes/empty> ;
    vrep:readAgainst drk:KGC310-report ;
    rdfs:comment """DPV places scientific research below research and development and publishes no edge back. In a structure that identifies the two purposes, a use for research and development is a use for scientific research and satisfies both policies. In a structure that keeps them apart, antisymmetry with the published edge forbids the converse edge, and no use satisfies both. So the verdict is Unknown."""@en ;
    dcterms:description """A library permits use for scientific research. A researcher's policy commits to use for research and development."""@en ;
    vrep:compatibilityState vrep:Unknown .
