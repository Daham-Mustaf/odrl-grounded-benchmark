@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
drk:offer-394 a odrl:Offer ;
    dcterms:title "Offer: use for research and development or marketing"@en ;
    odrl:assigner drk:provider ;
    odrl:permission kgc:KGC394-offer-r1 .
kgc:KGC394-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC394-offer-c1 .
kgc:KGC394-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:purpose ;
    odrl:operator odrl:isAnyOf ;
    odrl:rightOperand dpv:ResearchAndDevelopment ,
        dpv:Marketing .
drk:request-394 a odrl:Request ;
    dcterms:title "Request: scientific research"@en ;
    odrl:assignee drk:consumer ;
    odrl:permission kgc:KGC394-request-r1 .
kgc:KGC394-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC394-request-c1 .
kgc:KGC394-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ScientificResearch .

### Expected result #######################################################

drk:KGC394-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC394" ;
    report:policy drk:offer-394 ;
    report:policyRequest drk:request-394 ;
    report:constraint kgc:KGC394-offer-c1 ;
    vrep:constraintRequest kgc:KGC394-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    rdfs:comment """Scientific research is declared distinct from research and development and from marketing, so it is neither of the offer's values."""@en ;
    dcterms:description """As KGC393, with scientific research declared distinct from both named purposes."""@en ;
    report:satisfactionState report:Unsatisfied ;
    vrep:certificate <certificates/KGC394-1.tstp> .
