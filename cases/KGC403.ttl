# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:traffic-data a dcat:Dataset ;
    dcterms:title "Traffic sensor data of a city"@en .

drk:policy-403-1 a odrl:Set ;
    odrl:uid drk:policy-403-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for scientific research or any narrower purpose"@en ;
    odrl:assigner drk:data-platform ;
    odrl:permission kgc:KGC403-p1-r1 .
kgc:KGC403-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC403-p1-c1 .
kgc:KGC403-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:ScientificResearch .
drk:policy-403-2 a odrl:Set ;
    odrl:uid drk:policy-403-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for research and development only"@en ;
    odrl:assignee drk:data-user ;
    odrl:permission kgc:KGC403-p2-r1 .
kgc:KGC403-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC403-p2-c1 .
kgc:KGC403-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ResearchAndDevelopment .

### Expected result #######################################################

drk:KGC403-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC403" ;
    vrep:referencePolicy drk:policy-403-1 ;
    vrep:comparedPolicy drk:policy-403-2 ;
    vrep:referenceConstraint kgc:KGC403-p1-c1 ;
    vrep:comparedConstraint kgc:KGC403-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-purposes/declared> ;
    vrep:readAgainst drk:KGC316-report ;
    rdfs:comment """DPV places scientific research below research and development. A use for research and development meets the first policy only if research and development also lies below scientific research, and then the two are one purpose. They are declared distinct, because DPV defines each as a purpose of its own, so no use meets both policies."""@en ;
    dcterms:description """As KGC316, with scientific research and research and development declared distinct."""@en ;
    vrep:compatibilityState vrep:Incompatible ;
    vrep:certificate <certificates/KGC403-1.tstp> .
