# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:dataset a dcat:Dataset ;
    dcterms:title "Personal data held by a controller"@en .

drk:policy-348-1 a odrl:Set ;
    odrl:uid drk:policy-348-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use only while the consent on record may justify processing"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC348-p1-r1 .
kgc:KGC348-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC348-p1-c1 .
kgc:KGC348-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:ConsentStatusValidForProcessing .

drk:policy-348-2 a odrl:Set ;
    odrl:uid drk:policy-348-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use only records whose consent was withdrawn"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC348-p2-r1 .
kgc:KGC348-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC348-p2-c1 .
kgc:KGC348-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentWithdrawn .

### Expected result #######################################################

drk:KGC348-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC348" ;
    vrep:referencePolicy drk:policy-348-1 ;
    vrep:comparedPolicy drk:policy-348-2 ;
    vrep:referenceConstraint kgc:KGC348-p1-c1 ;
    vrep:comparedConstraint kgc:KGC348-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-consent-status> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-consent/declared> ;
    vrep:readAgainst drk:KGC342-report ;
    vrep:readAgainst drk:KGC343-report ;
    rdfs:comment """The states are declared distinct, yet withdrawn consent may still lie below the valid branch. One structure places it below both branches, and both constraints can hold. Another does not, and they cannot. Distinctness cannot keep it out of the valid branch, because a state below a branch is already a different concept from that branch. Only the disjointness of KGC343 does."""@en ;
    dcterms:description """As KGC342, with the consent states declared distinct from one another."""@en ;
    vrep:compatibilityState vrep:Unknown .
