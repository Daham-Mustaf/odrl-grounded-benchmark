@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-330 a odrl:Offer ;
    dcterms:title "Offer: use within the Netherlands"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC330-offer-r1 .

kgc:KGC330-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC330-offer-c1 .

kgc:KGC330-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand loc:NL .

drk:request-330 a odrl:Request ;
    dcterms:title "Request: use in Bonaire, Sint Eustatius and Saba"@en ;
    odrl:permission kgc:KGC330-request-r1 .

kgc:KGC330-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC330-request-c1 .

kgc:KGC330-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:BQ .

### Expected result #######################################################

drk:KGC330-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC330" ;
    report:policy drk:offer-330 ;
    report:policyRequest drk:request-330 ;
    report:constraint kgc:KGC330-offer-c1 ;
    vrep:constraintRequest kgc:KGC330-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-geo> ;
    rdfs:comment """DPV says Bonaire is part of the Netherlands, so a use in Bonaire is a use in the Netherlands and both sides get what they asked for."""@en ;
    dcterms:description """A library permits use within the Netherlands; a researcher asks to use the material in Bonaire. DPV places Bonaire within the Netherlands."""@en ;
    report:satisfactionState report:Satisfied ;
    vrep:certificate <certificates/KGC330-2.tstp> .
