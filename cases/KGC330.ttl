# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-330-1 a odrl:Set ;
    odrl:uid drk:policy-330-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use within the Netherlands"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC330-p1-r1 .

kgc:KGC330-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC330-p1-c1 .

kgc:KGC330-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand loc:NL .

drk:policy-330-2 a odrl:Set ;
    odrl:uid drk:policy-330-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use in Bonaire, Sint Eustatius and Saba"@en ;
    odrl:permission kgc:KGC330-p2-r1 .

kgc:KGC330-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC330-p2-c1 .

kgc:KGC330-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:BQ .

### Expected result #######################################################

drk:KGC330-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC330" ;
    vrep:referencePolicy drk:policy-330-1 ;
    vrep:comparedPolicy drk:policy-330-2 ;
    vrep:referenceConstraint kgc:KGC330-p1-c1 ;
    vrep:comparedConstraint kgc:KGC330-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-geo> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-loc/empty> ;
    rdfs:comment """DPV places Bonaire within the Netherlands as a territory of the state, not as a subdivision. Read as containment, a use in Bonaire is a use within the Netherlands, and both policies can be satisfied. This holds constitutionally, not geographically."""@en ;
    dcterms:description """A library permits use within the Netherlands; a researcher's policy commits to use in Bonaire. DPV places Bonaire within the Netherlands."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC330-2.tstp> .
