# Generated by the scripts in generators/.

@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-362-1 a odrl:Set ;
    odrl:uid drk:policy-362-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use is permitted with at least one of encryption and access control in place"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC362-p1-r1 .

kgc:KGC362-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC362-p1-c1 .

kgc:KGC362-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:TechnicalOrganisationalMeasure ;
    odrl:operator odrl:isAnyOf ;
    odrl:rightOperand ( dpv:Encryption dpv:AccessControlMethod ) .

drk:policy-362-2 a odrl:Set ;
    odrl:uid drk:policy-362-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use with encryption in place"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC362-p2-r1 .

kgc:KGC362-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC362-p2-c1 .

kgc:KGC362-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:TechnicalOrganisationalMeasure ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:Encryption .

### Expected result #######################################################

drk:KGC362-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC362" ;
    vrep:referencePolicy drk:policy-362-1 ;
    vrep:comparedPolicy drk:policy-362-2 ;
    vrep:referenceConstraint kgc:KGC362-p1-c1 ;
    vrep:comparedConstraint kgc:KGC362-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-tom> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-tom/empty> ;
    rdfs:comment """Encryption is one of the values the first policy lists, so a use with encryption satisfies both policies."""@en ;
    dcterms:description """A provider requires at least one of encryption and access control. A consumer's policy commits to encryption."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC362-2.tstp> .
