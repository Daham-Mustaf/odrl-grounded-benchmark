@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:bsb-offer-333 a odrl:Offer ;
    dcterms:title "BSB offer: use in Germany"@en ;
    odrl:assigner drk:bavarian-state-library ;
    odrl:permission kgc:KGC333-offer-r1 .

kgc:KGC333-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:bsb-manuscripts ;
    odrl:constraint kgc:KGC333-offer-c1 .

kgc:KGC333-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:DE .

drk:bnf-request-333 a odrl:Request ;
    dcterms:title "BnF request: use in France"@en ;
    odrl:assignee drk:french-national-library ;
    odrl:permission kgc:KGC333-request-r1 .

kgc:KGC333-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:bsb-manuscripts ;
    odrl:constraint kgc:KGC333-request-c1 .

kgc:KGC333-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:FR .

### Expected result #######################################################

drk:KGC333-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC333" ;
    report:policy drk:offer-333 ;
    report:policyRequest drk:request-333 ;
    report:constraint kgc:KGC333-offer-c1 ;
    vrep:constraintRequest kgc:KGC333-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-geo> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-loc/empty> ;
    report:satisfactionState vrep:Undetermined ;
    vrep:certificate drk:KGC333-certificate .

drk:KGC333-certificate a vrep:Models ;
    rdfs:comment """Both queries are satisfiable.  The models differ on whether the two codes denote one place, which no assertion in the extension settles."""@en .
