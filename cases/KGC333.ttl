# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-333-1 a odrl:Set ;
    odrl:uid drk:policy-333-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use in Germany"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC333-p1-r1 .

kgc:KGC333-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC333-p1-c1 .

kgc:KGC333-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:DE .

drk:policy-333-2 a odrl:Set ;
    odrl:uid drk:policy-333-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use in France"@en ;
    odrl:permission kgc:KGC333-p2-r1 .

kgc:KGC333-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC333-p2-c1 .

kgc:KGC333-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:FR .

### Expected result #######################################################

drk:KGC333-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC333" ;
    vrep:referencePolicy drk:policy-333-1 ;
    vrep:comparedPolicy drk:policy-333-2 ;
    vrep:referenceConstraint kgc:KGC333-p1-c1 ;
    vrep:comparedConstraint kgc:KGC333-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-geo> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-loc/empty> ;
    vrep:readAgainst drk:KGC334-report ;
    rdfs:comment """Neither the resource nor the parties assert that Germany and France are distinct, so the compatibility cannot be determined."""@en ;
    dcterms:description """A library permits use in Germany; a researcher requests use in France."""@en ;
    vrep:compatibilityState vrep:Unknown ;
    vrep:unknownReason vrep:Epistemic .
