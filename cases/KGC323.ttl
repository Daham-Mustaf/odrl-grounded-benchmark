# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ft:      <http://publications.europa.eu/resource/authority/file-type/> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .

drk:policy-323-1 a odrl:Set ;
    odrl:uid drk:policy-323-1 ;
    dcterms:title "Use in any format except PDF"@en ;
    odrl:assigner drk:german-library ;
    odrl:permission kgc:KGC323-p1-r1 .

kgc:KGC323-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC323-p1-c1 .

kgc:KGC323-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:fileFormat ;
    odrl:operator odrl:neq ;
    odrl:rightOperand ft:PDF .

drk:policy-323-2 a odrl:Set ;
    odrl:uid drk:policy-323-2 ;
    dcterms:title "Use in PDF/A-1a only"@en ;
    odrl:assignee drk:french-library ;
    odrl:permission kgc:KGC323-p2-r1 .

kgc:KGC323-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC323-p2-c1 .

kgc:KGC323-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:fileFormat ;
    odrl:operator odrl:eq ;
    odrl:rightOperand ft:PDFA1A .

### Expected result #######################################################

drk:KGC323-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC323" ;
    vrep:referencePolicy drk:policy-323-1 ;
    vrep:comparedPolicy drk:policy-323-2 ;
    vrep:referenceConstraint kgc:KGC323-p1-c1 ;
    vrep:comparedConstraint kgc:KGC323-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-fileformat> ;
    vrep:declarations <https://w3id.org/odrl-kb/eu-file-type/declared> ;
    rdfs:comment """The first policy excludes PDF, and the second requires PDF/A-1a. The declarations declare the two formats distinct, so the required format is not excluded. The exclusion of PDF does not exclude PDF/A-1a, because the table does not relate them."""@en ;
    dcterms:description """A German library permits use in any format except PDF. A French library's policy commits to use in PDF/A-1a only. The two formats are declared distinct."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC323-2.tstp> .
