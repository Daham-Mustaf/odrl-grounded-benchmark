@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-307-1 a odrl:Set ;
    odrl:uid drk:policy-307-1 ;
    dcterms:title "Use either in France alone or in both France and Germany"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC307-p1-r1 .

kgc:KGC307-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC307-p1-lc .

kgc:KGC307-p1-lc a odrl:LogicalConstraint ;
    odrl:xone ( kgc:KGC307-p1-c1 kgc:KGC307-p1-c2 ) .

kgc:KGC307-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand <https://sws.geonames.org/3017382/> .

kgc:KGC307-p1-c2 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:isAllOf ;
    odrl:rightOperand ( <https://sws.geonames.org/3017382/> <https://sws.geonames.org/2921044/> ) .

drk:policy-307-2 a odrl:Set ;
    odrl:uid drk:policy-307-2 ;
    dcterms:title "Use in France"@en ;
    odrl:permission kgc:KGC307-p2-r1 .

kgc:KGC307-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC307-p2-c1 .

kgc:KGC307-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand <https://sws.geonames.org/3017382/> .

### Expected result #######################################################

drk:KGC307-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC307" ;
    vrep:referencePolicy drk:policy-307-1 ;
    vrep:comparedPolicy drk:policy-307-2 ;
    vrep:referenceConstraint kgc:KGC307-p1-lc ;
    vrep:comparedConstraint kgc:KGC307-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-geonames> ;
    vrep:declarations <https://w3id.org/odrl-kb/geonames-europe/declared> ;
    rdfs:comment """France and Germany are declared distinct, so a use in France does not cover Germany. It satisfies the first alternative and fails the second, and 'exactly one' holds."""@en ;
    dcterms:description """A library permits use in exactly one of two ways: in France alone, or in both France and Germany. A researcher's policy commits to use in France. France and Germany are declared distinct."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC307-2.tstp> .
