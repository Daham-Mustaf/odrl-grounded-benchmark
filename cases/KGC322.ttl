# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ft:      <http://publications.europa.eu/resource/authority/file-type/> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-322-1 a odrl:Set ;
    odrl:uid drk:policy-322-1 ;
    dcterms:title "BSB: PDF or PDF/A-1a"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC322-p1-r1 .

kgc:KGC322-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC322-p1-c1 .

kgc:KGC322-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:fileFormat ;
    odrl:operator odrl:isAnyOf ;
    odrl:rightOperand ( ft:PDF ft:PDFA1A ) .

drk:policy-322-2 a odrl:Set ;
    odrl:uid drk:policy-322-2 ;
    dcterms:title "BnF: PDF/A-1a"@en ;
    odrl:assignee drk:researcher ;
    odrl:permission kgc:KGC322-p2-r1 .

kgc:KGC322-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC322-p2-c1 .

kgc:KGC322-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:fileFormat ;
    odrl:operator odrl:eq ;
    odrl:rightOperand ft:PDFA1A .

### Expected result #######################################################

drk:KGC322-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC322" ;
    vrep:referencePolicy drk:policy-322-1 ;
    vrep:comparedPolicy drk:policy-322-2 ;
    vrep:referenceConstraint kgc:KGC322-p1-c1 ;
    vrep:comparedConstraint kgc:KGC322-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-fileformat> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/eu-file-type/empty> ;
    rdfs:comment """The second policy requires PDF/A-1a, and the first lists it among the values isAnyOf accepts. The two constraints can be satisfied together without any resource or background assertion."""@en ;
    dcterms:description """BSB permits PDF or PDF/A-1a. BnF's policy commits to PDF/A-1a."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC322-2.tstp> .
