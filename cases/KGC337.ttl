# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .
drk:policy-337-1 a odrl:Set ;
    odrl:uid drk:policy-337-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use in both Germany and France"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC337-p1-r1 .
kgc:KGC337-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC337-p1-c1 .
kgc:KGC337-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:isAllOf ;
    odrl:rightOperand ( loc:DE loc:FR ) .
drk:policy-337-2 a odrl:Set ;
    odrl:uid drk:policy-337-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use in Germany only"@en ;
    odrl:assignee drk:researcher ;
    odrl:permission kgc:KGC337-p2-r1 .
kgc:KGC337-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC337-p2-c1 .
kgc:KGC337-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:DE .

### Expected result #######################################################

drk:KGC337-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC337" ;
    vrep:referencePolicy drk:policy-337-1 ;
    vrep:comparedPolicy drk:policy-337-2 ;
    vrep:referenceConstraint kgc:KGC337-p1-c1 ;
    vrep:comparedConstraint kgc:KGC337-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-geo> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-loc/iso> ;
    rdfs:comment """Germany and France are different places under the ISO 3166 rule. A use in both is not a use in Germany only, so no use satisfies both policies. The verdict rests on that rule: without it a structure that identifies the two countries admits the use."""@en ;
    dcterms:description """A library requires use in both Germany and France. A researcher's policy commits to use in Germany only. The ISO 3166 rule makes the two countries different places."""@en ;
    vrep:compatibilityState vrep:Incompatible ;
    vrep:certificate <certificates/KGC337-1.tstp> .
