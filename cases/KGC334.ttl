@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-334 a odrl:Offer ;
    dcterms:title "Offer: use in Germany"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC334-offer-r1 .

kgc:KGC334-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC334-offer-c1 .

kgc:KGC334-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:DE .

drk:request-334 a odrl:Request ;
    dcterms:title "Request: use in France"@en ;
    odrl:permission kgc:KGC334-request-r1 .

kgc:KGC334-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC334-request-c1 .

kgc:KGC334-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:FR .

### Expected result #######################################################

drk:KGC334-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC334" ;
    report:policy drk:offer-334 ;
    report:policyRequest drk:request-334 ;
    report:constraint kgc:KGC334-offer-c1 ;
    vrep:constraintRequest kgc:KGC334-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-geo> ;
    rdfs:comment """Both constraints can be satisfied only if Germany and France denote the same place. The adopted rule asserts that they are distinct, so the constraints cannot both be satisfied."""@en ;
    dcterms:description """A library permits use in Germany; a researcher requests use in France."""@en ;
    report:satisfactionState report:Unsatisfied ;
    vrep:certificate <certificates/KGC334-1.tstp> .
