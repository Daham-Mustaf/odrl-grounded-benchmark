# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-334-1 a odrl:Set ;
    odrl:uid drk:policy-334-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use in Germany"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC334-p1-r1 .

kgc:KGC334-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC334-p1-c1 .

kgc:KGC334-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:DE .

drk:policy-334-2 a odrl:Set ;
    odrl:uid drk:policy-334-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use in France"@en ;
    odrl:permission kgc:KGC334-p2-r1 .

kgc:KGC334-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC334-p2-c1 .

kgc:KGC334-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:FR .

### Expected result #######################################################

drk:KGC334-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC334" ;
    vrep:referencePolicy drk:policy-334-1 ;
    vrep:comparedPolicy drk:policy-334-2 ;
    vrep:referenceConstraint kgc:KGC334-p1-c1 ;
    vrep:comparedConstraint kgc:KGC334-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-geo> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-loc/iso> ;
    vrep:readAgainst drk:KGC333-report ;
    rdfs:comment """Both constraints can be satisfied only if Germany and France denote the same place. The adopted rule asserts that they are distinct, so the constraints cannot both be satisfied."""@en ;
    dcterms:description """A library permits use in Germany; a researcher requests use in France."""@en ;
    vrep:compatibilityState vrep:Incompatible ;
    vrep:certificate <certificates/KGC334-1.tstp> .
