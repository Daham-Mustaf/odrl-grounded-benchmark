# Generated by the scripts in generators/.

@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-376-1 a odrl:Set ;
    odrl:uid drk:policy-376-1 ;
    dcterms:title "Distribution in both Dutch and French"@en ;
    odrl:assigner drk:publisher ;
    odrl:permission kgc:KGC376-p1-r1 .

kgc:KGC376-p1-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC376-p1-c1 .

kgc:KGC376-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:isAllOf ;
    odrl:rightOperand ( bcp47:nl bcp47:fr ) .

drk:policy-376-2 a odrl:Set ;
    odrl:uid drk:policy-376-2 ;
    dcterms:title "Distribution in Dutch only"@en ;
    odrl:assignee drk:reuser ;
    odrl:permission kgc:KGC376-p2-r1 .

kgc:KGC376-p2-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC376-p2-c1 .

kgc:KGC376-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:nl .

### Expected result #######################################################

drk:KGC376-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC376" ;
    vrep:referencePolicy drk:policy-376-1 ;
    vrep:comparedPolicy drk:policy-376-2 ;
    vrep:referenceConstraint kgc:KGC376-p1-c1 ;
    vrep:comparedConstraint kgc:KGC376-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/bcp47/uniqueness> ;
    rdfs:comment """Dutch and French are declared distinct languages. A use in both is not a use in Dutch only, so no use satisfies both policies."""@en ;
    dcterms:description """A Belgian federal publisher requires distribution in both Dutch and French. The licensee distributes in Dutch only. The parties adopt the registry rule that different primary subtags name different languages."""@en ;
    vrep:compatibilityState vrep:Incompatible ;
    vrep:certificate <certificates/KGC376-1.tstp> .
