### Expected result #######################################################

drk:KGC380-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC380" ;
    vrep:referencePolicy drk:policy-380-1 ;
    vrep:comparedPolicy drk:policy-380-2 ;
    vrep:referenceConstraint kgc:KGC380-p1-c1 ;
