@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
drk:offer-380 a odrl:Set ;
    dcterms:title "Offer: use within the European Union"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC380-offer-r1 .
kgc:KGC380-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC380-offer-c1 .
kgc:KGC380-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand loc:EU .
drk:request-380 a odrl:Request ;
    dcterms:title "Request: use in Bonaire, Sint Eustatius and Saba"@en ;
    odrl:permission kgc:KGC380-request-r1 .
kgc:KGC380-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC380-request-c1 .
kgc:KGC380-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:BQ .

### Expected result #######################################################

drk:KGC380-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC380" ;
    report:policy drk:offer-380 ;
    report:policyRequest drk:request-380 ;
    report:constraint kgc:KGC380-offer-c1 ;
    vrep:constraintRequest kgc:KGC380-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-juris> ;
    rdfs:comment """The jurisdictional binding composes Bonaire's relation to the Netherlands with the Netherlands' relation to the EU, so the constraints are compatible under this reading."""@en ;
    dcterms:description """A library permits use within the European Union; a researcher requests use in Bonaire, Sint Eustatius and Saba."""@en ;
    report:satisfactionState report:Satisfied ;
    vrep:certificate <certificates/KGC380-2.tstp> .
