# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .

drk:policy-331-1 a odrl:Set ;
    odrl:uid drk:policy-331-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use within the European Union"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC331-p1-r1 .

kgc:KGC331-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC331-p1-c1 .

kgc:KGC331-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand loc:EU .

drk:policy-331-2 a odrl:Set ;
    odrl:uid drk:policy-331-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use in Germany only"@en ;
    odrl:assignee drk:researcher ;
    odrl:permission kgc:KGC331-p2-r1 .

kgc:KGC331-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC331-p2-c1 .

kgc:KGC331-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:DE .

### Expected result #######################################################

drk:KGC331-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC331" ;
    vrep:referencePolicy drk:policy-331-1 ;
    vrep:comparedPolicy drk:policy-331-2 ;
    vrep:referenceConstraint kgc:KGC331-p1-c1 ;
    vrep:comparedConstraint kgc:KGC331-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-juris> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-loc/empty> ;
    vrep:readAgainst drk:KGC381-report ;
    rdfs:comment """DPV states that Germany is a member of the European Union. The jurisdictional reading takes membership as containment, so a use in Germany is a use within the Union and both policies can be met. The territorial reading does not take membership as containment (see KGC381)."""@en ;
    vrep:profileNote """This policy goes beyond the DPV-ODRL usage note for Location, which does not list isPartOf."""@en ;
    dcterms:description """A library permits use within the European Union; a researcher's policy commits to use in Germany. DPV places Germany in the EU, and this reading takes membership as containment."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC331-2.tstp> .
