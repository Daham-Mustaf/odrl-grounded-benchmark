@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-331 a odrl:Set ;
    dcterms:title "Offer: use within the European Union"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC331-offer-r1 .

kgc:KGC331-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC331-offer-c1 .

kgc:KGC331-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand loc:EU .

drk:request-331 a odrl:Request ;
    dcterms:title "Request: use in Germany"@en ;
    odrl:permission kgc:KGC331-request-r1 .

kgc:KGC331-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC331-request-c1 .

kgc:KGC331-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:DE .

### Expected result #######################################################

drk:KGC331-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC331" ;
    report:policy drk:offer-331 ;
    report:policyRequest drk:request-331 ;
    report:constraint kgc:KGC331-offer-c1 ;
    vrep:constraintRequest kgc:KGC331-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-juris> ;
    vrep:readAgainst drk:KGC381-report ;
    rdfs:comment """DPV states that Germany is in the European Union, and the jurisdictional binding interprets this membership relation as containment, so the constraints are compatible. The geographic binding does not interpret membership as geographic containment."""@en ;
    dcterms:description """A library permits use within the European Union; a researcher asks to use the material in Germany. DPV places Germany in the EU, and this binding reads membership as containment."""@en ;
    report:satisfactionState report:Satisfied ;
    vrep:certificate <certificates/KGC331-2.tstp> .
