@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-347 a odrl:Offer ;
    dcterms:title "Use is permitted while the record falls under exactly one of the two consent branches"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC347-offer-r1 .
kgc:KGC347-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC347-offer-c1 .
kgc:KGC347-offer-c1 a odrl:LogicalConstraint ;
    odrl:xone ( kgc:KGC347-offer-a1 kgc:KGC347-offer-a2 ) .

kgc:KGC347-offer-a1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:ConsentStatusValidForProcessing .

kgc:KGC347-offer-a2 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:ConsentStatusInvalidForProcessing .

drk:request-347 a odrl:Request ;
    dcterms:title "Processing only under given consent"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC347-request-r1 .
kgc:KGC347-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC347-request-c1 .
kgc:KGC347-request-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentGiven .

### Expected result #######################################################

drk:KGC347-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC347" ;
    report:policy drk:offer-347 ;
    report:policyRequest drk:request-347 ;
    report:constraint kgc:KGC347-offer-c1 ;
    vrep:constraintRequest kgc:KGC347-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-consent-status> ;
    rdfs:comment """The given state lies below the valid branch, and the branches are declared to have nothing below both, so it lies below that branch alone."""@en ;
    dcterms:description """As KGC346, with the valid and invalid branches declared disjoint on DPV's definitions."""@en ;
    report:satisfactionState report:Satisfied ;
    vrep:certificate <../../certificates/KGC347-2.tstp> .
