@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
drk:offer-383 a odrl:Offer ;
    dcterms:title "Offer: use within the European Union"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC383-offer-r1 .
kgc:KGC383-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC383-offer-c1 .
kgc:KGC383-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand loc:EU .
drk:request-383 a odrl:Request ;
    dcterms:title "Request: use in North Rhine-Westphalia"@en ;
    odrl:permission kgc:KGC383-request-r1 .
kgc:KGC383-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC383-request-c1 .
kgc:KGC383-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:DE-NW .

### Expected result #######################################################

drk:KGC383-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC383" ;
    report:policy drk:offer-383 ;
    report:policyRequest drk:request-383 ;
    report:constraint kgc:KGC383-offer-c1 ;
    vrep:constraintRequest kgc:KGC383-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-juris> ;
    rdfs:comment """Containment composed with membership; true here."""@en ;
    report:satisfactionState report:Satisfied ;
    vrep:certificate <../../certificates/KGC383-2.tstp> .
