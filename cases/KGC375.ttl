@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-375 a odrl:Offer ;
    dcterms:title "Distribution in German"@en ;
    odrl:assigner drk:publisher ;
    odrl:permission kgc:KGC375-offer-r1 .

kgc:KGC375-offer-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC375-offer-c1 .

kgc:KGC375-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:de .

drk:request-375 a odrl:Request ;
    dcterms:title "Anything but French"@en ;
    odrl:assignee drk:reuser ;
    odrl:permission kgc:KGC375-request-r1 .

kgc:KGC375-request-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC375-request-c1 .

kgc:KGC375-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:fr .

### Expected result #######################################################

drk:KGC375-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC375" ;
    report:policy drk:offer-375 ;
    report:policyRequest drk:request-375 ;
    report:constraint kgc:KGC375-offer-c1 ;
    vrep:constraintRequest kgc:KGC375-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47> ;
    report:satisfactionState vrep:Undetermined ;
    vrep:undeterminedReason vrep:Epistemic ;
    vrep:certificate drk:KGC375-certificate .

drk:KGC375-certificate a vrep:Models ;
    rdfs:comment """One certifying structure separates bcp47:de and bcp47:fr and carries the witness; the other identifies them and carries none."""@en .
