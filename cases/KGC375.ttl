# Generated by the scripts in generators/.

@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-375-1 a odrl:Set ;
    odrl:uid drk:policy-375-1 ;
    dcterms:title "Distribution in German"@en ;
    odrl:assigner drk:publisher ;
    odrl:permission kgc:KGC375-p1-r1 .

kgc:KGC375-p1-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC375-p1-c1 .

kgc:KGC375-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:de .

drk:policy-375-2 a odrl:Set ;
    odrl:uid drk:policy-375-2 ;
    dcterms:title "Anything but French"@en ;
    odrl:assignee drk:reuser ;
    odrl:permission kgc:KGC375-p2-r1 .

kgc:KGC375-p2-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC375-p2-c1 .

kgc:KGC375-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:neq ;
    odrl:rightOperand bcp47:fr .

### Expected result #######################################################

drk:KGC375-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC375" ;
    vrep:referencePolicy drk:policy-375-1 ;
    vrep:comparedPolicy drk:policy-375-2 ;
    vrep:referenceConstraint kgc:KGC375-p1-c1 ;
    vrep:comparedConstraint kgc:KGC375-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/bcp47/empty> ;
    vrep:readAgainst drk:KGC374-report ;
    rdfs:comment """Nothing says that German and French are different languages. One structure identifies them, and then a use in German is a use in French, so the verdict is Unknown."""@en ;
    dcterms:description """As KGC374, without the registry rule."""@en ;
    vrep:compatibilityState vrep:Unknown ;
    vrep:unknownReason vrep:Epistemic .
