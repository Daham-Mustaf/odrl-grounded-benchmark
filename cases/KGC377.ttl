# Generated by the scripts in generators/.

@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-377-1 a odrl:Set ;
    odrl:uid drk:policy-377-1 ;
    dcterms:title "Distribution in any language except English and Italian"@en ;
    odrl:assigner drk:publisher ;
    odrl:permission kgc:KGC377-p1-r1 .

kgc:KGC377-p1-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC377-p1-c1 .

kgc:KGC377-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:isNoneOf ;
    odrl:rightOperand ( bcp47:en bcp47:it ) .

drk:policy-377-2 a odrl:Set ;
    odrl:uid drk:policy-377-2 ;
    dcterms:title "Distribution in Italian"@en ;
    odrl:assignee drk:reuser ;
    odrl:permission kgc:KGC377-p2-r1 .

kgc:KGC377-p2-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC377-p2-c1 .

kgc:KGC377-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:it .

### Expected result #######################################################

drk:KGC377-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC377" ;
    vrep:referencePolicy drk:policy-377-1 ;
    vrep:comparedPolicy drk:policy-377-2 ;
    vrep:referenceConstraint kgc:KGC377-p1-c1 ;
    vrep:comparedConstraint kgc:KGC377-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47> ;
    vrep:declarations <https://w3id.org/odrl-kb/bcp47/empty> ;
    rdfs:comment """The first policy excludes Italian and the second policy requires it. This holds in every structure, so no declaration is used."""@en ;
    dcterms:description """English and Italian rights were sold separately, so a publisher permits any language except English and Italian. The licensee distributes in Italian."""@en ;
    vrep:compatibilityState vrep:Incompatible ;
    vrep:certificate <certificates/KGC377-1.tstp> .
