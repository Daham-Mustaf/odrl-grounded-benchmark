# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .

drk:policy-300-1 a odrl:Set ;
    odrl:uid drk:policy-300-1 ;
    dcterms:title "Use in German only"@en ;
    odrl:assigner drk:german-library ;
    odrl:permission kgc:KGC300-p1-r1 .

kgc:KGC300-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC300-p1-c1 .

kgc:KGC300-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:de .

drk:policy-300-2 a odrl:Set ;
    odrl:uid drk:policy-300-2 ;
    dcterms:title "Use in French only"@en ;
    odrl:assignee drk:french-library ;
    odrl:permission kgc:KGC300-p2-r1 .

kgc:KGC300-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC300-p2-c1 .

kgc:KGC300-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:fr .

### Expected result #######################################################

drk:KGC300-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC300" ;
    vrep:referencePolicy drk:policy-300-1 ;
    vrep:comparedPolicy drk:policy-300-2 ;
    vrep:referenceConstraint kgc:KGC300-p1-c1 ;
    vrep:comparedConstraint kgc:KGC300-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47> ;
    vrep:declarations <https://w3id.org/odrl-kb/bcp47/distinct> ;
    rdfs:comment """Both constraints can hold only if German and French are one language. The registry rule the parties adopt makes them distinct, so no use satisfies both policies."""@en ;
    dcterms:description """A German library permits use of its manuscripts in German only. A French library's policy commits to use in French only."""@en ;
    vrep:compatibilityState vrep:Incompatible ;
    vrep:certificate <certificates/KGC300-1.tstp> .
