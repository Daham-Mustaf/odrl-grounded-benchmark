# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-306-1 a odrl:Set ;
    odrl:uid drk:policy-306-1 ;
    dcterms:title "Use within exactly one of France and Germany"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC306-p1-r1 .

kgc:KGC306-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC306-p1-lc .

kgc:KGC306-p1-lc a odrl:LogicalConstraint ;
    odrl:xone ( kgc:KGC306-p1-c1 kgc:KGC306-p1-c2 ) .

kgc:KGC306-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand <https://sws.geonames.org/3017382/> .

kgc:KGC306-p1-c2 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand <https://sws.geonames.org/2921044/> .

drk:policy-306-2 a odrl:Set ;
    odrl:uid drk:policy-306-2 ;
    dcterms:title "Use in France"@en ;
    odrl:permission kgc:KGC306-p2-r1 .

kgc:KGC306-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC306-p2-c1 .

kgc:KGC306-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand <https://sws.geonames.org/3017382/> .

### Expected result #######################################################

drk:KGC306-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC306" ;
    vrep:referencePolicy drk:policy-306-1 ;
    vrep:comparedPolicy drk:policy-306-2 ;
    vrep:referenceConstraint kgc:KGC306-p1-lc ;
    vrep:comparedConstraint kgc:KGC306-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-geonames> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/geonames-europe/siblings> ;
    vrep:readAgainst drk:KGC305-report ;
    rdfs:comment """France lies within itself, and nothing lies within both France and Germany. So France does not lie within Germany, and 'exactly one' holds."""@en ;
    dcterms:description """As KGC305, with France and Germany declared disjoint: nothing lies within both."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC306-2.tstp> .
