@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-372 a odrl:Offer ;
    dcterms:title "Distribution in German"@en ;
    odrl:assigner drk:publisher ;
    odrl:permission kgc:KGC372-offer-r1 .

kgc:KGC372-offer-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC372-offer-c1 .

kgc:KGC372-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:de .

drk:request-372 a odrl:Request ;
    dcterms:title "Distribution in American English"@en ;
    rdfs:comment """A well-formed BCP 47 language tag, composed by RFC 5646 from the registered primary subtag en and the registered region subtag US. It is not itself an entry of the registry and not a concept of the resource this operand is bound to, which holds primary subtags. Whether it resolves to one is the profile's grounding rule to decide, and the two problems using this request are read under rules that decide it differently."""@en ;
    odrl:assignee drk:reuser ;
    odrl:permission kgc:KGC372-request-r1 .

kgc:KGC372-request-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC372-request-c1 .

kgc:KGC372-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand "en-US" .

### Expected result #######################################################

drk:KGC372-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC372" ;
    report:policy drk:offer-372 ;
    report:policyRequest drk:request-372 ;
    report:constraint kgc:KGC372-offer-c1 ;
    vrep:constraintRequest kgc:KGC372-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47> ;
    rdfs:comment """The value en-US resolves to no concept of the resource under this binding's grounding rule. Checkable by applying that rule to the value and seeing that it yields nothing."""@en ;
    report:satisfactionState vrep:Undetermined ;
    vrep:undeterminedReason vrep:Ungrounded .
