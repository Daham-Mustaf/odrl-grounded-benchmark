@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix vrep:    <https://w3id.org/odrl-verdict-report#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-372 a odrl:Offer ;
    dcterms:title "Distribution in German"@en ;
    odrl:assigner drk:publisher ;
    odrl:permission kgc:KGC372-offer-r1 .

kgc:KGC372-offer-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC372-offer-c1 .

kgc:KGC372-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:de .

drk:request-372 a odrl:Request ;
    dcterms:title "Distribution in American English"@en ;
    rdfs:comment """A well-formed BCP 47 language tag: RFC 5646 composes it from the registered primary subtag en and the registered region subtag US. It is not a concept of this slice, which holds primary subtags, and whether it resolves to one is the profile's grounding rule to decide."""@en ;
    odrl:assignee drk:reuser ;
    odrl:permission kgc:KGC372-request-r1 .

kgc:KGC372-request-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC372-request-c1 .

kgc:KGC372-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand "en-US" .

drk:offer-372 vrep:readUnder <https://w3id.org/odrl-kb/profile/b-language-bcp47> .
drk:request-372 vrep:readUnder <https://w3id.org/odrl-kb/profile/b-language-bcp47> .

### Expected result #######################################################

drk:KGC372-report a vrep:OperandReport ;
    dcterms:identifier "KGC372" ;
    vrep:firstPolicy drk:offer-372 ;
    vrep:secondPolicy drk:request-372 ;
    vrep:firstConstraint kgc:KGC372-offer-c1 ;
    vrep:secondConstraint kgc:KGC372-request-c1 ;
    vrep:leftOperand odrl:language ;
    vrep:sort vrep:nom ;
    vrep:resource <https://w3id.org/odrl-kb/bcp47> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/bcp47/uniqueness> ;
    vrep:verdict vrep:Unknown ;
    vrep:certificate drk:KGC372-certificate .

drk:KGC372-certificate a vrep:Ungrounded ;
    rdfs:comment """The value en-US names no concept of the slice under this binding's grounding. Checkable by applying the grounding to it."""@en .
