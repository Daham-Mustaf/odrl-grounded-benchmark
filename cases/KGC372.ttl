# Generated by the scripts in generators/.

@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-372-1 a odrl:Set ;
    odrl:uid drk:policy-372-1 ;
    dcterms:title "Distribution in German"@en ;
    odrl:assigner drk:publisher ;
    odrl:permission kgc:KGC372-p1-r1 .

kgc:KGC372-p1-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC372-p1-c1 .

kgc:KGC372-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:de .

drk:policy-372-2 a odrl:Set ;
    odrl:uid drk:policy-372-2 ;
    dcterms:title "Distribution in American English"@en ;
    rdfs:comment """A well-formed BCP 47 language tag, composed by RFC 5646 from the registered primary subtag en and the registered region subtag US. It is not itself an entry of the registry and not a concept of the resource this operand is bound to, which holds primary subtags. Whether it resolves to one is the profile's grounding rule to decide, and the two problems using this value are read under rules that decide it differently."""@en ;
    odrl:assignee drk:reuser ;
    odrl:permission kgc:KGC372-p2-r1 .

kgc:KGC372-p2-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC372-p2-c1 .

kgc:KGC372-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand "en-US" .

### Expected result #######################################################

drk:KGC372-report a vrep:GroundingReport ;
    dcterms:identifier "KGC372" ;
    vrep:constraint kgc:KGC372-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47> ;
    vrep:readAgainst drk:KGC373-report ;
    rdfs:comment """Under the exact-match rule, the value en-US resolves to no concept of the resource. The constraint is therefore rejected, and no verdict is computed. KGC373 reads the same value under the rule that reduces it to en."""@en ;
    dcterms:description """A publisher distributes in German. A reuser's policy commits to American English (en-US), under the exact-match grounding rule."""@en ;
    vrep:grounded false ;
    vrep:ungroundedValue "en-US" .
