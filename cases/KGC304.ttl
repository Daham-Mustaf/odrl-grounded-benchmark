# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-304-1 a odrl:Set ;
    odrl:uid drk:policy-304-1 ;
    dcterms:title "Use in exactly one of France and Germany"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC304-p1-r1 .

kgc:KGC304-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC304-p1-lc .

kgc:KGC304-p1-lc a odrl:LogicalConstraint ;
    odrl:xone ( kgc:KGC304-p1-c1 kgc:KGC304-p1-c2 ) .

kgc:KGC304-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand <https://sws.geonames.org/3017382/> .

kgc:KGC304-p1-c2 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand <https://sws.geonames.org/2921044/> .

drk:policy-304-2 a odrl:Set ;
    odrl:uid drk:policy-304-2 ;
    dcterms:title "Use in France"@en ;
    odrl:permission kgc:KGC304-p2-r1 .

kgc:KGC304-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC304-p2-c1 .

kgc:KGC304-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand <https://sws.geonames.org/3017382/> .

### Expected result #######################################################

drk:KGC304-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC304" ;
    vrep:referencePolicy drk:policy-304-1 ;
    vrep:comparedPolicy drk:policy-304-2 ;
    vrep:referenceConstraint kgc:KGC304-p1-lc ;
    vrep:comparedConstraint kgc:KGC304-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-geonames> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/geonames-europe/declared> ;
    vrep:readAgainst drk:KGC303-report ;
    rdfs:comment """France and Germany are declared distinct, so a use in France satisfies only the first alternative, and 'exactly one' holds."""@en ;
    dcterms:description """As KGC303, with France and Germany declared distinct."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC304-2.tstp> .
