# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:traffic-data a dcat:Dataset ;
    dcterms:title "Traffic sensor data of a city"@en .

drk:policy-393-1 a odrl:Set ;
    odrl:uid drk:policy-393-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for at least one of public benefit and non-commercial research"@en ;
    odrl:assigner drk:data-platform ;
    odrl:permission kgc:KGC393-p1-r1 .
kgc:KGC393-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC393-p1-c1 .
kgc:KGC393-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:isAnyOf ;
    odrl:rightOperand ( dpv:PublicBenefit dpv:NonCommercialResearch ) .
drk:policy-393-2 a odrl:Set ;
    odrl:uid drk:policy-393-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for improving transport mobility only"@en ;
    odrl:assignee drk:data-user ;
    odrl:permission kgc:KGC393-p2-r1 .
kgc:KGC393-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC393-p2-c1 .
kgc:KGC393-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ImproveTransportMobility .

### Expected result #######################################################

drk:KGC393-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC393" ;
    vrep:referencePolicy drk:policy-393-1 ;
    vrep:comparedPolicy drk:policy-393-2 ;
    vrep:referenceConstraint kgc:KGC393-p1-c1 ;
    vrep:comparedConstraint kgc:KGC393-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-purposes/empty> ;
    vrep:readAgainst drk:KGC394-report ;
    rdfs:comment """One structure identifies improving transport mobility with one of the two purposes and admits the use; one keeps them apart and does not. The published order is not consulted by isAnyOf."""@en ;
    dcterms:description """A city's traffic data platform permits use for at least one of public benefit and non-commercial research. A city transport authority commits to improving transport mobility."""@en ;
    vrep:compatibilityState vrep:Unknown .
