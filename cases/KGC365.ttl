# Generated by the scripts in generators/.

@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:dataset a dcat:Dataset ;
    dcterms:title "Personal data held by a controller"@en .

drk:policy-365-1 a odrl:Set ;
    odrl:uid drk:policy-365-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use with both encryption and access control in place"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC365-p1-r1 .

kgc:KGC365-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC365-p1-c1 .

kgc:KGC365-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:TechnicalOrganisationalMeasure ;
    odrl:operator odrl:isAllOf ;
    odrl:rightOperand ( dpv:Encryption dpv:AccessControlMethod ) .

drk:policy-365-2 a odrl:Set ;
    odrl:uid drk:policy-365-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use with all of encryption, access control and pseudonymisation"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC365-p2-r1 .

kgc:KGC365-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC365-p2-c1 .

kgc:KGC365-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:TechnicalOrganisationalMeasure ;
    odrl:operator odrl:isAllOf ;
    odrl:rightOperand ( dpv:Encryption dpv:AccessControlMethod dpv:Pseudonymisation ) .

### Expected result #######################################################

drk:KGC365-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC365" ;
    vrep:referencePolicy drk:policy-365-1 ;
    vrep:comparedPolicy drk:policy-365-2 ;
    vrep:referenceConstraint kgc:KGC365-p1-c1 ;
    vrep:comparedConstraint kgc:KGC365-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-tom> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-tom/empty> ;
    rdfs:comment """isAllOf states a minimum. A use with encryption, access control and pseudonymisation has the two measures the first policy requires, so it meets both policies and no DPV statement or declaration is used. Two minimums never conflict: a use with both sets of measures meets both."""@en ;
    vrep:profileNote """This policy goes beyond the DPV-ODRL usage note for TechnicalOrganisationalMeasure, which does not list isAllOf."""@en ;
    dcterms:description """A controller requires both encryption and access control. A processor commits to encryption, access control and pseudonymisation together."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC365-2.tstp> .
