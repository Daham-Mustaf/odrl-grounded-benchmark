# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:traffic-data a dcat:Dataset ;
    dcterms:title "Traffic sensor data of a city"@en .

drk:policy-313-1 a odrl:Set ;
    odrl:uid drk:policy-313-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for scientific research only"@en ;
    odrl:assigner drk:data-platform ;
    odrl:permission kgc:KGC313-p1-r1 .

kgc:KGC313-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC313-p1-c1 .

kgc:KGC313-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ScientificResearch .

drk:policy-313-2 a odrl:Set ;
    odrl:uid drk:policy-313-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for marketing only"@en ;
    odrl:assignee drk:data-user ;
    odrl:permission kgc:KGC313-p2-r1 .

kgc:KGC313-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC313-p2-c1 .

kgc:KGC313-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:Marketing .

### Expected result #######################################################

drk:KGC313-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC313" ;
    vrep:referencePolicy drk:policy-313-1 ;
    vrep:comparedPolicy drk:policy-313-2 ;
    vrep:referenceConstraint kgc:KGC313-p1-c1 ;
    vrep:comparedConstraint kgc:KGC313-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-purposes/empty> ;
    vrep:readAgainst drk:KGC314-report ;
    rdfs:comment """DPV does not declare marketing and scientific research distinct. In a structure that identifies them, a use for marketing is a use for scientific research and satisfies both policies. In a structure that keeps them apart, no use does. So the verdict is Unknown."""@en ;
    dcterms:description """A city's traffic data platform permits use for scientific research only. A company commits to use for marketing."""@en ;
    vrep:compatibilityState vrep:Unknown .
