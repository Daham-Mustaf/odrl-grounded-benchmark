# Generated by the scripts in generators/.

# A check made while a policy is drafted: whether the operator applies to the
# kind of value the policy gives.  The answer comes from the operator and the
# kind of value alone, so no vocabulary was opened and no prover was run.
#
# A rejected policy is not false.  It asks a question the vocabulary cannot
# answer: isA over a vocabulary that arranges nothing in kinds has nothing to
# test, and an evaluator that answered yes or no would be inventing an answer.

@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .

drk:policy-110-1 a odrl:Set ;
    odrl:uid drk:policy-110-1 ;
    dcterms:title "Use within Europe"@en ;
    odrl:assigner drk:german-library ;
    odrl:permission kgc:KGC110-p1-r1 .

kgc:KGC110-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC110-p1-c1 .

kgc:KGC110-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand <https://sws.geonames.org/6255148/> .

### Expected result #######################################################

drk:KGC110-report a vrep:WellSortednessReport ;
    dcterms:identifier "KGC110" ;
    vrep:constraint kgc:KGC110-p1-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-geonames> ;
    dcterms:description """A German library's policy uses isPartOf with Europe, a place in GeoNames."""@en ;
    rdfs:comment """isPartOf asks whether one value is part of another, and GeoNames states which place is part of which, so the operator applies to this kind of value and the policy goes on to a verdict."""@en ;
    vrep:wellSorted true .
