@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
drk:offer-390 a odrl:Set ;
    dcterms:title "Offer: use in exactly one of North Rhine-Westphalia and Bavaria"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC390-offer-r1 .
kgc:KGC390-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC390-offer-lc .
kgc:KGC390-offer-lc a odrl:LogicalConstraint ;
    odrl:xone ( kgc:KGC390-offer-c1 kgc:KGC390-offer-c2 ) .
kgc:KGC390-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:DE-NW .
kgc:KGC390-offer-c2 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:DE-BY .
drk:request-390 a odrl:Request ;
    dcterms:title "Request: use in North Rhine-Westphalia"@en ;
    odrl:permission kgc:KGC390-request-r1 .
kgc:KGC390-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC390-request-c1 .
kgc:KGC390-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:DE-NW .

### Expected result #######################################################

drk:KGC390-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC390" ;
    report:policy drk:offer-390 ;
    report:policyRequest drk:request-390 ;
    report:constraint kgc:KGC390-offer-c1 ;
    vrep:constraintRequest kgc:KGC390-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-geo> ;
    vrep:readAgainst drk:KGC389-report ;
    rdfs:comment """The rule instance discharges the negated literal."""@en ;
    report:satisfactionState report:Satisfied ;
    vrep:certificate <certificates/KGC390-2.tstp> .
