# Generated by the scripts in generators/.

# A drafting-time check: whether this constraint can be evaluated at all
# under the sort its operand is bound at.  The answer comes from the
# signature and from nothing else, so no resource was opened and no prover
# was run to produce it.
#
# A rejected constraint is not false.  It is a question the bound resource
# cannot be asked: isA over a resource that publishes no subsumption has
# nothing to test, and an evaluator that returned true or false would be
# inventing an answer.

@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .

drk:policy-104-1 a odrl:Set ;
    odrl:uid drk:policy-104-1 ;
    dcterms:title "Use in a language that includes German"@en ;
    odrl:assigner drk:german-library ;
    odrl:permission kgc:KGC104-p1-r1 .

kgc:KGC104-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC104-p1-c1 .

kgc:KGC104-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:hasPart ;
    odrl:rightOperand bcp47:de .

### Expected result #######################################################

drk:KGC104-report a vrep:WellSortednessReport ;
    dcterms:identifier "KGC104" ;
    vrep:constraint kgc:KGC104-p1-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47> ;
    dcterms:description """A German library's policy constrains language with hasPart bcp:de, and the binding reads language at sort nom."""@en ;
    rdfs:comment """hasPart requires parthood; the operand is nom, whose resource supplies identity."""@en ;
    vrep:wellSorted false .
