# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .
drk:policy-336-1 a odrl:Set ;
    odrl:uid drk:policy-336-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use in at least one of Germany and France"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC336-p1-r1 .
kgc:KGC336-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC336-p1-c1 .
kgc:KGC336-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:isAnyOf ;
    odrl:rightOperand ( loc:DE loc:FR ) .
drk:policy-336-2 a odrl:Set ;
    odrl:uid drk:policy-336-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use in Bavaria only"@en ;
    odrl:assignee drk:researcher ;
    odrl:permission kgc:KGC336-p2-r1 .
kgc:KGC336-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC336-p2-c1 .
kgc:KGC336-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:DE-BY .

### Expected result #######################################################

drk:KGC336-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC336" ;
    vrep:referencePolicy drk:policy-336-1 ;
    vrep:comparedPolicy drk:policy-336-2 ;
    vrep:referenceConstraint kgc:KGC336-p1-c1 ;
    vrep:comparedConstraint kgc:KGC336-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-geo> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-loc/iso> ;
    rdfs:comment """The ISO 3166 rule makes Bavaria distinct from Germany and from France, so it is neither value the first policy lists."""@en ;
    dcterms:description """A library permits use in at least one of Germany and France. A researcher's policy commits to use in Bavaria. The ISO 3166 rule makes Bavaria a different place from both countries."""@en ;
    vrep:compatibilityState vrep:Incompatible ;
    vrep:certificate <certificates/KGC336-1.tstp> .
