# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .

drk:policy-302-1 a odrl:Set ;
    odrl:uid drk:policy-302-1 ;
    dcterms:title "Use within Europe"@en ;
    odrl:assigner drk:german-library ;
    odrl:permission kgc:KGC302-p1-r1 .

kgc:KGC302-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC302-p1-c1 .

kgc:KGC302-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand <https://sws.geonames.org/6255148/> .

drk:policy-302-2 a odrl:Set ;
    odrl:uid drk:policy-302-2 ;
    dcterms:title "Use in France only"@en ;
    odrl:assignee drk:french-library ;
    odrl:permission kgc:KGC302-p2-r1 .

kgc:KGC302-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC302-p2-c1 .

kgc:KGC302-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand <https://sws.geonames.org/3017382/> .

### Expected result #######################################################

drk:KGC302-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC302" ;
    vrep:referencePolicy drk:policy-302-1 ;
    vrep:comparedPolicy drk:policy-302-2 ;
    vrep:referenceConstraint kgc:KGC302-p1-c1 ;
    vrep:comparedConstraint kgc:KGC302-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-geonames> ;
    vrep:declarations <https://w3id.org/odrl-kb/geonames-europe/empty> ;
    rdfs:comment """GeoNames places France within Europe, so a use in France satisfies both policies in every structure."""@en ;
    dcterms:description """A German library permits use within Europe. A French library's policy commits to use in France only."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC302-2.tstp> .
