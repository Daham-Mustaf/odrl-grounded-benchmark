# Generated by the scripts in generators/.

# A check made while a policy is drafted: whether a choice of exactly one
# combines an isAllOf constraint.  The answer comes from the policy's
# constraints alone, so no vocabulary was opened and no prover was run.
#
# A rejected policy is not false.  Exactly one asks every other constraint
# to fail, and the failure of an isAllOf constraint is not one constraint:
# any one of its values may be missing.

@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .

drk:policy-123-1 a odrl:Set ;
    odrl:uid drk:policy-123-1 ;
    dcterms:title "Use either in German only or in both German and French"@en ;
    odrl:assigner drk:german-library ;
    odrl:permission kgc:KGC123-p1-r1 .

kgc:KGC123-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC123-p1-lc .

kgc:KGC123-p1-lc a odrl:LogicalConstraint ;
    odrl:xone ( kgc:KGC123-p1-c1 kgc:KGC123-p1-c2 ) .

kgc:KGC123-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:de .

kgc:KGC123-p1-c2 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:isAllOf ;
    odrl:rightOperand ( bcp47:de bcp47:fr ) .

### Expected result #######################################################

drk:KGC123-report a vrep:WellSortednessReport ;
    dcterms:identifier "KGC123" ;
    vrep:constraint kgc:KGC123-p1-lc ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47> ;
    dcterms:description """A German library's policy uses exactly one of eq with German and isAllOf with German and French, languages in the IANA registry."""@en ;
    rdfs:comment """Exactly one of the two must hold, so the other must fail, and isAllOf with German and French fails in two ways: German is missing, or French is missing.  That is not one constraint, so an xone must not combine an isAllOf constraint."""@en ;
    vrep:wellSorted false .
