# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:traffic-data a dcat:Dataset ;
    dcterms:title "Traffic sensor data of a city"@en .

drk:policy-314-1 a odrl:Set ;
    odrl:uid drk:policy-314-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for scientific research only"@en ;
    odrl:assigner drk:data-platform ;
    odrl:permission kgc:KGC314-p1-r1 .

kgc:KGC314-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC314-p1-c1 .

kgc:KGC314-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ScientificResearch .

drk:policy-314-2 a odrl:Set ;
    odrl:uid drk:policy-314-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for marketing only"@en ;
    odrl:assignee drk:data-user ;
    odrl:permission kgc:KGC314-p2-r1 .

kgc:KGC314-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC314-p2-c1 .

kgc:KGC314-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:Marketing .

### Expected result #######################################################

drk:KGC314-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC314" ;
    vrep:referencePolicy drk:policy-314-1 ;
    vrep:comparedPolicy drk:policy-314-2 ;
    vrep:referenceConstraint kgc:KGC314-p1-c1 ;
    vrep:comparedConstraint kgc:KGC314-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-purposes/declared> ;
    vrep:readAgainst drk:KGC313-report ;
    rdfs:comment """The declarations state that scientific research and marketing are different purposes, because DPV defines each as a purpose of its own. No use is both, so no use meets both policies. Without the declaration the verdict is Unknown, as in KGC313."""@en ;
    dcterms:description """As KGC313, with scientific research and marketing declared distinct."""@en ;
    vrep:compatibilityState vrep:Incompatible ;
    vrep:certificate <certificates/KGC314-1.tstp> .
