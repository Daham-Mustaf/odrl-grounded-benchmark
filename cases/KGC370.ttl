@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-370 a odrl:Offer ;
    dcterms:title "Distribution in German"@en ;
    odrl:assigner drk:publisher ;
    odrl:permission kgc:KGC370-offer-r1 .

kgc:KGC370-offer-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC370-offer-c1 .

kgc:KGC370-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:de .

drk:request-370 a odrl:Request ;
    dcterms:title "Distribution in French"@en ;
    odrl:assignee drk:reuser ;
    odrl:permission kgc:KGC370-request-r1 .

kgc:KGC370-request-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC370-request-c1 .

kgc:KGC370-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:fr .

### Expected result #######################################################

drk:KGC370-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC370" ;
    report:policy drk:offer-370 ;
    report:policyRequest drk:request-370 ;
    report:constraint kgc:KGC370-offer-c1 ;
    vrep:constraintRequest kgc:KGC370-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47> ;
    rdfs:comment """The two subtags are declared to name distinct languages, which is the parties' rule and not the registry's content. Withdrawing it returns the verdict to Unknown, which is KGC371."""@en ;
    report:satisfactionState report:Unsatisfied ;
    vrep:certificate <certificates/KGC370-1.tstp> .
