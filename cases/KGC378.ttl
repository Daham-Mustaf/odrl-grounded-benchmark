# Generated by the scripts in generators/.

@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-378-1 a odrl:Set ;
    odrl:uid drk:policy-378-1 ;
    dcterms:title "Licence for a German or a French edition"@en ;
    odrl:assigner drk:publisher ;
    odrl:permission kgc:KGC378-p1-r1 .

kgc:KGC378-p1-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC378-p1-lc .

kgc:KGC378-p1-lc a odrl:LogicalConstraint ;
    odrl:or ( kgc:KGC378-p1-c1 kgc:KGC378-p1-c2 ) .

kgc:KGC378-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:de .

kgc:KGC378-p1-c2 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:fr .

drk:policy-378-2 a odrl:Set ;
    odrl:uid drk:policy-378-2 ;
    dcterms:title "Publication of a French edition"@en ;
    odrl:assignee drk:reuser ;
    odrl:permission kgc:KGC378-p2-r1 .

kgc:KGC378-p2-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC378-p2-c1 .

kgc:KGC378-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:fr .

### Expected result #######################################################

drk:KGC378-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC378" ;
    vrep:referencePolicy drk:policy-378-1 ;
    vrep:comparedPolicy drk:policy-378-2 ;
    vrep:referenceConstraint kgc:KGC378-p1-lc ;
    vrep:comparedConstraint kgc:KGC378-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/bcp47/empty> ;
    rdfs:comment """French is the second alternative of the licence and the licensee's language, so a use in French satisfies both policies in every structure."""@en ;
    dcterms:description """A translation licence covers a German or a French edition. The licensee publishes in French."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC378-2.tstp> .
