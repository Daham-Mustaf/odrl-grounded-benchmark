# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:traffic-data a dcat:Dataset ;
    dcterms:title "Traffic sensor data of a city"@en .

drk:policy-315-1 a odrl:Set ;
    odrl:uid drk:policy-315-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for any DPV purpose"@en ;
    odrl:assigner drk:data-platform ;
    odrl:permission kgc:KGC315-p1-r1 .

kgc:KGC315-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC315-p1-c1 .

kgc:KGC315-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:Purpose .

drk:policy-315-2 a odrl:Set ;
    odrl:uid drk:policy-315-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for delivery of goods only"@en ;
    odrl:assignee drk:data-user ;
    odrl:permission kgc:KGC315-p2-r1 .

kgc:KGC315-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC315-p2-c1 .

kgc:KGC315-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:DeliveryOfGoods .

### Expected result #######################################################

drk:KGC315-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC315" ;
    vrep:referencePolicy drk:policy-315-1 ;
    vrep:comparedPolicy drk:policy-315-2 ;
    vrep:referenceConstraint kgc:KGC315-p1-c1 ;
    vrep:comparedConstraint kgc:KGC315-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-purposes/empty> ;
    rdfs:comment """DPV places delivery of goods below Purpose in four steps, so a use for delivery of goods is a use for a DPV purpose."""@en ;
    dcterms:description """A city's traffic data platform permits use for any DPV purpose. A logistics company commits to use for delivery of goods."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC315-2.tstp> .
