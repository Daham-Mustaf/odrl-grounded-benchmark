# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:dataset a dcat:Dataset ;
    dcterms:title "Personal data held by a controller"@en .

drk:policy-343-1 a odrl:Set ;
    odrl:uid drk:policy-343-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use only while the consent on record may justify processing"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC343-p1-r1 .
kgc:KGC343-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC343-p1-c1 .
kgc:KGC343-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:ConsentStatusValidForProcessing .

drk:policy-343-2 a odrl:Set ;
    odrl:uid drk:policy-343-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use only records whose consent was withdrawn"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC343-p2-r1 .
kgc:KGC343-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC343-p2-c1 .
kgc:KGC343-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentWithdrawn .

### Expected result #######################################################

drk:KGC343-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC343" ;
    vrep:referencePolicy drk:policy-343-1 ;
    vrep:comparedPolicy drk:policy-343-2 ;
    vrep:referenceConstraint kgc:KGC343-p1-c1 ;
    vrep:comparedConstraint kgc:KGC343-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-consent-status> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-consent/definitional> ;
    vrep:readAgainst drk:KGC342-report ;
    vrep:readAgainst drk:KGC348-report ;
    rdfs:comment """ConsentWithdrawn lies below the invalid branch, and the declarations declare the two branches disjoint. So it cannot also lie below the valid branch. Without those declarations the verdict is Unknown, as in KGC342."""@en ;
    dcterms:description """As KGC342, with the valid and invalid branches declared disjoint."""@en ;
    vrep:compatibilityState vrep:Incompatible ;
    vrep:certificate <certificates/KGC343-1.tstp> .
