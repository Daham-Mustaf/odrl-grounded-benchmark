@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-343 a odrl:Set ;
    dcterms:title "Use is permitted while the consent on record may justify processing"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC343-offer-r1 .
kgc:KGC343-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC343-offer-c1 .
kgc:KGC343-offer-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:ConsentStatusValidForProcessing .

drk:request-343 a odrl:Request ;
    dcterms:title "Processing continues after consent is withdrawn"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC343-request-r1 .
kgc:KGC343-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC343-request-c1 .
kgc:KGC343-request-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentWithdrawn .

### Expected result #######################################################

drk:KGC343-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC343" ;
    report:policy drk:offer-343 ;
    report:policyRequest drk:request-343 ;
    report:constraint kgc:KGC343-offer-c1 ;
    vrep:constraintRequest kgc:KGC343-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-consent-status> ;
    rdfs:comment """The withdrawn state lies below the invalid branch, and the branches are declared to have nothing below both. The declaration follows DPV's definitions but is not asserted by DPV; withdrawing it reopens the verdict."""@en ;
    dcterms:description """As KGC342, with the valid and invalid branches declared disjoint on DPV's definitions."""@en ;
    report:satisfactionState report:Unsatisfied ;
    vrep:certificate <certificates/KGC343-1.tstp> .
