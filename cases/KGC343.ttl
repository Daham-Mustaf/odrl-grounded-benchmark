@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpvo:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-343 a odrl:Offer ;
    dcterms:title "Use is permitted while consent may justify processing"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC343-offer-r1 .

kgc:KGC343-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC343-offer-c1 .

kgc:KGC343-offer-c1 a odrl:Constraint ;
    odrl:leftOperand dpvo:Status ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:ConsentStatusValidForProcessing .

drk:request-343 a odrl:Request ;
    dcterms:title "The consent record is in the withdrawn state"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC343-request-r1 .

kgc:KGC343-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC343-request-c1 .

kgc:KGC343-request-c1 a odrl:Constraint ;
    odrl:leftOperand dpvo:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentWithdrawn .

### Expected result #######################################################

drk:KGC343-report a vrep:OperandReport ;
    dcterms:identifier "KGC343" ;
    vrep:firstPolicy drk:bsb-offer ;
    vrep:secondPolicy drk:bnf-request ;
    vrep:firstConstraint kgc:KGC343-offer-c1 ;
    vrep:secondConstraint kgc:KGC343-request-c1 ;
    vrep:leftOperand odrl:Status ;
    vrep:sort vrep:tax ;
    vrep:resource <https://w3id.org/odrl-kb/dpv-consent> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-consent/definitional> ;
    vrep:verdict vrep:Incompatible ;
    vrep:certificate drk:KGC343-certificate .

drk:KGC343-certificate a vrep:Refutation ;
    rdfs:comment """The withdrawn state lies below the invalid branch, and the branches are declared to have nothing in common.  The declaration follows the module's definitions; the module does not assert it, so a party may withdraw it and reopen the verdict."""@en ;
    vrep:clashingConstraint kgc:KGC343-offer-c1, kgc:KGC343-request-c1 ;
    vrep:premise [ vrep:premiseSource vrep:fromResource ;
                   rdfs:label "dpv:ConsentWithdrawn is below dpv:ConsentStatusInvalidForProcessing"@en ] ;
    vrep:premise [ vrep:premiseSource vrep:fromBackgroundTheory ;
                   rdfs:label "the two branches have nothing below both"@en ] .
