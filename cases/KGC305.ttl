# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-305-1 a odrl:Set ;
    odrl:uid drk:policy-305-1 ;
    dcterms:title "Use within exactly one of France and Germany"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC305-p1-r1 .

kgc:KGC305-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC305-p1-lc .

kgc:KGC305-p1-lc a odrl:LogicalConstraint ;
    odrl:xone ( kgc:KGC305-p1-c1 kgc:KGC305-p1-c2 ) .

kgc:KGC305-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand <https://sws.geonames.org/3017382/> .

kgc:KGC305-p1-c2 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand <https://sws.geonames.org/2921044/> .

drk:policy-305-2 a odrl:Set ;
    odrl:uid drk:policy-305-2 ;
    dcterms:title "Use in France"@en ;
    odrl:permission kgc:KGC305-p2-r1 .

kgc:KGC305-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC305-p2-c1 .

kgc:KGC305-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand <https://sws.geonames.org/3017382/> .

### Expected result #######################################################

drk:KGC305-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC305" ;
    vrep:referencePolicy drk:policy-305-1 ;
    vrep:comparedPolicy drk:policy-305-2 ;
    vrep:referenceConstraint kgc:KGC305-p1-lc ;
    vrep:comparedConstraint kgc:KGC305-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-geonames> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/geonames-europe/declared> ;
    vrep:readAgainst drk:KGC306-report ;
    rdfs:comment """Distinct areas can still lie one within the other. A structure that places France within Germany makes both alternatives hold, so the verdict is Unknown."""@en ;
    dcterms:description """A library permits use within exactly one of France and Germany. A researcher's policy commits to use in France. France and Germany are declared distinct."""@en ;
    vrep:compatibilityState vrep:Unknown ;
    vrep:unknownReason vrep:Epistemic .
