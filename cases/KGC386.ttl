@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
drk:offer-386 a odrl:Set ;
    dcterms:title "Offer: use anywhere except Bavaria and Berlin"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC386-offer-r1 .
kgc:KGC386-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC386-offer-c1 .
kgc:KGC386-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:isNoneOf ;
    odrl:rightOperand loc:DE-BY ,
        loc:DE-BE .
drk:request-386 a odrl:Request ;
    dcterms:title "Request: use in Hamburg"@en ;
    odrl:permission kgc:KGC386-request-r1 .
kgc:KGC386-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC386-request-c1 .
kgc:KGC386-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:DE-HH .

### Expected result #######################################################

drk:KGC386-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC386" ;
    report:policy drk:offer-386 ;
    report:policyRequest drk:request-386 ;
    report:constraint kgc:KGC386-offer-c1 ;
    vrep:constraintRequest kgc:KGC386-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-geo> ;
    rdfs:comment """A structure identifying Hamburg with Bavaria defeats the witness; nothing published forbids it."""@en ;
    report:satisfactionState vrep:Undetermined ;
    vrep:undeterminedReason vrep:Epistemic .
