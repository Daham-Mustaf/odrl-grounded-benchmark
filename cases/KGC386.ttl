@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
drk:policy-386-1 a odrl:Set ;
    odrl:uid drk:policy-386-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use anywhere except Bavaria and Berlin"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC386-p1-r1 .
kgc:KGC386-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC386-p1-c1 .
kgc:KGC386-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:isNoneOf ;
    odrl:rightOperand ( loc:DE-BY loc:DE-BE ) .
drk:policy-386-2 a odrl:Set ;
    odrl:uid drk:policy-386-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use in Hamburg"@en ;
    odrl:permission kgc:KGC386-p2-r1 .
kgc:KGC386-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC386-p2-c1 .
kgc:KGC386-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:DE-HH .

### Expected result #######################################################

drk:KGC386-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC386" ;
    vrep:referencePolicy drk:policy-386-1 ;
    vrep:comparedPolicy drk:policy-386-2 ;
    vrep:referenceConstraint kgc:KGC386-p1-c1 ;
    vrep:comparedConstraint kgc:KGC386-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-geo> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-loc/empty> ;
    vrep:readAgainst drk:KGC387-report ;
    rdfs:comment """DPV does not state that Hamburg differs from Bavaria or Berlin. A structure that identifies Hamburg with one of them excludes the use, so the verdict is Unknown."""@en ;
    dcterms:description """A library permits use anywhere except Bavaria and Berlin. A researcher's policy commits to use in Hamburg."""@en ;
    vrep:compatibilityState vrep:Unknown ;
    vrep:unknownReason vrep:Epistemic .
