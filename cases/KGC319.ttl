# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:traffic-data a dcat:Dataset ;
    dcterms:title "Traffic sensor data of a city"@en .

drk:policy-319-1 a odrl:Set ;
    odrl:uid drk:policy-319-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use under exactly one of the commercial and non-commercial tiers"@en ;
    odrl:assigner drk:data-platform ;
    odrl:permission kgc:KGC319-p1-r1 .
kgc:KGC319-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC319-p1-lc .
kgc:KGC319-p1-lc a odrl:LogicalConstraint ;
    odrl:xone ( kgc:KGC319-p1-c1 kgc:KGC319-p1-c2 ) .
kgc:KGC319-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:CommercialPurpose .
kgc:KGC319-p1-c2 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:NonCommercialPurpose .
drk:policy-319-2 a odrl:Set ;
    odrl:uid drk:policy-319-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for non-commercial research only"@en ;
    odrl:assignee drk:data-user ;
    odrl:permission kgc:KGC319-p2-r1 .
kgc:KGC319-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC319-p2-c1 .
kgc:KGC319-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:NonCommercialResearch .

### Expected result #######################################################

drk:KGC319-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC319" ;
    vrep:referencePolicy drk:policy-319-1 ;
    vrep:comparedPolicy drk:policy-319-2 ;
    vrep:referenceConstraint kgc:KGC319-p1-lc ;
    vrep:comparedConstraint kgc:KGC319-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-purposes/empty> ;
    rdfs:comment """DPV places non-commercial research below non-commercial purpose, so the second branch holds. DPV defines a commercial purpose as one performed in "a commercial setting or with intention to commercialise" and a non-commercial purpose as one performed in "a non-commercial setting or without intention to commercialise". One purpose can meet both, so no disjointness between the two is warranted, and none is declared. In a structure that keeps non-commercial research out of commercial purpose, a use for it satisfies both policies. In a structure that also places it below commercial purpose, both branches hold, so 'exactly one' fails, and no use satisfies both. So the verdict is Unknown."""@en ;
    dcterms:description """A city's traffic data platform prices its data in two tiers, commercial and non-commercial, and each use must fall under exactly one tier. A university research group commits to use for non-commercial research."""@en ;
    vrep:compatibilityState vrep:Unknown .
