# Generated by the scripts in generators/.

@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-379-1 a odrl:Set ;
    odrl:uid drk:policy-379-1 ;
    dcterms:title "Licence for a single-language edition, German or French"@en ;
    odrl:assigner drk:publisher ;
    odrl:permission kgc:KGC379-p1-r1 .

kgc:KGC379-p1-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC379-p1-lc .

kgc:KGC379-p1-lc a odrl:LogicalConstraint ;
    odrl:xone ( kgc:KGC379-p1-c1 kgc:KGC379-p1-c2 ) .

kgc:KGC379-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:de .

kgc:KGC379-p1-c2 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:fr .

drk:policy-379-2 a odrl:Set ;
    odrl:uid drk:policy-379-2 ;
    dcterms:title "Publication of a German edition"@en ;
    odrl:assignee drk:reuser ;
    odrl:permission kgc:KGC379-p2-r1 .

kgc:KGC379-p2-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC379-p2-c1 .

kgc:KGC379-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:de .

### Expected result #######################################################

drk:KGC379-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC379" ;
    vrep:referencePolicy drk:policy-379-1 ;
    vrep:comparedPolicy drk:policy-379-2 ;
    vrep:referenceConstraint kgc:KGC379-p1-lc ;
    vrep:comparedConstraint kgc:KGC379-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47> ;
    vrep:declarations <https://w3id.org/odrl-kb/bcp47/empty> ;
    rdfs:comment """Nothing states that German and French are different languages. In a structure that keeps them apart, a use in German satisfies the first alternative only, so both policies hold. In a structure that identifies them, a use in German satisfies both alternatives, and exactly one fails. So the verdict is Unknown."""@en ;
    dcterms:description """A licence for a single-language edition allows exactly one of German and French. The licensee publishes in German."""@en ;
    vrep:compatibilityState vrep:Unknown .
