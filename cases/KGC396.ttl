    odrl:operator odrl:isAnyOf ;
    odrl:rightOperand ( dpv:ResearchAndDevelopment dpv:Marketing ) .
drk:policy-396-2 a odrl:Set ;
    odrl:uid drk:policy-396-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Research and development and service provision"@en ;
    odrl:assignee drk:consumer ;
    odrl:permission kgc:KGC396-p2-r1 .
kgc:KGC396-p2-r1 a odrl:Permission ;
