drk:policy-396-1 a odrl:Set ;
    odrl:uid drk:policy-396-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for research and development or marketing"@en ;
    odrl:assigner drk:provider ;
    odrl:permission kgc:KGC396-p1-r1 .
kgc:KGC396-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC396-p1-c1 .
