@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-364 a odrl:Offer ;
    dcterms:title "Use is permitted with both encryption and access control in place"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC364-offer-r1 .

kgc:KGC364-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC364-offer-c1 .

kgc:KGC364-offer-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:TechnicalOrganisationalMeasure ;
    odrl:operator odrl:isAllOf ;
    odrl:rightOperand ( dpv:Encryption dpv:AccessControlMethod ) .

drk:request-364 a odrl:Request ;
    dcterms:title "Use is requested with encryption in place"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC364-request-r1 .

kgc:KGC364-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC364-request-c1 .

kgc:KGC364-request-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:TechnicalOrganisationalMeasure ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:Encryption .

### Expected result #######################################################

drk:KGC364-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC364" ;
    report:policy drk:offer-364 ;
    report:policyRequest drk:request-364 ;
    report:constraint kgc:KGC364-offer-c1 ;
    vrep:constraintRequest kgc:KGC364-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-tom> ;
    rdfs:comment """Encryption and access control are declared distinct, so a use supplying only encryption lacks the second."""@en ;
    dcterms:description """As KGC363, with encryption and access control declared distinct."""@en ;
    report:satisfactionState report:Unsatisfied ;
    vrep:certificate <certificates/KGC364-1.tstp> .
