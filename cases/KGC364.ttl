# Generated by the scripts in generators/.

@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-364-1 a odrl:Set ;
    odrl:uid drk:policy-364-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use is permitted with both encryption and access control in place"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC364-p1-r1 .

kgc:KGC364-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC364-p1-c1 .

kgc:KGC364-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:TechnicalOrganisationalMeasure ;
    odrl:operator odrl:isAllOf ;
    odrl:rightOperand ( dpv:Encryption dpv:AccessControlMethod ) .

drk:policy-364-2 a odrl:Set ;
    odrl:uid drk:policy-364-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use with encryption in place"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC364-p2-r1 .

kgc:KGC364-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC364-p2-c1 .

kgc:KGC364-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:TechnicalOrganisationalMeasure ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:Encryption .

### Expected result #######################################################

drk:KGC364-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC364" ;
    vrep:referencePolicy drk:policy-364-1 ;
    vrep:comparedPolicy drk:policy-364-2 ;
    vrep:referenceConstraint kgc:KGC364-p1-c1 ;
    vrep:comparedConstraint kgc:KGC364-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-tom> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-tom/declared> ;
    vrep:readAgainst drk:KGC363-report ;
    rdfs:comment """Encryption and access control are declared distinct, so a use supplying only encryption lacks the second."""@en ;
    dcterms:description """As KGC363, with encryption and access control declared distinct."""@en ;
    vrep:compatibilityState vrep:Incompatible ;
    vrep:certificate <certificates/KGC364-1.tstp> .
