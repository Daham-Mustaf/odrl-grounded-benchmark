# Generated by the scripts in generators/.

# A check made while a policy is drafted: whether the operator applies to the
# kind of value the policy gives.  The answer comes from the operator and the
# kind of value alone, so no vocabulary was opened and no prover was run.
#
# A rejected policy is not false.  It asks a question the vocabulary cannot
# answer: isA over a vocabulary that arranges nothing in kinds has nothing to
# test, and an evaluator that answered yes or no would be inventing an answer.

@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .

drk:policy-105-1 a odrl:Set ;
    odrl:uid drk:policy-105-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for a purpose that includes non-commercial purposes"@en ;
    odrl:assigner drk:german-library ;
    odrl:permission kgc:KGC105-p1-r1 .

kgc:KGC105-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC105-p1-c1 .

kgc:KGC105-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:hasPart ;
    odrl:rightOperand dpv:NonCommercialPurpose .

### Expected result #######################################################

drk:KGC105-report a vrep:WellSortednessReport ;
    dcterms:identifier "KGC105" ;
    vrep:constraint kgc:KGC105-p1-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    dcterms:description """A German library's policy uses hasPart with non-commercial purposes, a purpose in DPV."""@en ;
    rdfs:comment """hasPart asks whether one value has another as a part.  DPV only states which purpose is a kind of which, so the operator does not apply to this kind of value."""@en ;
    vrep:wellSorted false .
