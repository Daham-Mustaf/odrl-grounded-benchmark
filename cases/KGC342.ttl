# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:dataset a dcat:Dataset ;
    dcterms:title "Personal data held by a controller"@en .

drk:policy-342-1 a odrl:Set ;
    odrl:uid drk:policy-342-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use only while the consent on record may justify processing"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC342-p1-r1 .
kgc:KGC342-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC342-p1-c1 .
kgc:KGC342-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:ConsentStatusValidForProcessing .

drk:policy-342-2 a odrl:Set ;
    odrl:uid drk:policy-342-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use only records whose consent was withdrawn"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC342-p2-r1 .
kgc:KGC342-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC342-p2-c1 .
kgc:KGC342-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentWithdrawn .

### Expected result #######################################################

drk:KGC342-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC342" ;
    vrep:referencePolicy drk:policy-342-1 ;
    vrep:comparedPolicy drk:policy-342-2 ;
    vrep:referenceConstraint kgc:KGC342-p1-c1 ;
    vrep:comparedConstraint kgc:KGC342-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-consent-status> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-consent/empty> ;
    vrep:readAgainst drk:KGC343-report ;
    vrep:readAgainst drk:KGC348-report ;
    rdfs:comment """DPV places the withdrawn state below the invalid branch, which it defines as the states that cannot justify processing, but does not state in RDF that the valid and invalid branches are disjoint. If withdrawn consent also lies below the valid branch, a use meets both policies; if it does not, no use does. So the verdict is Unknown."""@en ;
    dcterms:description """A controller permits use only while the consent on record may justify processing. A processor commits to use only records whose consent was withdrawn, in an erasure audit for the controller."""@en ;
    vrep:compatibilityState vrep:Unknown .
