# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-345-1 a odrl:Set ;
    odrl:uid drk:policy-345-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use is permitted while the record is in exactly one of the given and withdrawn states"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC345-p1-r1 .
kgc:KGC345-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC345-p1-c1 .
kgc:KGC345-p1-c1 a odrl:LogicalConstraint ;
    odrl:xone ( kgc:KGC345-p1-a1 kgc:KGC345-p1-a2 ) .

kgc:KGC345-p1-a1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentGiven .

kgc:KGC345-p1-a2 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentWithdrawn .

drk:policy-345-2 a odrl:Set ;
    odrl:uid drk:policy-345-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Processing only under given consent"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC345-p2-r1 .
kgc:KGC345-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC345-p2-c1 .
kgc:KGC345-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentGiven .

### Expected result #######################################################

drk:KGC345-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC345" ;
    vrep:referencePolicy drk:policy-345-1 ;
    vrep:comparedPolicy drk:policy-345-2 ;
    vrep:referenceConstraint kgc:KGC345-p1-c1 ;
    vrep:comparedConstraint kgc:KGC345-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-consent-status> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-consent/declared> ;
    rdfs:comment """The two states are declared distinct, so exactly one alternative holds of a record in the given state. The premise is the parties'; withdrawing it returns the verdict to Unknown."""@en ;
    dcterms:description """As KGC344, with the given and withdrawn states declared distinct."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC345-2.tstp> .
