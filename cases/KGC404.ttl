# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:traffic-data a dcat:Dataset ;
    dcterms:title "Traffic sensor data of a city"@en .

drk:policy-404-1 a odrl:Set ;
    odrl:uid drk:policy-404-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for research and development or any narrower purpose"@en ;
    odrl:assigner drk:data-platform ;
    odrl:permission kgc:KGC404-p1-r1 .
kgc:KGC404-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC404-p1-c1 .
kgc:KGC404-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:ResearchAndDevelopment .
drk:policy-404-2 a odrl:Set ;
    odrl:uid drk:policy-404-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for non-commercial purposes or any narrower purpose"@en ;
    odrl:assignee drk:data-user ;
    odrl:permission kgc:KGC404-p2-r1 .
kgc:KGC404-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC404-p2-c1 .
kgc:KGC404-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:NonCommercialPurpose .

### Expected result #######################################################

drk:KGC404-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC404" ;
    vrep:referencePolicy drk:policy-404-1 ;
    vrep:comparedPolicy drk:policy-404-2 ;
    vrep:referenceConstraint kgc:KGC404-p1-c1 ;
    vrep:comparedConstraint kgc:KGC404-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-purposes/empty> ;
    rdfs:comment """DPV places non-commercial research below research and development and below non-commercial purpose, so a use for non-commercial research lies under the category of each policy."""@en ;
    dcterms:description """A city's traffic data platform permits use for research and development or any narrower purpose. A university commits to use for non-commercial purposes or any narrower purpose."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC404-2.tstp> .
