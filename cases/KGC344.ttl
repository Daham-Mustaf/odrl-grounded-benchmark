@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-344 a odrl:Set ;
    dcterms:title "Use is permitted while the record is in exactly one of the given and withdrawn states"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC344-offer-r1 .
kgc:KGC344-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC344-offer-c1 .
kgc:KGC344-offer-c1 a odrl:LogicalConstraint ;
    odrl:xone ( kgc:KGC344-offer-a1 kgc:KGC344-offer-a2 ) .

kgc:KGC344-offer-a1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentGiven .

kgc:KGC344-offer-a2 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentWithdrawn .

drk:request-344 a odrl:Request ;
    dcterms:title "Processing only under given consent"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC344-request-r1 .
kgc:KGC344-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC344-request-c1 .
kgc:KGC344-request-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentGiven .

### Expected result #######################################################

drk:KGC344-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC344" ;
    report:policy drk:offer-344 ;
    report:policyRequest drk:request-344 ;
    report:constraint kgc:KGC344-offer-c1 ;
    vrep:constraintRequest kgc:KGC344-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-consent-status> ;
    rdfs:comment """One structure makes the given and withdrawn states one concept, and exactly-one then fails; nothing published forbids it."""@en ;
    dcterms:description """An offer requires the record to be in exactly one of the given and withdrawn states; a processor commits to processing only under given consent."""@en ;
    report:satisfactionState vrep:Undetermined ;
    vrep:undeterminedReason vrep:Epistemic .
