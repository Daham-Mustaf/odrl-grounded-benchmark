drk:policy-344-1 a odrl:Set ;
    odrl:uid drk:policy-344-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use is permitted while the record is in exactly one of the given and withdrawn states"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC344-p1-r1 .
kgc:KGC344-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC344-p1-c1 .
kgc:KGC344-p1-c1 a odrl:LogicalConstraint ;
    odrl:xone ( kgc:KGC344-p1-a1 kgc:KGC344-p1-a2 ) .

kgc:KGC344-p1-a1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentGiven .

kgc:KGC344-p1-a2 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentWithdrawn .

drk:policy-344-2 a odrl:Set ;
    odrl:uid drk:policy-344-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Processing only under given consent"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC344-p2-r1 .
kgc:KGC344-p2-r1 a odrl:Permission ;
