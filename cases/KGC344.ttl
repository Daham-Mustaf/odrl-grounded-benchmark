@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpvo:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-344 a odrl:Offer ;
    dcterms:title "Use is permitted while the consent record is settled: given or withdrawn, and not both"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC344-offer-r1 .

kgc:KGC344-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC344-offer-c1 .

kgc:KGC344-offer-c1 a odrl:LogicalConstraint ;
    odrl:xone ( kgc:KGC344-offer-a1, kgc:KGC344-offer-a2 ) .

kgc:KGC344-offer-a1 a odrl:Constraint ;
    odrl:leftOperand dpvo:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentGiven .

kgc:KGC344-offer-a2 a odrl:Constraint ;
    odrl:leftOperand dpvo:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentWithdrawn .

drk:request-344 a odrl:Request ;
    dcterms:title "The consent record is in the given state"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC344-request-r1 .

kgc:KGC344-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC344-request-c1 .

kgc:KGC344-request-c1 a odrl:Constraint ;
    odrl:leftOperand dpvo:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentGiven .

### Expected result #######################################################

drk:KGC344-report a vrep:OperandReport ;
    dcterms:identifier "KGC344" ;
    vrep:firstPolicy drk:bsb-offer ;
    vrep:secondPolicy drk:bnf-request ;
    vrep:firstConstraint kgc:KGC344-offer-c1 ;
    vrep:secondConstraint kgc:KGC344-request-c1 ;
    vrep:leftOperand odrl:Status ;
    vrep:sort vrep:tax ;
    vrep:resource <https://w3id.org/odrl-kb/dpv-consent> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-consent/empty> ;
    vrep:verdict vrep:Unknown ;
    vrep:certificate drk:KGC344-certificate .

drk:KGC344-certificate a vrep:Models ;
    rdfs:comment """Both queries are satisfiable.  The models differ on whether the given and withdrawn states are one, and the exclusive requirement turns on that."""@en .
