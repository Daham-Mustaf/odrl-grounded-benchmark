# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .

drk:policy-301-1 a odrl:Set ;
    odrl:uid drk:policy-301-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for non-commercial purposes or any narrower purpose"@en ;
    odrl:assigner drk:german-library ;
    odrl:permission kgc:KGC301-p1-r1 .

kgc:KGC301-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC301-p1-c1 .

kgc:KGC301-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:NonCommercialPurpose .

drk:policy-301-2 a odrl:Set ;
    odrl:uid drk:policy-301-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for scientific research only"@en ;
    odrl:assignee drk:french-library ;
    odrl:permission kgc:KGC301-p2-r1 .

kgc:KGC301-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC301-p2-c1 .

kgc:KGC301-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ScientificResearch .

### Expected result #######################################################

drk:KGC301-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC301" ;
    vrep:referencePolicy drk:policy-301-1 ;
    vrep:comparedPolicy drk:policy-301-2 ;
    vrep:referenceConstraint kgc:KGC301-p1-c1 ;
    vrep:comparedConstraint kgc:KGC301-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-purposes/empty> ;
    rdfs:comment """DPV does not state whether scientific research is a non-commercial purpose. If it is, a use for scientific research meets both policies; if it is not, no use does. So the verdict is Unknown."""@en ;
    dcterms:description """A German library permits use for non-commercial purposes or any narrower purpose. A French library's policy commits to use for scientific research only."""@en ;
    vrep:compatibilityState vrep:Unknown .
