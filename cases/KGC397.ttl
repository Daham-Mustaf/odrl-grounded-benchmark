@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
drk:offer-397 a odrl:Offer ;
    dcterms:title "Offer: use for any purpose except marketing"@en ;
    odrl:assigner drk:provider ;
    odrl:permission kgc:KGC397-offer-r1 .
kgc:KGC397-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC397-offer-c1 .
kgc:KGC397-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:purpose ;
    odrl:operator odrl:isNoneOf ;
    odrl:rightOperand dpv:Marketing .
drk:request-397 a odrl:Request ;
    dcterms:title "Request: advertising"@en ;
    odrl:assignee drk:consumer ;
    odrl:permission kgc:KGC397-request-r1 .
kgc:KGC397-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC397-request-c1 .
kgc:KGC397-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:Advertising .

### Expected result #######################################################

drk:KGC397-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC397" ;
    report:policy drk:offer-397 ;
    report:policyRequest drk:request-397 ;
    report:constraint kgc:KGC397-offer-c1 ;
    vrep:constraintRequest kgc:KGC397-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    rdfs:comment """Advertising is declared distinct from marketing, so it lies in the complement; that it lies below marketing is not consulted."""@en ;
    dcterms:description """A provider permits use for any purpose except marketing; a consumer commits to advertising."""@en ;
    report:satisfactionState report:Satisfied ;
    vrep:certificate <certificates/KGC397-2.tstp> .
