@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-373 a odrl:Set ;
    dcterms:title "Distribution in German"@en ;
    odrl:assigner drk:publisher ;
    odrl:permission kgc:KGC373-offer-r1 .

kgc:KGC373-offer-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC373-offer-c1 .

kgc:KGC373-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand bcp47:de .

drk:request-373 a odrl:Request ;
    dcterms:title "Distribution in American English"@en ;
    rdfs:comment """A well-formed BCP 47 language tag, composed by RFC 5646 from the registered primary subtag en and the registered region subtag US. It is not itself an entry of the registry and not a concept of the resource this operand is bound to, which holds primary subtags. Whether it resolves to one is the profile's grounding rule to decide, and the two problems using this request are read under rules that decide it differently."""@en ;
    odrl:assignee drk:reuser ;
    odrl:permission kgc:KGC373-request-r1 .

kgc:KGC373-request-r1 a odrl:Permission ;
    odrl:action odrl:distribute ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC373-request-c1 .

kgc:KGC373-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:eq ;
    odrl:rightOperand "en-US" .

### Expected result #######################################################

drk:KGC373-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC373" ;
    report:policy drk:offer-373 ;
    report:policyRequest drk:request-373 ;
    report:constraint kgc:KGC373-offer-c1 ;
    vrep:constraintRequest kgc:KGC373-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47-primary> ;
    rdfs:comment """en-US resolves to English, which is distinct from German."""@en ;
    dcterms:description """A publisher distributes in German, while a reuser requests American English."""@en ;
    report:satisfactionState report:Unsatisfied ;
    vrep:certificate <certificates/KGC373-1.tstp> .
