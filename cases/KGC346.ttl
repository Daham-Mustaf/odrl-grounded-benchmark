@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-346 a odrl:Set ;
    dcterms:title "Use is permitted while the record falls under exactly one of the two consent branches"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC346-offer-r1 .
kgc:KGC346-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC346-offer-c1 .
kgc:KGC346-offer-c1 a odrl:LogicalConstraint ;
    odrl:xone ( kgc:KGC346-offer-a1 kgc:KGC346-offer-a2 ) .

kgc:KGC346-offer-a1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:ConsentStatusValidForProcessing .

kgc:KGC346-offer-a2 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:ConsentStatusInvalidForProcessing .

drk:request-346 a odrl:Request ;
    dcterms:title "Processing only under given consent"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC346-request-r1 .
kgc:KGC346-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC346-request-c1 .
kgc:KGC346-request-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentGiven .

### Expected result #######################################################

drk:KGC346-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC346" ;
    report:policy drk:offer-346 ;
    report:policyRequest drk:request-346 ;
    report:constraint kgc:KGC346-offer-c1 ;
    vrep:constraintRequest kgc:KGC346-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-consent-status> ;
    rdfs:comment """One structure places the given state below both branches; DPV does not rule it out."""@en ;
    dcterms:description """An offer requires the record to fall under exactly one of the two consent branches; a processor commits to processing only under given consent."""@en ;
    report:satisfactionState vrep:Undetermined ;
    vrep:undeterminedReason vrep:Epistemic .
