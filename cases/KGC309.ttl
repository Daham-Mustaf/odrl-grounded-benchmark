# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .

drk:policy-309-1 a odrl:Set ;
    odrl:uid drk:policy-309-1 ;
    dcterms:title "Use within Germany"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC309-p1-r1 .

kgc:KGC309-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC309-p1-c1 .

kgc:KGC309-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:isPartOf ;
    odrl:rightOperand <https://sws.geonames.org/2921044/> .

drk:policy-309-2 a odrl:Set ;
    odrl:uid drk:policy-309-2 ;
    dcterms:title "Use in France only"@en ;
    odrl:assignee drk:researcher ;
    odrl:permission kgc:KGC309-p2-r1 .

kgc:KGC309-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC309-p2-c1 .

kgc:KGC309-p2-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:spatial ;
    odrl:operator odrl:eq ;
    odrl:rightOperand <https://sws.geonames.org/3017382/> .

### Expected result #######################################################

drk:KGC309-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC309" ;
    vrep:referencePolicy drk:policy-309-1 ;
    vrep:comparedPolicy drk:policy-309-2 ;
    vrep:referenceConstraint kgc:KGC309-p1-c1 ;
    vrep:comparedConstraint kgc:KGC309-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-geonames> ;
    vrep:declarations <https://w3id.org/odrl-kb/geonames-europe/siblings> ;
    vrep:readAgainst drk:KGC308-report ;
    rdfs:comment """France and Germany share a parent and are declared disjoint, so they have no common part. France lies within itself, so it cannot lie within Germany, and no use satisfies both policies. Distinctness alone would leave the verdict Unknown, as KGC348 shows for consent."""@en ;
    dcterms:description """As KGC308, with the features that share a parent declared disjoint: nothing lies within both."""@en ;
    vrep:compatibilityState vrep:Incompatible ;
    vrep:certificate <certificates/KGC309-1.tstp> .
