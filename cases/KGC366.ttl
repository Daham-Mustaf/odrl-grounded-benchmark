# Generated by the scripts in generators/.

@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:dataset a dcat:Dataset ;
    dcterms:title "Personal data held by a controller"@en .

drk:policy-366-1 a odrl:Set ;
    odrl:uid drk:policy-366-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use with at least one of encryption and access control in place"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC366-p1-r1 .

kgc:KGC366-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC366-p1-c1 .

kgc:KGC366-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:TechnicalOrganisationalMeasure ;
    odrl:operator odrl:isAnyOf ;
    odrl:rightOperand ( dpv:Encryption dpv:AccessControlMethod ) .

drk:policy-366-2 a odrl:Set ;
    odrl:uid drk:policy-366-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use with encryption at rest as the only measure"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC366-p2-r1 .

kgc:KGC366-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC366-p2-c1 .

kgc:KGC366-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:TechnicalOrganisationalMeasure ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:EncryptionAtRest .

### Expected result #######################################################

drk:KGC366-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC366" ;
    vrep:referencePolicy drk:policy-366-1 ;
    vrep:comparedPolicy drk:policy-366-2 ;
    vrep:referenceConstraint kgc:KGC366-p1-c1 ;
    vrep:comparedConstraint kgc:KGC366-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-tom> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-tom/declared> ;
    vrep:readAgainst drk:KGC362-report ;
    rdfs:comment """isAnyOf asks whether a measure in use is the same as a listed one. DPV places encryption at rest below encryption, yet it is neither encryption nor access control. With the measures declared distinct, since DPV defines each separately, a use whose only measure is encryption at rest has neither measure the first policy lists, and no use meets both policies. ODRL has no operator for "includes some kind of encryption". Without the declarations the verdict would be Unknown."""@en ;
    dcterms:description """A controller requires at least one of encryption and access control. A processor's policy commits to encryption at rest as the only measure."""@en ;
    vrep:compatibilityState vrep:Incompatible ;
    vrep:certificate <certificates/KGC366-1.tstp> .
