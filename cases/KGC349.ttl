# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:dataset a dcat:Dataset ;
    dcterms:title "Personal data held by a controller"@en .

drk:policy-349-1 a odrl:Set ;
    odrl:uid drk:policy-349-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use under any consent status except withdrawn and revoked"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC349-p1-r1 .
kgc:KGC349-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC349-p1-c1 .
kgc:KGC349-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:isNoneOf ;
    odrl:rightOperand ( dpv:ConsentWithdrawn dpv:ConsentRevoked ) .

drk:policy-349-2 a odrl:Set ;
    odrl:uid drk:policy-349-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use only while the consent on record has expired"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC349-p2-r1 .
kgc:KGC349-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC349-p2-c1 .
kgc:KGC349-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Status ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ConsentExpired .

### Expected result #######################################################

drk:KGC349-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC349" ;
    vrep:referencePolicy drk:policy-349-1 ;
    vrep:comparedPolicy drk:policy-349-2 ;
    vrep:referenceConstraint kgc:KGC349-p1-c1 ;
    vrep:comparedConstraint kgc:KGC349-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-consent-status> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-consent/declared> ;
    rdfs:comment """Expired consent is declared distinct from withdrawn and from revoked consent, so the exclusion list lets it through. A policy written over the valid branch, isA as in KGC343, would have refused it once the branches are declared disjoint, because expired consent lies below the invalid branch."""@en ;
    dcterms:description """A controller permits use under any consent status except withdrawn and revoked. A processor states that it uses the data while the consent on record has expired."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC349-2.tstp> .
