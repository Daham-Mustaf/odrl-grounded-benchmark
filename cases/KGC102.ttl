# Generated by the scripts in generators/. Do not edit by hand: change the
# problem data or the writer and run full-run.sh, which rewrites this file.

# A drafting-time check: whether this constraint can be evaluated at all
# under the sort its operand is bound at.  The answer comes from the
# signature and from nothing else, so no resource was opened and no prover
# was run to produce it.
#
# A rejected constraint is not false.  It is a question the bound resource
# cannot be asked: isA over a resource that publishes no subsumption has
# nothing to test, and an evaluator that returned true or false would be
# inventing an answer.

@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix odrlkb:  <https://w3id.org/odrl-kb/bcp47#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix bind:    <https://w3id.org/odrl-kb/binding#> .

drk:manuscripts a dcterms:Dataset ;
    dcterms:title "Digitised manuscripts, Bavarian State Library"@en .

drk:policy-102-1 a odrl:Set ;
    odrl:uid drk:policy-102-1 ;
    dcterms:title "BSB, language constrained by isA"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC102-p1-r1 .

kgc:KGC102-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC102-p1-c1 .

kgc:KGC102-p1-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:language ;
    odrl:operator odrl:isA ;
    odrl:rightOperand odrlkb:de .

### Expected result #######################################################

drk:KGC102-report a vrep:WellSortednessReport ;
    dcterms:identifier "KGC102" ;
    vrep:constraint kgc:KGC102-p1-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-language-bcp47> ;
    vrep:wellSorted false ;
    rdfs:comment """isA requires subsumption; the operand is nom, whose resource supplies identity"""@en .
