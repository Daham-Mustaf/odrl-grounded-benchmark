# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:traffic-data a dcat:Dataset ;
    dcterms:title "Traffic sensor data of a city"@en .

drk:policy-395-1 a odrl:Set ;
    odrl:uid drk:policy-395-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for public benefit or non-commercial research, or any narrower purpose"@en ;
    odrl:assigner drk:data-platform ;
    odrl:permission kgc:KGC395-p1-r1 .
kgc:KGC395-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC395-p1-lc .
kgc:KGC395-p1-lc a odrl:LogicalConstraint ;
    odrl:or ( kgc:KGC395-p1-c1 kgc:KGC395-p1-c2 ) .
kgc:KGC395-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:PublicBenefit .
kgc:KGC395-p1-c2 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:NonCommercialResearch .
drk:policy-395-2 a odrl:Set ;
    odrl:uid drk:policy-395-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use for improving transport mobility only"@en ;
    odrl:assignee drk:data-user ;
    odrl:permission kgc:KGC395-p2-r1 .
kgc:KGC395-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:traffic-data ;
    odrl:constraint kgc:KGC395-p2-c1 .
kgc:KGC395-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ImproveTransportMobility .

### Expected result #######################################################

drk:KGC395-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC395" ;
    vrep:referencePolicy drk:policy-395-1 ;
    vrep:comparedPolicy drk:policy-395-2 ;
    vrep:referenceConstraint kgc:KGC395-p1-lc ;
    vrep:comparedConstraint kgc:KGC395-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-purposes/empty> ;
    vrep:readAgainst drk:KGC399-report ;
    vrep:readAgainst drk:KGC393-report ;
    rdfs:comment """DPV places improving transport mobility below public benefit, so the first alternative holds for a use for improving transport mobility."""@en ;
    dcterms:description """A city's traffic data platform permits use for public benefit or non-commercial research, or any narrower purpose. A city transport authority commits to improving transport mobility."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC395-2.tstp> .
