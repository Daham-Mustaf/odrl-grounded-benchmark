@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix report:  <https://w3id.org/force/compliance-report#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
drk:offer-395 a odrl:Offer ;
    dcterms:title "Offer: use for research and development or marketing purposes"@en ;
    odrl:assigner drk:provider ;
    odrl:permission kgc:KGC395-offer-r1 .
kgc:KGC395-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC395-offer-lc .
kgc:KGC395-offer-lc a odrl:LogicalConstraint ;
    odrl:or ( kgc:KGC395-offer-c1 kgc:KGC395-offer-c2 ) .
kgc:KGC395-offer-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:purpose ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:ResearchAndDevelopment .
kgc:KGC395-offer-c2 a odrl:Constraint ;
    odrl:leftOperand odrl:purpose ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:Marketing .
drk:request-395 a odrl:Request ;
    dcterms:title "Request: scientific research"@en ;
    odrl:assignee drk:consumer ;
    odrl:permission kgc:KGC395-request-r1 .
kgc:KGC395-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC395-request-c1 .
kgc:KGC395-request-c1 a odrl:Constraint ;
    odrl:leftOperand odrl:purpose ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:ScientificResearch .

### Expected result #######################################################

drk:KGC395-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC395" ;
    report:policy drk:offer-395 ;
    report:policyRequest drk:request-395 ;
    report:constraint kgc:KGC395-offer-c1 ;
    vrep:constraintRequest kgc:KGC395-request-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-purpose> ;
    rdfs:comment """DPV places scientific research below research and development; the first disjunct settles it."""@en ;
    dcterms:description """A provider permits use for any purpose under research and development or under marketing; a consumer commits to scientific research."""@en ;
    report:satisfactionState report:Satisfied ;
    vrep:certificate <certificates/KGC395-2.tstp> .
