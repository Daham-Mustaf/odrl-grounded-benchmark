# Generated by the scripts in generators/.

@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix eu-gdpr: <https://w3id.org/dpv/legal/eu/gdpr#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:policy-353-1 a odrl:Set ;
    odrl:uid drk:policy-353-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Processing is lawful on any legal basis"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC353-p1-r1 .

kgc:KGC353-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC353-p1-c1 .

kgc:KGC353-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:LegalBasis ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:LegalBasis .

drk:policy-353-2 a odrl:Set ;
    odrl:uid drk:policy-353-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Processing is on the basis of explicit consent under Article 6(1)(a)"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC353-p2-r1 .

kgc:KGC353-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC353-p2-c1 .

kgc:KGC353-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:LegalBasis ;
    odrl:operator odrl:eq ;
    odrl:rightOperand eu-gdpr:A6-1-a-explicit-consent .

### Expected result #######################################################

drk:KGC353-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC353" ;
    vrep:referencePolicy drk:policy-353-1 ;
    vrep:comparedPolicy drk:policy-353-2 ;
    vrep:referenceConstraint kgc:KGC353-p1-c1 ;
    vrep:comparedConstraint kgc:KGC353-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-legalbasis> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-gdpr-legal-basis/empty> ;
    rdfs:comment """The vocabulary places explicit consent below the legal-basis root through three published order assertions. Transitivity of the order yields the relation used by isA."""@en ;
    dcterms:description """A controller permits processing on any legal basis in the DPV hierarchy. A processor's policy relies on explicit consent under Article 6(1)(a)."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC353-2.tstp> .
