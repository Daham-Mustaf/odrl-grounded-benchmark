@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix eu-gdpr: <https://w3id.org/dpv/legal/eu/gdpr#> .
@prefix dpvo:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .

drk:offer-353 a odrl:Offer ;
    dcterms:title "Processing is lawful on any legal basis"@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC353-offer-r1 .

kgc:KGC353-offer-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC353-offer-c1 .

kgc:KGC353-offer-c1 a odrl:Constraint ;
    odrl:leftOperand dpvo:LegalBasis ;
    odrl:operator odrl:isA ;
    odrl:rightOperand dpv:LegalBasis .

drk:request-353 a odrl:Request ;
    dcterms:title "Processing is on the basis of explicit consent under Article 6(1)(a)"@en ;
    odrl:assignee drk:processor ;
    odrl:permission kgc:KGC353-request-r1 .

kgc:KGC353-request-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC353-request-c1 .

kgc:KGC353-request-c1 a odrl:Constraint ;
    odrl:leftOperand dpvo:LegalBasis ;
    odrl:operator odrl:eq ;
    odrl:rightOperand eu-gdpr:A6-1-a-explicit-consent .

### Expected result #######################################################

drk:KGC353-report a vrep:OperandReport ;
    dcterms:identifier "KGC353" ;
    vrep:firstPolicy drk:offer-353 ;
    vrep:secondPolicy drk:request-353 ;
    vrep:firstConstraint kgc:KGC353-offer-c1 ;
    vrep:secondConstraint kgc:KGC353-request-c1 ;
    vrep:leftOperand odrl:LegalBasis ;
    vrep:sort vrep:tax ;
    vrep:resource <https://w3id.org/odrl-kb/dpv-gdpr-legal-basis> ;
    vrep:backgroundTheory <https://w3id.org/odrl-kb/dpv-gdpr-legal-basis/empty> ;
    vrep:verdict vrep:Compatible ;
    vrep:certificate drk:KGC353-certificate .

drk:KGC353-certificate a vrep:Refutation ;
    rdfs:comment """The vocabulary carries explicit consent under Article 6(1)(a) up to the legal-basis root in four steps."""@en ;
    vrep:clashingConstraint kgc:KGC353-offer-c1, kgc:KGC353-request-c1 ;
    vrep:premise [ vrep:premiseSource vrep:fromResource ;
                   rdfs:label "eu-gdpr:A6-1-a-explicit-consent is below eu-gdpr:A6-1-a"@en ] ;
    vrep:premise [ vrep:premiseSource vrep:fromResource ;
                   rdfs:label "eu-gdpr:A6-1-a is below eu-gdpr:Consent"@en ] ;
    vrep:premise [ vrep:premiseSource vrep:fromResource ;
                   rdfs:label "eu-gdpr:Consent is below dpv:Consent"@en ] ;
    vrep:premise [ vrep:premiseSource vrep:fromResource ;
                   rdfs:label "dpv:Consent is below dpv:LegalBasis"@en ] ;
    vrep:premise [ vrep:premiseSource vrep:fromOrderAxiom ;
                   rdfs:label "transitivity of the order"@en ] .
