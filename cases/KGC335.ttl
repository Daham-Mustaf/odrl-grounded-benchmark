# Generated by the scripts in generators/.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix loc:     <https://w3id.org/dpv/loc#> .
@prefix dpv-odrl: <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:manuscripts a dcat:Dataset ;
    dcterms:title "Digitised manuscripts of a library"@en .
drk:policy-335-1 a odrl:Set ;
    odrl:uid drk:policy-335-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use anywhere except Germany"@en ;
    odrl:assigner drk:library ;
    odrl:permission kgc:KGC335-p1-r1 .
kgc:KGC335-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC335-p1-c1 .
kgc:KGC335-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:neq ;
    odrl:rightOperand loc:DE .
drk:policy-335-2 a odrl:Set ;
    odrl:uid drk:policy-335-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use in France only"@en ;
    odrl:assignee drk:researcher ;
    odrl:permission kgc:KGC335-p2-r1 .
kgc:KGC335-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:manuscripts ;
    odrl:constraint kgc:KGC335-p2-c1 .
kgc:KGC335-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:Location ;
    odrl:operator odrl:eq ;
    odrl:rightOperand loc:FR .

### Expected result #######################################################

drk:KGC335-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC335" ;
    vrep:referencePolicy drk:policy-335-1 ;
    vrep:comparedPolicy drk:policy-335-2 ;
    vrep:referenceConstraint kgc:KGC335-p1-c1 ;
    vrep:comparedConstraint kgc:KGC335-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-spatial-dpvloc-geo> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-loc/iso> ;
    rdfs:comment """The ISO 3166 rule makes Germany and France different countries, so a use in France is a use outside Germany and satisfies both policies."""@en ;
    dcterms:description """A library permits use anywhere except Germany. A researcher's policy commits to use in France. The ISO 3166 rule makes the two countries different places."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC335-2.tstp> .
