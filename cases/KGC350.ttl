# Generated by the scripts in generators/.

@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dpv:     <https://w3id.org/dpv#> .
@prefix dpv-odrl:    <https://w3id.org/dpv/mappings/odrl#> .
@prefix drk:     <https://w3id.org/odrl-kb/drk/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix kgc:     <https://w3id.org/odrl-kb/problem/> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .

drk:dataset a dcat:Dataset ;
    dcterms:title "Personal data held by a controller"@en .

# The rule's deontic role is not modelled: the verdict decides whether two
# constraint sets admit a common use, not which rule prevails where they do.

drk:policy-350-1 a odrl:Set ;
    odrl:uid drk:policy-350-1 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use on at least one of the legal bases of Article 6(1)"@en ;
    dcterms:source <https://ai.wu.ac.at/policies/orcp/regulatory-model.html> ;
    rdfs:comment "Adapted from the Article 6 example of the ODRL Regulatory Compliance Profile (ORCP), section 'Article 6 Lawfulness of processing': odrl:predicateConstraint is written as odrl:constraint, orcp:legalBasis as dpv-odrl:LegalBasis, and the seven values ORCP lists for Article 6(1) as DPV concepts, with ExerciseOfOfficialAuthority read as dpv:OfficialAuthorityOfController."@en ;
    odrl:assigner drk:controller ;
    odrl:permission kgc:KGC350-p1-r1 .

kgc:KGC350-p1-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC350-p1-c1 .

kgc:KGC350-p1-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:LegalBasis ;
    odrl:operator odrl:isAnyOf ;
    odrl:rightOperand ( dpv:Consent
        dpv:Contract
        dpv:LegalObligation
        dpv:VitalInterest
        dpv:PublicInterest
        dpv:OfficialAuthorityOfController
        dpv:LegitimateInterest ) .

drk:policy-350-2 a odrl:Set ;
    odrl:uid drk:policy-350-2 ;
    odrl:profile dpv-odrl: ;
    dcterms:title "Use on the basis of consent only"@en ;
    odrl:assignee drk:recipient ;
    odrl:permission kgc:KGC350-p2-r1 .

kgc:KGC350-p2-r1 a odrl:Permission ;
    odrl:action odrl:use ;
    odrl:target drk:dataset ;
    odrl:constraint kgc:KGC350-p2-c1 .

kgc:KGC350-p2-c1 a odrl:Constraint ;
    odrl:leftOperand dpv-odrl:LegalBasis ;
    odrl:operator odrl:eq ;
    odrl:rightOperand dpv:Consent .

### Expected result #######################################################

drk:KGC350-report a vrep:OperandVerdictReport ;
    dcterms:identifier "KGC350" ;
    vrep:referencePolicy drk:policy-350-1 ;
    vrep:comparedPolicy drk:policy-350-2 ;
    vrep:referenceConstraint kgc:KGC350-p1-c1 ;
    vrep:comparedConstraint kgc:KGC350-p2-c1 ;
    vrep:binding <https://w3id.org/odrl-kb/profile/b-legalbasis> ;
    vrep:declarations <https://w3id.org/odrl-kb/dpv-gdpr-legal-basis/empty> ;
    rdfs:comment """Consent is one of the seven values listed by isAnyOf, so the two constraints are Compatible without any resource statement or declaration."""@en ;
    dcterms:description """A controller permits processing on any of the seven Article 6(1) legal bases. A recipient's policy relies on consent."""@en ;
    vrep:compatibilityState vrep:Compatible ;
    vrep:certificate <certificates/KGC350-2.tstp> .
