@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix bind:    <https://w3id.org/odrl-kb/binding#> .
@prefix bt:      <https://w3id.org/odrl-kb/background#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/odrl-kb/verdict-report> a owl:Ontology ;
    dcterms:title "Verdict report"@en ;
    vann:preferredNamespacePrefix "vrep" ;
    vann:preferredNamespaceUri "https://w3id.org/odrl-kb/verdict-report#" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:description "Reports the result of comparing two ODRL policies before any use: whether their constraints on one left operand can be satisfied together. The comparison involves no request and no state of the world, so this vocabulary does not extend a compliance report model, which records the evaluation of a policy against a request."@en .

# ----- reports -----

vrep:OperandVerdictReport a rdfs:Class ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Operand Verdict Report"@en ;
    skos:definition "The verdict for the constraints two policies place on one left operand, relative to a binding and a background theory: Compatible when every structure they admit has a use satisfying both constraints, Incompatible when none has, Unknown otherwise or when a value does not ground."@en .

vrep:WellSortednessReport a rdfs:Class ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Well-Sortedness Report"@en ;
    skos:definition "Whether one constraint can be evaluated at all under the sort its left operand is bound at: whether the operator is defined at that sort and the right operand has the arity the operator takes."@en ;
    rdfs:comment "Decided by the signature alone. No resource is opened and no satisfiability question is asked, so an ill-sorted constraint has no verdict rather than a negative one."@en .

# ----- the three verdicts -----

vrep:CompatibilityState a rdfs:Class ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Compatibility State"@en ;
    skos:definition "The verdict of an operand verdict report. Exactly one of vrep:Compatible, vrep:Incompatible and vrep:Unknown."@en ;
    owl:oneOf ( vrep:Compatible vrep:Incompatible vrep:Unknown ) .

vrep:Compatible a vrep:CompatibilityState ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Compatible"@en ;
    skos:definition "Every structure the resource and the background theory admit has a use satisfying both constraints. Certified by a refutation of the negated witness condition."@en .

vrep:Incompatible a vrep:CompatibilityState ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Incompatible"@en ;
    skos:definition "No structure the resource and the background theory admit has a use satisfying both constraints. Certified by a refutation of the witness condition."@en .

vrep:Unknown a vrep:CompatibilityState ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Unknown"@en ;
    skos:definition "The resource and the background theory do not settle the question, or a value does not ground. The report says which through vrep:unknownReason."@en .

vrep:Compatible owl:differentFrom vrep:Incompatible, vrep:Unknown .
vrep:Incompatible owl:differentFrom vrep:Unknown .

# ----- why a verdict is Unknown -----

vrep:UnknownReason a rdfs:Class ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Unknown Reason"@en ;
    skos:definition "Why a report is Unknown. Exactly one of vrep:Epistemic and vrep:Ungrounded."@en ;
    owl:oneOf ( vrep:Epistemic vrep:Ungrounded ) .

vrep:Epistemic a vrep:UnknownReason ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Epistemic"@en ;
    skos:definition "Both satisfiability queries are satisfiable: some admissible structures have a use satisfying both constraints and some do not. Settled by a further declaration in the background theory."@en .

vrep:Ungrounded a vrep:UnknownReason ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Ungrounded"@en ;
    skos:definition "A value names no concept of the bound resource, so no query is built. Repaired by correcting the policy or the binding. The value is given by vrep:ungroundedValue."@en .

vrep:Epistemic owl:differentFrom vrep:Ungrounded .

# ----- properties of an operand verdict report -----

vrep:referencePolicy a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "reference policy"@en ;
    skos:definition "The first of the two policies compared."@en ;
    rdfs:comment "The verdict is symmetric. Reference and compared only fix the order in which the report names the policies."@en ;
    rdfs:domain vrep:OperandVerdictReport ;
    rdfs:range odrl:Policy .

vrep:comparedPolicy a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "compared policy"@en ;
    skos:definition "The second of the two policies compared."@en ;
    rdfs:domain vrep:OperandVerdictReport ;
    rdfs:range odrl:Policy .

vrep:referenceConstraint a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "reference constraint"@en ;
    skos:definition "A constraint of the reference policy on the operand the report is about. Where a rule carries several constraints, each is given; they hold together."@en ;
    rdfs:domain vrep:OperandVerdictReport .

vrep:comparedConstraint a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "compared constraint"@en ;
    skos:definition "A constraint of the compared policy on the operand the report is about."@en ;
    rdfs:domain vrep:OperandVerdictReport .

vrep:binding a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "binding"@en ;
    skos:definition "The binding that fixed the reading: which source supplies the concepts, at which sort, read how."@en ;
    rdfs:range bind:OperandBinding .

vrep:backgroundTheory a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "background theory"@en ;
    skos:definition "What the parties declared beyond the resource. Every report names one, the empty theory included, so a reader sees what the verdict rests on."@en ;
    rdfs:domain vrep:OperandVerdictReport ;
    rdfs:range bt:BackgroundTheory .

vrep:compatibilityState a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "compatibility state"@en ;
    skos:definition "The verdict."@en ;
    rdfs:domain vrep:OperandVerdictReport ;
    rdfs:range vrep:CompatibilityState .

vrep:unknownReason a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "unknown reason"@en ;
    skos:definition "Why the verdict is vrep:Unknown. Present exactly when it is."@en ;
    rdfs:comment "That a report carries a reason exactly when its state is Unknown is a conditional cardinality OWL does not express. The generator refuses to write an Unknown report without one."@en ;
    rdfs:domain vrep:OperandVerdictReport ;
    rdfs:range vrep:UnknownReason .

vrep:ungroundedValue a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "ungrounded value"@en ;
    skos:definition "A value, as the policy writes it, that names no concept of the bound resource."@en ;
    rdfs:domain vrep:OperandVerdictReport .

vrep:certificate a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "certificate"@en ;
    skos:definition "The evidence for a definite verdict, checkable without trusting the procedure: a refutation naming the resource, background and axiom premises it uses."@en ;
    rdfs:comment "Referenced, not reified. An Unknown verdict has no refutation to point at."@en ;
    rdfs:domain vrep:OperandVerdictReport .

vrep:readAgainst a rdf:Property, owl:SymmetricProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "read against"@en ;
    skos:definition "Another case this one should be read with, because the two differ in one thing: the binding, the background theory, or one value."@en ;
    rdfs:domain vrep:OperandVerdictReport ;
    rdfs:range vrep:OperandVerdictReport .

# ----- properties of a well-sortedness report -----

vrep:constraint a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "constraint"@en ;
    skos:definition "The constraint checked."@en ;
    rdfs:domain vrep:WellSortednessReport .

vrep:wellSorted a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "well sorted"@en ;
    skos:definition "True when the operator is defined at the binding's sort and the right operand has the arity the operator takes. When false, rdfs:comment gives the reason."@en ;
    rdfs:domain vrep:WellSortednessReport ;
    rdfs:range xsd:boolean .
