@prefix vrep:    <https://w3id.org/odrl-kb/verdict-report#> .
@prefix bind:    <https://w3id.org/odrl-kb/binding#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/odrl-kb/verdict-report> a owl:Ontology ;
    dcterms:title "Verdict report"@en ;
    vann:preferredNamespacePrefix "vrep" ;
    vann:preferredNamespaceUri "https://w3id.org/odrl-kb/verdict-report#" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:description "Reports the result of comparing two ODRL policies before any use: whether their constraints on one left operand can be satisfied together. The comparison involves no request and no actual use, so this vocabulary does not extend a compliance report model, which records the evaluation of a policy against a request."@en .

# ----- reports -----

vrep:Report a rdfs:Class ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Report"@en ;
    skos:definition "A report on the constraints of ODRL policies, relative to a binding. A verdict on two policies, an input check on one constraint, or a consistency check of the statements in force."@en .

vrep:OperandVerdictReport a rdfs:Class ;
    rdfs:subClassOf vrep:Report ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Operand Verdict Report"@en ;
    skos:definition "The verdict for the constraints two policies place on one left operand, relative to a binding and the declarations in force: Compatible when, whatever the vocabulary leaves open, some use meets both policies; Incompatible when, whatever the vocabulary leaves open, no use meets both policies; and Unknown when it depends on something the vocabulary leaves open."@en ;
    rdfs:comment "Only well-sorted constraints whose values all name a concept receive a verdict. Any other constraint is reported by an input check report."@en .

vrep:InputCheckReport a rdfs:Class ;
    rdfs:subClassOf vrep:Report ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Input Check Report"@en ;
    skos:definition "Whether one constraint can be read under its binding at all. Decided before any prover is called."@en ;
    rdfs:comment "A constraint that fails an input check is rejected. It has no verdict, rather than a negative or an Unknown one."@en .

vrep:WellSortednessReport a rdfs:Class ;
    rdfs:subClassOf vrep:InputCheckReport ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Well-Sortedness Report"@en ;
    skos:definition "Whether one constraint can be evaluated at all under the sort its left operand is bound at: whether the operator is defined at that sort and the right operand has the arity the operator takes."@en ;
    rdfs:comment "Decided by the signature alone. No resource is opened."@en .

vrep:GroundingReport a rdfs:Class ;
    rdfs:subClassOf vrep:InputCheckReport ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Grounding Report"@en ;
    skos:definition "Whether every right-operand value of one well-sorted constraint names a concept of the bound resource under the binding's grounding rule."@en ;
    rdfs:comment "Decided by applying the grounding rule to each value. A value that names no concept is repaired by correcting the policy or the binding, not by a declaration of the parties."@en .

vrep:ConsistencyReport a rdfs:Class ;
    rdfs:subClassOf vrep:Report ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Consistency Report"@en ;
    skos:definition "Whether the statements of the resource and the declarations in force have a model. Checked after the input checks and before the verdict. When they have none, no verdict is given."@en .

# ----- the three verdicts -----

vrep:CompatibilityState a rdfs:Class ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Compatibility State"@en ;
    skos:definition "The verdict of an operand verdict report. Exactly one of vrep:Compatible, vrep:Incompatible and vrep:Unknown."@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( vrep:Compatible vrep:Incompatible vrep:Unknown ) ] .

vrep:Compatible a vrep:CompatibilityState ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Compatible"@en ;
    skos:definition "Whatever the vocabulary leaves open, some use meets both policies. Certified by a proof that no reading of the resource and the declarations leaves the two policies without a common use."@en .

vrep:Incompatible a vrep:CompatibilityState ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Incompatible"@en ;
    skos:definition "Whatever the vocabulary leaves open, no use meets both policies. Certified by a proof that no reading admits a common use."@en .

vrep:Unknown a vrep:CompatibilityState ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "Unknown"@en ;
    skos:definition "It depends on something the vocabulary leaves open. The comment names it."@en ;
    rdfs:comment "A further declaration, or a further statement of the resource, can make the verdict definite."@en .

vrep:Compatible owl:differentFrom vrep:Incompatible, vrep:Unknown .
vrep:Incompatible owl:differentFrom vrep:Unknown .

# ----- properties of an operand verdict report -----

vrep:referencePolicy a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "reference policy"@en ;
    skos:definition "The first of the two policies compared."@en ;
    rdfs:comment "The verdict is symmetric. Reference and compared only fix the order in which the report names the policies."@en ;
    rdfs:domain vrep:OperandVerdictReport ;
    rdfs:range odrl:Policy .

vrep:comparedPolicy a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "compared policy"@en ;
    skos:definition "The second of the two policies compared."@en ;
    rdfs:domain vrep:OperandVerdictReport ;
    rdfs:range odrl:Policy .

vrep:referenceConstraint a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "reference constraint"@en ;
    skos:definition "A constraint of the policy on the operand the report is about: an atomic constraint, or a logical constraint (and, or, xone) as written, so its grouping is kept. Several constraints on one rule hold together, as in ODRL."@en ;
    rdfs:domain vrep:OperandVerdictReport .

vrep:comparedConstraint a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "compared constraint"@en ;
    skos:definition "A constraint of the policy on the operand the report is about: an atomic constraint, or a logical constraint (and, or, xone) as written, so its grouping is kept. Several constraints on one rule hold together, as in ODRL."@en ;
    rdfs:domain vrep:OperandVerdictReport .

vrep:binding a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "binding"@en ;
    skos:definition "The binding that fixed the reading: which source supplies the concepts, at which sort, read how."@en ;
    rdfs:domain vrep:Report ;
    rdfs:range bind:OperandBinding .

vrep:declarations a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "declarations"@en ;
    skos:definition "What is declared beyond the resource. Every verdict report names one set, the empty declarations included."@en ;
    rdfs:domain vrep:OperandVerdictReport ;
    rdfs:range bind:Declarations .

vrep:compatibilityState a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "compatibility state"@en ;
    skos:definition "The verdict."@en ;
    rdfs:domain vrep:OperandVerdictReport ;
    rdfs:range vrep:CompatibilityState .


vrep:profileNote a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "profile note"@en ;
    skos:definition "A remark about how a policy sits with the DPV-ODRL usage note of its operand, for example that it uses an operator the note does not list. It is no part of why the verdict holds, so it is kept apart from the comment."@en ;
    rdfs:domain vrep:OperandVerdictReport .

vrep:certificate a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "certificate"@en ;
    skos:definition "The proof behind a definite verdict, with the statements it uses: from the resource, from the declarations, or from the order axioms."@en ;
    rdfs:comment "Referenced, not reified. An Unknown verdict has no proof to point at."@en ;
    rdfs:domain vrep:OperandVerdictReport .

vrep:readAgainst a rdf:Property, owl:SymmetricProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "read against"@en ;
    skos:definition "Another case this one should be read with, because the two differ in one thing: the binding, the declarations, or one value."@en ;
    rdfs:domain vrep:Report ;
    rdfs:range vrep:Report .

vrep:consistent a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "consistent"@en ;
    skos:definition "True when the statements of the resource and the declarations in force have a model."@en ;
    rdfs:domain vrep:ConsistencyReport ;
    rdfs:range xsd:boolean .

# ----- properties of an input check report -----

vrep:constraint a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "constraint"@en ;
    skos:definition "The constraint checked."@en ;
    rdfs:domain vrep:InputCheckReport .

vrep:wellSorted a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "well sorted"@en ;
    skos:definition "True when the operator is defined at the binding's sort and the right operand has the arity the operator takes. When false, rdfs:comment gives the reason."@en ;
    rdfs:domain vrep:WellSortednessReport ;
    rdfs:range xsd:boolean .

vrep:grounded a rdf:Property, owl:FunctionalProperty ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "grounded"@en ;
    skos:definition "True when every right-operand value of the constraint names a concept of the bound resource under the binding's grounding rule. When false, vrep:ungroundedValue gives each value that does not."@en ;
    rdfs:domain vrep:GroundingReport ;
    rdfs:range xsd:boolean .

vrep:ungroundedValue a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/verdict-report> ;
    rdfs:label "ungrounded value"@en ;
    skos:definition "A value, as the policy writes it, that names no concept of the bound resource."@en ;
    rdfs:domain vrep:GroundingReport .
