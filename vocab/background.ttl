# Background theory vocabulary
# Not a new vocabulary; a definition of one already in use in every
# *-uniqueness.ttl and *-definitional.ttl.
@prefix bt:      <https://w3id.org/odrl-kb/background#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/odrl-kb/background> a owl:Ontology ;
    dcterms:title "Background theory vocabulary"@en ;
    vann:preferredNamespacePrefix "bt" ;
    vann:preferredNamespaceUri "https://w3id.org/odrl-kb/background#" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:description "A background theory is a set of assertions the parties declare and may withdraw, distinct from what a resource publishes. Withdrawing one reopens any definite verdict that rested on it."@en .

bt:BackgroundTheory a rdfs:Class, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/background> ;
    rdfs:label "Background Theory" ;
    skos:definition "A declared, withdrawable set of assertions in force for a binding. Its warrant is its dcterms:source; its assertions are attached by bt:asserts, which is the unit of withdrawal."@en .

bt:GenerationRule a rdfs:Class, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/background> ;
    rdfs:label "Generation Rule" ;
    skos:definition "A rule by which a generator expands a theory's compact statement into ground assertions."@en .

bt:PairwiseDistinctness a bt:GenerationRule ;
    rdfs:label "Pairwise Distinctness" ;
    skos:definition "Names the rule by which the generator expands an owl:AllDifferent member list of n concepts into n(n-1)/2 ground inequations, subject to the theory's scope condition. The expansion is performed and verified by the generator; this individual records which rule was applied."@en .

bt:appliesTo a rdfs:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/background> ;
    rdfs:label "applies to" ;
    skos:definition "The concept scheme over whose concepts the theory speaks."@en ;
    rdfs:domain bt:BackgroundTheory ;
    rdfs:range skos:ConceptScheme .

bt:generatedBy a rdfs:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/background> ;
    rdfs:label "generated by" ;
    skos:definition "The rule the generator applies to expand this theory."@en ;
    rdfs:domain bt:BackgroundTheory ;
    rdfs:range bt:GenerationRule .

bt:scopeCondition a rdfs:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/background> ;
    rdfs:label "scope condition" ;
    skos:definition "The condition every member must satisfy for the rule to apply, checked by the generator before expansion and failing loudly otherwise."@en ;
    rdfs:domain bt:BackgroundTheory .

bt:asserts a rdfs:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/background> ;
    rdfs:label "asserts" ;
    skos:definition "Attaches the theory's assertion, such as an owl:AllDifferent, to the theory node. What bt:asserts links is what withdrawal removes."@en ;
    rdfs:domain bt:BackgroundTheory .

bt:pairCount a rdfs:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/background> ;
    rdfs:label "pair count" ;
    skos:definition "The expected number of generated ground assertions; the generator verifies its expansion against this."@en ;
    rdfs:domain bt:BackgroundTheory ;
    rdfs:range xsd:integer .

bt:memberSourceFileDate a rdfs:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/background> ;
    rdfs:label "member source file date" ;
    skos:definition "The version stamp of the source snapshot from which the member list was taken, such as a registry File-Date."@en ;
    rdfs:domain bt:BackgroundTheory ;
    rdfs:range xsd:date .
