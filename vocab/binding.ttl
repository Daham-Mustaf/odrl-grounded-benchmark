@prefix bind:    <https://w3id.org/odrl-kb/binding#> .
@prefix odrl:    <http://www.w3.org/ns/odrl/2/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/odrl-kb/binding> a owl:Ontology ;
    dcterms:title "Operand binding vocabulary"@en ;
    vann:preferredNamespacePrefix "bind" ;
    vann:preferredNamespaceUri "https://w3id.org/odrl-kb/binding#" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:description "A binding pairs an ODRL left operand with an external resource and declares the sort at which its published statements are read. The sort is a property of the binding, not of the operand or of the resource."@en .


# --- classes ----------------------------------------------------------

bind:OperandBinding a rdfs:Class, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "Operand Binding" ;
    skos:definition "A profile's pairing of a left operand with a resource, declaring the sort and the grounding rule. Declaring the sort is the one judgment a profile makes about an operand. What the parties declare beyond the resource is not part of the binding: each verdict report names it with vrep:declarations."@en .

bind:Sort a rdfs:Class, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "Sort" ;
    skos:definition "The declared reading of the bound resource's published statements. Three individuals exist and no others; the enumeration below makes that a theorem of this file rather than a hope of its prose."@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( bind:tax bind:mer bind:nom ) ] .

bind:GroundingProcedure a rdfs:Class, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "Grounding Procedure" ;
    skos:definition "A declared rule mapping a right-operand value to a concept of the bound resource. Partial by nature: a value the rule does not resolve is ungrounded, and its constraint is rejected before any verdict is computed. Which rule a profile adopts is a decision about reading, and two profiles over one resource may adopt different ones."@en .


# --- the three sorts --------------------------------------------------

bind:tax a bind:Sort ;
    rdfs:label "taxonomy" ;
    skos:definition "The published statements are read as subsumption."@en .

bind:mer a bind:Sort ;
    rdfs:label "meriology" ;
    skos:definition "The published statements are read as parthood."@en .

bind:nom a bind:Sort ;
    rdfs:label "nominal" ;
    skos:definition "The resource supplies a set of concepts and nothing further; identity is the only relation available."@en .

[] a owl:AllDifferent ;
    owl:members ( bind:tax bind:mer bind:nom ) .


# --- properties -------------------------------------------------------

bind:leftOperand a rdf:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "left operand" ;
    rdfs:seeAlso odrl:leftOperand ;
    skos:definition "The ODRL left operand this binding covers."@en ;
    rdfs:domain bind:OperandBinding ;
    rdfs:range odrl:LeftOperand .

bind:sort a rdf:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "sort" ;
    skos:definition "The declared sort of the binding."@en ;
    rdfs:domain bind:OperandBinding ;
    rdfs:range bind:Sort .

bind:resource a rdf:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "resource" ;
    skos:definition "The external resource whose published statements the binding reads: a versioned slice of a published vocabulary, with its provenance recorded."@en ;
    rdfs:domain bind:OperandBinding .


bind:grounding a rdf:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "grounding" ;
    skos:definition "The rule this binding adopts for mapping right-operand values to concepts of the resource."@en ;
    rdfs:domain bind:OperandBinding ;
    rdfs:range bind:GroundingProcedure .

bind:sliceMembership a bind:GroundingProcedure ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "Slice membership" ;
    skos:definition """A right-operand value resolves when it names a concept of the
         bound slice, by IRI identity. Nothing else resolves: no
         normalisation, no reduction, no matching against a label. The
         authority chose the IRIs, and two different IRIs are two
         different concepts unless it says otherwise.

         The default rule, adopted by every binding over a resource
         published as a graph. A registry needs a different one, because
         its concepts are not its entries."""@en .

bind:acceptsIRI a bind:GroundingProcedure ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "accepts IRI" ;
    skos:definition "A value that is an IRI names the concept with that IRI, if the resource has one; a value that is not an IRI does not ground."@en .

bind:matchesProperty a bind:GroundingProcedure ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "matches property" ;
    skos:definition "A literal value names the concept carrying that value on a designated property of the resource, if exactly one does."@en .

bind:reducesToPrimarySubtag a bind:GroundingProcedure ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "reduces to primary subtag" ;
    skos:definition "A well-formed language tag names the concept for its primary subtag; en-US names en. Distinguishes this reading from one under which en-US names nothing."@en .


# --- declarations -----------------------------------------------------
#
# What the parties declare beyond the resource.  A verdict report names the
# set it was computed under with vrep:declarations.

bind:Declarations a rdfs:Class, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "Declarations" ;
    skos:definition "A declared, withdrawable set of statements in force for a binding, over and above what the resource publishes. Its warrant is its dcterms:source and its origin is recorded with bind:origin. The statements are the unit of withdrawal: withdrawing one reopens any definite verdict that rested on it. A set with no statements is the empty declarations of a resource, and has no origin."@en .

bind:Origin a rdfs:Class, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "Origin" ;
    skos:definition "Where the statements of a set of declarations come from. Two individuals exist and no others."@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( bind:practiceRule bind:proseDefinition ) ] .

bind:practiceRule a bind:Origin ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "practice rule" ;
    skos:definition "A rule of the resource's practice. The authority follows it when it issues or maintains entries, and the resource's RDF does not state it. Example: the BCP 47 distinctness rule, by which distinct primary language subtag records name distinct languages."@en .

bind:proseDefinition a bind:Origin ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "prose definition" ;
    skos:definition "A prose definition the resource's RDF does not state. The authority's text says it, for instance in a skos:definition, and its triples carry no matching statement."@en .

bind:GenerationRule a rdfs:Class, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "Generation Rule" ;
    skos:definition "A rule by which a generator expands a compact set of declarations into ground statements."@en .

bind:PairwiseDistinctness a bind:GenerationRule ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "Pairwise Distinctness" ;
    skos:definition "Names the rule by which two concepts of a stated set are treated as distinct, subject to the stated scope condition. For a list of n concepts the generator expands an owl:AllDifferent member list into n(n-1)/2 ground inequations. For a registry rule over a large set, such as the ISO 3166 areas, the rule is stated in the axiom file and each problem instantiates the pairs it names. The expansion is performed and verified by the generator; this individual records which rule was applied. Where the statements come from is recorded separately, with bind:origin."@en .

bind:PairwiseDisjointness a bind:GenerationRule ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "Pairwise Disjointness" ;
    skos:definition "Names the rule by which each pair of concepts stated with bind:disjointFrom is treated as having nothing below both in the binding's order. The generator writes one ground statement for each pair. Where the statements come from is recorded separately, with bind:origin."@en .

bind:PublishedDefinition a bind:GenerationRule ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "Published Definition" ;
    skos:definition "Names a statement taken from a definition the authority publishes in prose. The quoted definitions are attached with bind:warrant."@en .

bind:origin a rdf:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "origin" ;
    skos:definition "Where the statements of this set of declarations come from. Every set with at least one statement has exactly one origin. The empty set has none."@en ;
    rdfs:domain bind:Declarations ;
    rdfs:range bind:Origin .

bind:appliesTo a rdf:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "applies to" ;
    skos:definition "The resource over whose concepts or statements the declarations speak."@en ;
    rdfs:domain bind:Declarations .

bind:generatedBy a rdf:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "generated by" ;
    skos:definition "The rule the generator applies to expand these declarations."@en ;
    rdfs:domain bind:Declarations ;
    rdfs:range bind:GenerationRule .

bind:scopeCondition a rdf:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "scope condition" ;
    skos:definition "The condition every member must satisfy for the rule to apply, checked by the generator before expansion and failing loudly otherwise."@en ;
    rdfs:domain bind:Declarations .

bind:states a rdf:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "states" ;
    skos:definition "Attaches the declarations' statement of distinctness, an owl:AllDifferent whose owl:members are the concepts, to the declarations node. A list of two is one pair. What bind:states links is what withdrawal removes. Disjointness is stated by bind:disjointFrom triples in the same file, and a file holds one set."@en ;
    rdfs:domain bind:Declarations .

bind:pairCount a rdf:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "pair count" ;
    skos:definition "The expected number of generated ground statements; the generator verifies its expansion against this. Zero for the empty declarations."@en ;
    rdfs:domain bind:Declarations ;
    rdfs:range xsd:integer .

bind:memberSourceFileDate a rdf:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "member source file date" ;
    skos:definition "The version stamp of the source snapshot from which the member list was taken, such as a registry File-Date."@en ;
    rdfs:domain bind:Declarations ;
    rdfs:range xsd:date .

bind:warrant a rdf:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "warrant" ;
    skos:definition "A quotation from the authority's text that warrants the statements. Each warrant names its concept with bind:concept and quotes the definition with skos:definition."@en ;
    rdfs:domain bind:Declarations .

bind:concept a rdf:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "concept" ;
    skos:definition "The concept whose published definition a bind:warrant quotes."@en .

bind:disjointFrom a rdf:Property, skos:Concept ;
    rdfs:isDefinedBy <https://w3id.org/odrl-kb/binding> ;
    rdfs:label "disjoint from" ;
    skos:definition "The declarations state that nothing lies below both concepts in the binding's order. Not owl:disjointWith, which is class semantics, and not a spatial predicate: France and Germany touch, and nothing lies within both."@en .
