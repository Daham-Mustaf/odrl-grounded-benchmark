% SZS output start Proof for KGC314-1
fof(f19,axiom,(
  dpv_marketing != dpv_scientific_research),
  file('problems/verdict/KGC314-1.p',bt_dpv_marketing_distinct_dpv_scientific_research)).
fof(f20,axiom,(
  (dpv_marketing = dpv_marketing & dpv_marketing = dpv_scientific_research) | (dpv_scientific_research = dpv_marketing & dpv_scientific_research = dpv_scientific_research)),
  file('problems/verdict/KGC314-1.p',w_kgc314)).
fof(f43,plain,(
  dpv_marketing != dpv_scientific_research),
  inference(cnf_transformation,[],[f19])).
fof(f45,plain,(
  dpv_marketing = dpv_scientific_research | dpv_marketing = dpv_scientific_research),
  inference(cnf_transformation,[],[f20])).
fof(f48,plain,(
  dpv_marketing = dpv_scientific_research),
  inference(duplicate_literal_removal,[],[f45])).
fof(f49,plain,(
  $false),
  inference(forward_subsumption_resolution,[],[f43,f48])).
