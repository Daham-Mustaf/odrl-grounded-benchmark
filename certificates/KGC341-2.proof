  (dpv_consent_given != dpv_consent_given | dpv_consent_given != dpv_renewed_consent_given) & (dpv_consent_given != dpv_renewed_consent_given | dpv_renewed_consent_given != dpv_renewed_consent_given) & (dpv_consent_given != dpv_renewed_consent_given | dpv_consent_given != dpv_renewed_consent_given) & (dpv_renewed_consent_given != dpv_renewed_consent_given | dpv_renewed_consent_given != dpv_renewed_consent_given)),
  inference(ennf_transformation,[],[f16])).
fof(f37,plain,(
  dpv_renewed_consent_given != dpv_renewed_consent_given | dpv_renewed_consent_given != dpv_renewed_consent_given),
  inference(cnf_transformation,[],[f21])).
fof(f41,plain,(
  dpv_renewed_consent_given != dpv_renewed_consent_given),
  inference(duplicate_literal_removal,[],[f37])).
fof(f42,plain,(
