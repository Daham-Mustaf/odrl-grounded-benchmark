% SZS output start Proof for KGC341-2
fof(f16,axiom,(
  ~((dpv_consent_given = dpv_consent_given & dpv_consent_given = dpv_renewed_consent_given) | (dpv_renewed_consent_given = dpv_consent_given & dpv_renewed_consent_given = dpv_renewed_consent_given) | (dpv_consent_given = dpv_renewed_consent_given & dpv_consent_given = dpv_renewed_consent_given) | (dpv_renewed_consent_given = dpv_renewed_consent_given & dpv_renewed_consent_given = dpv_renewed_consent_given))),
  file('problems/verdict/KGC341-2.p',w_kgc341)).
