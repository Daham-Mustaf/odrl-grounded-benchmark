% DPV consent status: the order the module publishes.
%
% Thirteen states under two mid-level concepts.  The typing the
% module also carries is not here: it relates an individual to a
% class, and this resource relates concepts to concepts.
%
% Dropped at the module boundary:
%   ConsentStatus below Status
%
% Order assertions : 12
% Source           : https://w3id.org/dpv/2.3

fof(res_dpv_consent_expired_below_dpv_consent_status_invalid_for_processing, axiom,
    kge_leq(dpv_consent_expired, dpv_consent_status_invalid_for_processing)).

fof(res_dpv_consent_given_below_dpv_consent_status_valid_for_processing, axiom,
    kge_leq(dpv_consent_given, dpv_consent_status_valid_for_processing)).

fof(res_dpv_consent_invalidated_below_dpv_consent_status_invalid_for_processing, axiom,
    kge_leq(dpv_consent_invalidated, dpv_consent_status_invalid_for_processing)).

fof(res_dpv_consent_refused_below_dpv_consent_status_invalid_for_processing, axiom,
    kge_leq(dpv_consent_refused, dpv_consent_status_invalid_for_processing)).

fof(res_dpv_consent_request_deferred_below_dpv_consent_status_invalid_for_processing, axiom,
    kge_leq(dpv_consent_request_deferred, dpv_consent_status_invalid_for_processing)).

fof(res_dpv_consent_requested_below_dpv_consent_status_invalid_for_processing, axiom,
    kge_leq(dpv_consent_requested, dpv_consent_status_invalid_for_processing)).

fof(res_dpv_consent_revoked_below_dpv_consent_status_invalid_for_processing, axiom,
    kge_leq(dpv_consent_revoked, dpv_consent_status_invalid_for_processing)).

fof(res_dpv_consent_status_invalid_for_processing_below_dpv_consent_status, axiom,
    kge_leq(dpv_consent_status_invalid_for_processing, dpv_consent_status)).

fof(res_dpv_consent_status_valid_for_processing_below_dpv_consent_status, axiom,
    kge_leq(dpv_consent_status_valid_for_processing, dpv_consent_status)).

fof(res_dpv_consent_unknown_below_dpv_consent_status_invalid_for_processing, axiom,
    kge_leq(dpv_consent_unknown, dpv_consent_status_invalid_for_processing)).

fof(res_dpv_consent_withdrawn_below_dpv_consent_status_invalid_for_processing, axiom,
    kge_leq(dpv_consent_withdrawn, dpv_consent_status_invalid_for_processing)).

fof(res_dpv_renewed_consent_given_below_dpv_consent_status_valid_for_processing, axiom,
    kge_leq(dpv_renewed_consent_given, dpv_consent_status_valid_for_processing)).
