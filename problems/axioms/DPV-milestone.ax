% Resource: subsumption as published by DPV.  res_ names mark
% what the vocabulary asserts.

fof(res_dpv_commercial_purpose_below_dpv_purpose, axiom,
    kge_leq(dpv_commercial_purpose, dpv_purpose)).
fof(res_dpv_commercial_research_below_dpv_commercial_purpose, axiom,
    kge_leq(dpv_commercial_research, dpv_commercial_purpose)).
fof(res_dpv_commercial_research_below_dpv_research_and_development, axiom,
    kge_leq(dpv_commercial_research, dpv_research_and_development)).
fof(res_dpv_marketing_below_dpv_purpose, axiom,
    kge_leq(dpv_marketing, dpv_purpose)).
fof(res_dpv_non_commercial_purpose_below_dpv_purpose, axiom,
    kge_leq(dpv_non_commercial_purpose, dpv_purpose)).
fof(res_dpv_non_commercial_research_below_dpv_non_commercial_purpose, axiom,
    kge_leq(dpv_non_commercial_research, dpv_non_commercial_purpose)).
fof(res_dpv_non_commercial_research_below_dpv_research_and_development, axiom,
    kge_leq(dpv_non_commercial_research, dpv_research_and_development)).
fof(res_dpv_research_and_development_below_dpv_purpose, axiom,
    kge_leq(dpv_research_and_development, dpv_purpose)).
fof(res_dpv_scientific_research_below_dpv_research_and_development, axiom,
    kge_leq(dpv_scientific_research, dpv_research_and_development)).

% Background theory: empty.  DPV publishes no disjointness
% among purposes, and the parties declare none here.

