# Declarations for the GeoNames slice: France and Germany declared
# distinct.
#
# GeoNames publishes no distinctness.  The parties declare that the two
# country features name different countries.  This settles identity
# questions (KGC304, KGC307) but not containment: two distinct areas can
# still lie one within the other (KGC305).

@prefix bind:    <https://w3id.org/odrl-kb/binding#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/odrl-kb/geonames-europe/declared> a bind:Declarations ;
    dcterms:title "France and Germany declared distinct"@en ;
    bind:generatedBy bind:PartyDeclaration ;
    bind:origin bind:practiceRule ;
    rdfs:comment "The origin rests on the GeoNames administrative hierarchy."@en ;
    bind:appliesTo <https://w3id.org/odrl-kb/geonames-europe> ;
    bind:pairCount 1 .
