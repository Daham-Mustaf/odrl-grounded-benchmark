# Declarations for the GeoNames slice: France and Germany declared
# disjoint.
#
# GeoNames publishes no disjointness.  The parties declare that nothing
# lies within both countries.  Disjointness implies distinctness, and it
# also settles containment: France lies within itself, so it cannot lie
# within Germany (KGC306).

@prefix bind:    <https://w3id.org/odrl-kb/binding#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/odrl-kb/geonames-europe/siblings> a bind:Declarations ;
    dcterms:title "France and Germany declared disjoint"@en ;
    bind:generatedBy bind:PartyDeclaration ;
    bind:origin bind:practiceRule ;
    rdfs:comment "The origin rests on the GeoNames administrative hierarchy."@en ;
    bind:appliesTo <https://w3id.org/odrl-kb/geonames-europe> ;
    bind:pairCount 1 .
