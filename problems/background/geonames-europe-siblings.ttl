# Declarations for the GeoNames slice: features with the same parent declared
# disjoint.
#
# GeoNames publishes no disjointness.  Every pair of features that share a
# parent in the administrative hierarchy is declared disjoint: nothing lies
# within both.  Disjointness implies distinctness, and it also settles
# containment: France lies within itself, so it cannot lie within Germany
# (KGC309).
#
# Pairs: 19, among the 2 children of Europe, the 6 of France and the 3 of
# Germany.  The other parents have one child each.

@prefix bind:    <https://w3id.org/odrl-kb/binding#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/odrl-kb/geonames-europe/siblings> a bind:Declarations ;
    dcterms:title "Features with the same parent declared disjoint"@en ;
    bind:generatedBy bind:PairwiseDisjointness ;
    bind:origin bind:practiceRule ;
    rdfs:comment "A modelling choice, not a GeoNames statement: places that GeoNames puts directly under one parent, countries under a continent or regions under a country, do not overlap, so features with the same parent are taken to be disjoint."@en ;
    bind:scopeCondition "Disjointness between features with the same parent, and not between a feature and its ancestors or descendants."@en ;
    bind:appliesTo <https://w3id.org/odrl-kb/geonames-europe> ;
    bind:pairCount 19 .

# Children of Europe
<https://sws.geonames.org/3017382/> bind:disjointFrom <https://sws.geonames.org/2921044/> .

# Children of France
<https://sws.geonames.org/3012874/> bind:disjointFrom <https://sws.geonames.org/11071622/> .
