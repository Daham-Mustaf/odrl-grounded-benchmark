# Declarations for the legal-basis resource: declared distinctness.
#
# The parties declare that no two of the listed names denote one legal
# basis. Neither module asserts this, so the rule is the parties' and a
# verdict resting on an instance of it is withdrawable.
#
# Whether it is right is a question of law. Article 6(1) lists its bases
# without saying that a controller may rely on only one, and a party who
# reads the Article as permitting a basis to coincide with another can
# withdraw the declaration.
#
# Distinctness only, not disjointness: the extension places a concept
# below two others in several places, and a disjointness over such a
# pair would contradict the resource.
#
# Concepts: 33
# Pairs   : 528
# Source  : https://w3id.org/dpv/2.3

@prefix bind:    <https://w3id.org/odrl-kb/binding#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/odrl-kb/dpv-gdpr-legal-basis/declared>
        a bind:Declarations ;
    dcterms:title "Pairwise distinctness of legal bases"@en ;
    bind:appliesTo <https://w3id.org/odrl-kb/dpv-gdpr-legal-basis> ;
    bind:generatedBy bind:PairwiseDistinctness ;
    bind:origin bind:proseDefinition ;
    rdfs:comment "The origin rests on GDPR Article 6(1), points (a) to (f)."@en ;
    bind:scopeCondition "Distinctness between the listed bases, and not disjointness: the extension publishes concepts below two parents."@en ;
    bind:pairCount 528 ;
    bind:states [
        a owl:AllDifferent ;
        owl:members (
            <https://w3id.org/dpv#Consent>
            <https://w3id.org/dpv#Contract>
            <https://w3id.org/dpv#ContractPerformance>
            <https://w3id.org/dpv#DataTransferLegalBasis>
            <https://w3id.org/dpv#EnterIntoContract>
            <https://w3id.org/dpv#LegalBasis>
            <https://w3id.org/dpv#LegalObligation>
            <https://w3id.org/dpv#LegitimateInterest>
            <https://w3id.org/dpv#LegitimateInterestOfController>
            <https://w3id.org/dpv#LegitimateInterestOfDataSubject>
            <https://w3id.org/dpv#LegitimateInterestOfThirdParty>
            <https://w3id.org/dpv#OfficialAuthorityOfController>
            <https://w3id.org/dpv#PublicInterest>
            <https://w3id.org/dpv#VitalInterest>
            <https://w3id.org/dpv#VitalInterestOfDataSubject>
            <https://w3id.org/dpv#VitalInterestOfNaturalPerson>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-a>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-a-explicit-consent>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-a-non-explicit-consent>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-b>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-b-contract-performance>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-b-enter-into-contract>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-c>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-d>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-d-data-subject>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-d-natural-person>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-e>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-e-official-authority>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-e-public-interest>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-f>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-f-controller>
            <https://w3id.org/dpv/legal/eu/gdpr#A6-1-f-third-party>
            <https://w3id.org/dpv/legal/eu/gdpr#Consent>
        )
    ] .
