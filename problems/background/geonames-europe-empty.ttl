# Background theory for the 15-feature GeoNames slice: empty.
#
# GeoNames asserts no disjointness between sibling features, and the parties
# declare none here.  Two constraints naming different regions are therefore
# satisfiable together unless a party declares them apart.

@prefix bt:      <https://w3id.org/odrl-kb/background#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/odrl-kb/geonames-europe/empty> a bt:BackgroundTheory ;
    dcterms:title "No declared disjointness"@en ;
    bt:appliesTo <https://w3id.org/odrl-kb/geonames-europe> ;
    bt:pairCount 0 .
