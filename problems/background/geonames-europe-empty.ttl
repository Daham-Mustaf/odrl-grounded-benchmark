# Declarations for the 15-feature GeoNames slice: empty.
#
# This set states nothing; only the resource's statements apply.  GeoNames
# asserts no disjointness between sibling features, so two constraints naming
# different regions are satisfiable together unless a declaration separates
# them.

@prefix bind:    <https://w3id.org/odrl-kb/binding#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://w3id.org/odrl-kb/geonames-europe/empty> a bind:Declarations ;
    dcterms:title "No declared disjointness"@en ;
    bind:appliesTo <https://w3id.org/odrl-kb/geonames-europe> ;
    bind:pairCount 0 .
