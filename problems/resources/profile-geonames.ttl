# Profile entry for odrl:spatial over the 15-feature GeoNames slice in
# geonames.ttl, used by the running example (KGC302), the cases on
# exactly one of two countries (KGC303 to KGC306) and the
# well-sortedness cases KGC100 and KGC110.
#
# The sort is mer: gn:parentFeature is read as parthood.  GeoNames publishes
# no sibling disjointness, and this binding adds none.

@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix bind: <https://w3id.org/odrl-kb/binding#> .
@prefix ex:   <https://w3id.org/odrl-kb/profile/> .

ex:b-spatial-geonames a bind:OperandBinding ;
    bind:leftOperand odrl:spatial ;
    bind:sort bind:mer ;
    bind:resource <https://w3id.org/odrl-kb/geonames-europe> ;
    bind:grounding bind:sliceMembership .
