# BCP 47 primary language subtags, fifteen-subtag slice
# Resource file.  A resource is a set of order assertions; at the nominal
# sort that set is empty, so this file publishes the concept set and
# nothing over it.
#
# The slice holds fifteen ISO 639-1 two-letter primary subtags from the
# IANA Language Subtag Registry.  Over this slice the registry publishes
# no relation between concepts.  Registry-wide it does publish relations,
# Preferred-Value equivalences (identity) and Macrolanguage encompassment
# (an order a profile may read at tax); the generator verifies that no
# member of this slice carries either field or a Deprecated field, which
# is also the scope condition of the background theory.

# no Deprecated, no Preferred-Value, no Macrolanguage, no Scope on any of the fifteen.  the distinctness rule holds.


@prefix bcp47:   <https://w3id.org/odrl-kb/bcp47#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/odrl-kb/bcp47> a skos:ConceptScheme ;
    dcterms:title "BCP 47 primary language subtags, fifteen-subtag slice"@en ;
    dcterms:source
        <https://www.iana.org/assignments/language-subtag-registry> ;
    dcterms:conformsTo <https://www.rfc-editor.org/rfc/rfc5646> ;
    dcterms:hasVersion "File-Date GENERATOR_FILE_DATE" ;
    dcterms:issued "GENERATOR_RETRIEVAL_DATE"^^xsd:date ;
    dcterms:identifier "sha256:GENERATOR_SHA256" ;
    dcterms:license <https://www.iana.org/help/licensing-terms> ;
    dcterms:extent "15 concepts, no order assertions" ;
    skos:scopeNote "RFC 5646 section 2.2 reserves Tag for a complete language tag and Subtag for a component; the concepts of this scheme are subtags."@en .

bcp47:bg a skos:Concept ; skos:inScheme <https://w3id.org/odrl-kb/bcp47> ;
    skos:notation "bg" ; skos:prefLabel "Bulgarian"@en .
