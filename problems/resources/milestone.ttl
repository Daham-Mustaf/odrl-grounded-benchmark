# DPV purposes: the subsumption the vocabulary publishes.
#
# skos:broader edges only.  rdf:type dpv:Purpose is a typing
# assertion, not an order assertion, and is not read here.
#
# skos:broader is the only hierarchy predicate here, and SKOS
# declines to fix its logical reading.  That the order is
# subsumption is declared by the profile, not published here.
#
# Source   : w3c/dpv 2.3/dpv/modules/purposes.ttl
# Version  : https://w3id.org/dpv/2.3
# Modified : 2026-02-25
# Retrieved: 2026-08-16
# Licence  : W3C Software and Document License 2023 (verify before redistributing the slice)

@prefix dpv:     <https://w3id.org/dpv#> .
@prefix odrlkb:  <https://w3id.org/odrl-kb/dpv-purposes#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/odrl-kb/dpv-purposes> a dcat:Dataset ;
    dcterms:title "DPV purposes, subsumption slice"@en ;
    dcterms:source <https://w3id.org/dpv/2.3> ;
    dcterms:modified "2026-02-25"^^<http://www.w3.org/2001/XMLSchema#date> ;
    odrlkb:orderPredicate skos:broader ;
    odrlkb:conceptCount 8 ;
    odrlkb:orderAssertionCount 9 .

odrlkb:commercial_purpose a odrlkb:Purpose ;
    rdfs:label "Commercial Purpose"@en ;
    dcterms:identifier dpv:CommercialPurpose ;
    skos:broader odrlkb:purpose .

odrlkb:commercial_research a odrlkb:Purpose ;
    rdfs:label "Commercial Research"@en ;
    dcterms:identifier dpv:CommercialResearch ;
    skos:broader odrlkb:commercial_purpose, odrlkb:research_and_development .

odrlkb:marketing a odrlkb:Purpose ;
    rdfs:label "Marketing"@en ;
    dcterms:identifier dpv:Marketing ;
    skos:broader odrlkb:purpose .

odrlkb:non_commercial_purpose a odrlkb:Purpose ;
    rdfs:label "Non-commercial Purpose"@en ;
    dcterms:identifier dpv:NonCommercialPurpose ;
    skos:broader odrlkb:purpose .

odrlkb:non_commercial_research a odrlkb:Purpose ;
    rdfs:label "Non-Commercial Research"@en ;
    dcterms:identifier dpv:NonCommercialResearch ;
    skos:broader odrlkb:non_commercial_purpose, odrlkb:research_and_development .

odrlkb:purpose a odrlkb:Purpose ;
    rdfs:label "Purpose"@en ;
    dcterms:identifier dpv:Purpose .

odrlkb:research_and_development a odrlkb:Purpose ;
    rdfs:label "Research and Development"@en ;
    dcterms:identifier dpv:ResearchAndDevelopment ;
    skos:broader odrlkb:purpose .

odrlkb:scientific_research a odrlkb:Purpose ;
    rdfs:label "Scientific Research"@en ;
    dcterms:identifier dpv:ScientificResearch ;
    skos:broader odrlkb:research_and_development .
