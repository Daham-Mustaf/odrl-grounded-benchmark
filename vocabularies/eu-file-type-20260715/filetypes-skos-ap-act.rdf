   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/file-type/RDF_THRIFT"
                 at:deprecated="false">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#FileType"/>
      <lemon:context rdf:resource="http://publications.europa.eu/resource/authority/use-context/IMMC"/>
      <lemon:context rdf:resource="http://publications.europa.eu/resource/authority/use-context/ODP"/>
      <euvoc:context rdf:resource="http://publications.europa.eu/resource/authority/use-context/IMMC"/>
      <euvoc:context rdf:resource="http://publications.europa.eu/resource/authority/use-context/ODP"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-01-01</euvoc:startDate>
      <euvoc:status rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT"/>
      <euvoc:xlDefinition rdf:resource="http://publications.europa.eu/resource/authority/file-type/8e938ecee0af72660760185949596111"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/8b950c8f3c198b519b28ab8bb26fcb44"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/291dd3f78d22027e7b33fcf40b60bf8b"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/c6d904a0c0e5ca8f2466398b48afcb36"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-04</dct:created>
      <dct:dateAccepted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-31</dct:dateAccepted>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-05-12</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">RDF Binary Thrift</skos:altLabel>
      <skos:definition xml:lang="en">RDF Binary using Apache Thrift (‘RDF Thrift’) is a binary format for RDF and RDF-related data. Binary formats are faster to process – they do not incur the parsing costs of text-base formats. RDF Thrift defines basic encoding for RDF terms, then builds data formats for RDF graphs, RDF datasets and for SPARQL result sets. This gives a basis for high-performance linked data systems.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.rt</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.trdf</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/rdf+thrift</skos:notation>
      <skos:prefLabel xml:lang="en">RDF Thrift</skos:prefLabel>
      <skos:prefLabel xml:lang="et">RDF Thrift</skos:prefLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos-xl:altLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/01d19a0c223c203e948cd54005f99f24"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/e75ba30c6d3d8a4aeb35b1f9f8f18eef"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/bd39768a7d06cc9af0bea50279e072d0"/>
      <dc:identifier>RDF_THRIFT</dc:identifier>
      <at:op-code>RDF_THRIFT</at:op-code>
      <atold:op-code>RDF_THRIFT</atold:op-code>
      <at:start.use>2014-01-01</at:start.use>
