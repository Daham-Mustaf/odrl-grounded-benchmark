   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/4f9b74a6b09004b00a49a72ff1b4fa4b">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
