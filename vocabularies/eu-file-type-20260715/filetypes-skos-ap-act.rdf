      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:definition xml:lang="en">OpenDocument is a standardized Open Document Format for Office Applications. Charts define how to create graphical displays from numerical data.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/vnd.oasis.opendocument.chart</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.odc</skos:notation>
      <skos:prefLabel xml:lang="en">OpenDocument Chart</skos:prefLabel>
