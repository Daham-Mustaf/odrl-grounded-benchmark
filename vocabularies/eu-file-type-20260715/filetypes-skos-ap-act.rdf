      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/2f463ff9cb718b0cd3d10817e60a3233"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/606f15f6c40b893ba693c5580a73e863"/>
