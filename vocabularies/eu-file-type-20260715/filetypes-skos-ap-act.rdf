   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/67d1082b6b6378662c8b0d8c79c8e3a7">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-06-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-05-12</dct:created>
      <rdf:value xml:lang="en">HTTP – Hypertext Transfer Protocol – is a stateless application-level request/response protocol that uses extensible semantics and self-descriptive message payloads for flexible interaction with network-based hypertext information systems. Message Syntax and Routing is part of the HTTP/1.1 specification.</rdf:value>
      <dct:creator>RFC7230 https://tools.ietf.org/html/rfc7230</dct:creator>
      <euvoc:xlNote xml:lang="en">HTTP – Hypertext Transfer Protocol – is a stateless application-level request/response protocol that uses extensible semantics and self-descriptive message payloads for flexible interaction with network-based hypertext information systems. Message Syntax and Routing is part of the HTTP/1.1 specification.</euvoc:xlNote>
   </euvoc:XlNote>
