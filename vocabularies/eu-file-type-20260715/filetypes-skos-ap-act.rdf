   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/96800026c7832658285dc289f41b2f24">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2013-08-21</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2017-11-16</dct:created>
      <rdf:value xml:lang="en">Esri binary grid is a proprietary binary variation of an Esri grid, a raster GIS file format developed by Esri. It is also known as an ARC/INFO GRID or ARC GRID. It differs from the other Esri grid variation, a non-proprietary ASCII format.</rdf:value>
      <dct:creator>Wikipedia</dct:creator>
      <euvoc:xlNote xml:lang="en">Esri binary grid is a proprietary binary variation of an Esri grid, a raster GIS file format developed by Esri. It is also known as an ARC/INFO GRID or ARC GRID. It differs from the other Esri grid variation, a non-proprietary ASCII format.</euvoc:xlNote>
   </euvoc:XlNote>
