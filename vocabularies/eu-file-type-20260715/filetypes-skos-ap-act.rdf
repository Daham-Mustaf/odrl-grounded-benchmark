   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/15cb6da277c3bd6e54096f7d6cb0fe11">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2012-09-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-02-26</dct:created>
      <rdf:value xml:lang="en">TAR – tape archive – is a computer software utility for collecting many files into one archive file, often referred to as a tarball, for distribution or backup purposes. GZ – gzip – is a file format and a software application used for file compression and decompression.</rdf:value>
      <dct:creator>Wikipedia</dct:creator>
      <euvoc:xlNote xml:lang="en">TAR – tape archive – is a computer software utility for collecting many files into one archive file, often referred to as a tarball, for distribution or backup purposes. GZ – gzip – is a file format and a software application used for file compression and decompression.</euvoc:xlNote>
   </euvoc:XlNote>
