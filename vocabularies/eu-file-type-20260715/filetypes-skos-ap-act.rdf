      <skos:altLabel xml:lang="en">Debian package</skos:altLabel>
      <skos:definition xml:lang="en">Debian package is a standard Unix ar archive that includes two tar archives. One archive holds the control information and another contains the installable data.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/vnd.debian.binary-package</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.deb</skos:notation>
      <skos:prefLabel xml:lang="et">deb</skos:prefLabel>
