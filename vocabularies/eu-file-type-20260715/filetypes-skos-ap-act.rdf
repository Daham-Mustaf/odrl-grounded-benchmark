            <at:legacy-code>.bz2</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <euvoc:isCompressedFormat rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</euvoc:isCompressedFormat>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/file-type/MRSID"
