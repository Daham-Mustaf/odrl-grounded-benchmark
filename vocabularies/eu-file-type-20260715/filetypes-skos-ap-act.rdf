   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/08dd5a954f5e2a52324a8895fdc7c02d">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2013-09-18</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-02-26</dct:created>
      <rdf:value xml:lang="en">MOP is a chemical file format used by MOPAC. MOPAC is a popular computer program used in computational chemistry. It is designed to implement semi-empirical quantum chemistry algorithms.</rdf:value>
      <dct:creator>Wikipedia</dct:creator>
      <euvoc:xlNote xml:lang="en">MOP is a chemical file format used by MOPAC. MOPAC is a popular computer program used in computational chemistry. It is designed to implement semi-empirical quantum chemistry algorithms.</euvoc:xlNote>
   </euvoc:XlNote>
