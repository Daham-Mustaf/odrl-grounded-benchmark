   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/e1d81d14975e064cf9d92732eaf9ed58">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2001-03-26</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-04-20</dct:created>
      <rdf:value xml:lang="en">A world file is a plain text computer data file used by geographic information systems (GIS) to georeference raster map images. The file extension usually depends on the format of the associated image, e.g. .jgw for JPEG (2000) or .tfw for TIFF.</rdf:value>
      <dct:creator>Wikipedia | http://inspire.ec.europa.eu/media-types/</dct:creator>
      <euvoc:xlNote xml:lang="en">A world file is a plain text computer data file used by geographic information systems (GIS) to georeference raster map images. The file extension usually depends on the format of the associated image, e.g. .jgw for JPEG (2000) or .tfw for TIFF.</euvoc:xlNote>
   </euvoc:XlNote>
