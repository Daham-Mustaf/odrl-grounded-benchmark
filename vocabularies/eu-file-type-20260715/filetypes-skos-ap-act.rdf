            <dc:source>file-extension</dc:source>
            <at:legacy-code>.tiff</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <euvoc:isImageFormat rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</euvoc:isImageFormat>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/file-type/DXF"
                 at:deprecated="false">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#FileType"/>
      <lemon:context rdf:resource="http://publications.europa.eu/resource/authority/use-context/IMMC"/>
      <lemon:context rdf:resource="http://publications.europa.eu/resource/authority/use-context/ODP"/>
