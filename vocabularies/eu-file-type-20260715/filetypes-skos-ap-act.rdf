   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/file-type/DWG"
                 at:deprecated="false">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#FileType"/>
      <lemon:context rdf:resource="http://publications.europa.eu/resource/authority/use-context/IMMC"/>
      <lemon:context rdf:resource="http://publications.europa.eu/resource/authority/use-context/ODP"/>
      <euvoc:context rdf:resource="http://publications.europa.eu/resource/authority/use-context/IMMC"/>
      <euvoc:context rdf:resource="http://publications.europa.eu/resource/authority/use-context/ODP"/>
