      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1999-04-01</euvoc:startDate>
      <rdf:value xml:lang="en">Formex 3 1.4.1999–30.4.2004: Structure language created and maintained by the Publications Office, on the basis of SGML. The character encoding is organised according to ISO 2022 and ISO 8856.</rdf:value>
      <euvoc:xlNote xml:lang="en">Formex 3 1.4.1999–30.4.2004: Structure language created and maintained by the Publications Office, on the basis of SGML. The character encoding is organised according to ISO 2022 and ISO 8856.</euvoc:xlNote>
      <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-11</dct:modified>
      <euvoc:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-04-30</euvoc:endDate>
