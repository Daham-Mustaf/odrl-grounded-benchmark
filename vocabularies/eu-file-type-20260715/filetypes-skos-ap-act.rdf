      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">Compressed Web Archive format</skos:altLabel>
      <skos:definition xml:lang="en">WARC is a web archive format which specifies a method for combining multiple digital resources into an aggregate archive file together with related information. WARC GZ is WARC compressed by GZIP.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/gzip</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.warc.gz</skos:notation>
      <skos:prefLabel xml:lang="et">WARC GZ</skos:prefLabel>
      <skos:prefLabel xml:lang="en">WARC GZ</skos:prefLabel>
