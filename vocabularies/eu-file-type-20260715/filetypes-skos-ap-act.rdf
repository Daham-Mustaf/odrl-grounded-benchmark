      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/92be4c5a1c8614dea721a2cf80fcd112"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/aa08b1629b4ecafa2ee024a79269ef24"/>
