      <dct:dateAccepted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-03-12</dct:dateAccepted>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-02-19</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">Resource Description Framework (RDF)</skos:altLabel>
      <skos:definition xml:lang="en">RDF – Resource Description Framework – is a standard model for data interchange on the Web. RDF has features that facilitate data merging. RDF extends the linking structure of the Web to use URIs to name the relationship between things as well as the two ends of the link (this is usually referred to as a ‘triple’). Using this simple model, it allows structured and semi-structured data to be mixed, exposed and shared across different applications. This linking structure forms a directed, labeled graph, where the edges represent the named link between two resources, represented by the graph nodes.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.rdf</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/rdf+xml</skos:notation>
      <skos:prefLabel xml:lang="et">RDF</skos:prefLabel>
      <skos:prefLabel xml:lang="en">RDF</skos:prefLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos-xl:altLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/a0ecc3f24b88f31207b70fa93b0578ac"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/ea891f29e772ccfbdaa1dda9e67bb690"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/4e23bd6d1e15369b796a07c1aa69fd98"/>
      <dc:identifier>RDF</dc:identifier>
      <at:op-code>RDF</at:op-code>
      <atold:op-code>RDF</atold:op-code>
      <at:start.use>2012-09-01</at:start.use>
      <at:authority-code>RDF</at:authority-code>
