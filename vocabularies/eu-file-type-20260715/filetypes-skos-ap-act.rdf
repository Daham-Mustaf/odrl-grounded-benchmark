      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">audio/mp4</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/mp4</skos:notation>
      <skos:prefLabel xml:lang="en">MPEG-4 AVC</skos:prefLabel>
