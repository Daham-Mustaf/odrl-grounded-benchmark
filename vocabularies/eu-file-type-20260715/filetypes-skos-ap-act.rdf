   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/015d62c1d13a9b2f8c1421f6bc977cec">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1997-01-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-05-29</dct:created>
      <rdf:value xml:lang="en">Advanced Audio Coding (AAC) is an audio coding standard for lossy digital audio compression. Designed to be the successor of the MP3 format, AAC generally achieves higher sound quality than MP3 at the same bit rate.</rdf:value>
      <dct:creator>Wikipedia</dct:creator>
      <dct:source>https://en.wikipedia.org/wiki/Advanced_Audio_Coding#Container_formats</dct:source>
      <euvoc:xlNote xml:lang="en">Advanced Audio Coding (AAC) is an audio coding standard for lossy digital audio compression. Designed to be the successor of the MP3 format, AAC generally achieves higher sound quality than MP3 at the same bit rate.</euvoc:xlNote>
   </euvoc:XlNote>
