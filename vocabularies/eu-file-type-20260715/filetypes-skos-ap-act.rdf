      <euvoc:context rdf:resource="http://publications.europa.eu/resource/authority/use-context/ODP"/>
      <euvoc:context rdf:resource="http://publications.europa.eu/resource/authority/use-context/CELLAR"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2010-01-01</euvoc:startDate>
      <euvoc:status rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT"/>
      <euvoc:xlDefinition rdf:resource="http://publications.europa.eu/resource/authority/file-type/e0dfcfad5d522e69580fcceab09158db"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/03c2a34833596a5d5170ca381ff6daaf"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-04-21</dct:created>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-04-22</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">Esri Representational State Transfer</skos:altLabel>
      <skos:definition xml:lang="en">Esri REST is a standard way for web clients to communicate with geographic information system (GIS) servers through Representational State Transfer (REST) technology.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">arcgis_rest</skos:notation>
