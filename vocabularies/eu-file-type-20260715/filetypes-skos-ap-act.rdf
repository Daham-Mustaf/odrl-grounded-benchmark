   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/286f38cd863536a8f7a89b5b1d6f49f0">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2011-12-27</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-04-07</dct:created>
      <rdf:value xml:lang="en">JSON-LD is a JSON-based format to serialize Linked Data. It is primarily intended to be a way to use Linked Data in Web-based programming environments, to build interoperable Web services, and to store Linked Data in JSON-based storage engines.</rdf:value>
      <dct:creator>http://www.w3.org/TR/json-ld/</dct:creator>
      <euvoc:xlNote xml:lang="en">JSON-LD is a JSON-based format to serialize Linked Data. It is primarily intended to be a way to use Linked Data in Web-based programming environments, to build interoperable Web services, and to store Linked Data in JSON-based storage engines.</euvoc:xlNote>
   </euvoc:XlNote>
