      <euvoc:context rdf:resource="http://publications.europa.eu/resource/authority/use-context/ODP"/>
      <euvoc:context rdf:resource="http://publications.europa.eu/resource/authority/use-context/CELLAR"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2012-09-01</euvoc:startDate>
      <euvoc:status rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT"/>
      <euvoc:xlDefinition rdf:resource="http://publications.europa.eu/resource/authority/file-type/8b9e12a6216769ee9ad17d9fe96bfec7"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/f62ff5789c8d0685c8eae0dfb6adce7c"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/f0b9536d3bc171439a2813ffa7dbb082"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/9a09843462dd98441d94ba9e51ac4b20"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2012-09-01</dct:created>
      <dct:dateAccepted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-03-12</dct:dateAccepted>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-02-19</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">XML Document Type Definition (DTD)</skos:altLabel>
      <skos:definition xml:lang="en">XML – Extensible Markup Language – is a markup language that defines a set of rules for encoding documents in a format that is both human-readable and machine-readable. DTD – document type definition – is a set of markup declarations that define a document type for an SGML-family markup language (SGML, XML, HTML). It defines the legal building blocks of an XML document, the document structure with a list of legal elements and attributes. XML uses a subset of SGML DTD.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.dtd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#CELLAR_MT">application/xml-dtd</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/xml-dtd</skos:notation>
      <skos:prefLabel xml:lang="et">XML DTD</skos:prefLabel>
      <skos:prefLabel xml:lang="en">XML DTD</skos:prefLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos-xl:altLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/71c329ed77e7ac14e4084fca4249a58a"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/50b284ed9a7451a016f995c7db448885"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/6eda779fc59fd33c2ce641993b898ce7"/>
      <dc:identifier>DTD_XML</dc:identifier>
      <at:op-code>DTD_XML</at:op-code>
      <atold:op-code>DTD_XML</atold:op-code>
      <at:start.use>2012-09-01</at:start.use>
      <at:authority-code>DTD_XML</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>file-extension</dc:source>
            <at:legacy-code>.dtd</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
