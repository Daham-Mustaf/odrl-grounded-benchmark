      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/geopackage+sqlite3</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#CELLAR_MANIFT">gpkg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.gpkg</skos:notation>
