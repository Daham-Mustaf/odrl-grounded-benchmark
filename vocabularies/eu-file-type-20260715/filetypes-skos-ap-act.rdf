      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-09-14</euvoc:startDate>
      <euvoc:status rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT"/>
      <euvoc:xlDefinition rdf:resource="http://publications.europa.eu/resource/authority/file-type/293ac5bc9db5485c3c5cff2259c2f7f7"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/89002448e9fb409cf979c7ad2d45a790"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/fc907fc083df222edb0712babb1cc36e"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-02-11</dct:created>
      <dct:dateAccepted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-03-08</dct:dateAccepted>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-02-22</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">OGC GeoTIFF</skos:altLabel>
      <skos:definition xml:lang="en">GeoTIFF is a public domain metadata standard which allows georeferencing information to be embedded within a TIFF file. The potential additional information includes map projection, coordinate systems, ellipsoids, datums, and everything else necessary to establish the exact spatial reference for the file.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.tiff</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">image/tiff</skos:notation>
      <skos:prefLabel xml:lang="et">GeoTIFF</skos:prefLabel>
      <skos:prefLabel xml:lang="en">GeoTIFF</skos:prefLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos-xl:altLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/3886f31de568a73b9e52b6e9fcb0cfba"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/d8aec7e74af9379a1c16d6249bfddbe0"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/9e3a313cf3583a06e1c62ef00de8a4bf"/>
      <dc:identifier>GEOTIFF</dc:identifier>
      <at:op-code>GEOTIFF</at:op-code>
      <atold:op-code>GEOTIFF</atold:op-code>
      <at:start.use>2019-09-14</at:start.use>
