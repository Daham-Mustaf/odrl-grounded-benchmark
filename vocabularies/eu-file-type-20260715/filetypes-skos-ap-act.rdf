   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/05eb063693feb70602eb643afe312ffc">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-01-02</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-05-29</dct:created>
      <rdf:value xml:lang="en">Scratch 3.0 is a file format used to store exported Scratch 3.0 projects and sprites. These are ZIP archives which contain information encoded in a text-based JSON format and project media in separate files.</rdf:value>
      <dct:creator>Scratch Wiki</dct:creator>
      <dct:source>https://en.scratch-wiki.info/wiki/Scratch_File_Format</dct:source>
      <euvoc:xlNote xml:lang="en">Scratch 3.0 is a file format used to store exported Scratch 3.0 projects and sprites. These are ZIP archives which contain information encoded in a text-based JSON format and project media in separate files.</euvoc:xlNote>
