      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/2262d03edf017f477f4b5da54813cdfc"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/c18500f09384fa64a82a34bf0da74989"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/9a48465f9b87ed33b730afefc30dde68"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/cabc0c9f06cd47e84a6d4b3f70a99621"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/e61635c56310e0fdb948f93b0729c83d"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/83ca06bae91e212be111f77389517ed0"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/796baa1823d52944f3474b54cda0b44b"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/1193baeb14d94734cb9ae63fdf11cb37"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-08-18</dct:created>
      <dct:dateAccepted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-09-09</dct:dateAccepted>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-08-22</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">Moving Picture Experts Group 4</skos:altLabel>
      <skos:definition xml:lang="en">MPEG-4 – Moving Picture Experts Group – is a method of defining compression of audio and visual (AV) digital data. It was designated a standard for a group of audio and video coding formats and related technology.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.mpeg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">mpg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">mp4</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">video/mp4</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">audio/mp4</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/mp4</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#CELLAR_MANIFT">mp4</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#CELLAR_MT">video/mp4</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#CELLAR_MT">audio/mp4</skos:notation>
      <skos:prefLabel xml:lang="et">MPEG-4</skos:prefLabel>
