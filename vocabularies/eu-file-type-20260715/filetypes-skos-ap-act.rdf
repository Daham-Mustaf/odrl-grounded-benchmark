      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-05-07</dct:created>
      <rdf:value xml:lang="en">An OGC GeoPackage is an open, standards-based, platform-independent, portable, self-describing, compact format for transferring geospatial information. It is implemented as a SQLite database container.</rdf:value>
