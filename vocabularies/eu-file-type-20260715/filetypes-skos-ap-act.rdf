   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/1b125384ed7e6f3eecb9e42fa7f6ee07">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2012-09-01</euvoc:startDate>
      <rdf:value xml:lang="en">In IMMC exchange context, DOC means releases from Word 97 and upwards.</rdf:value>
      <euvoc:xlNote xml:lang="en">In IMMC exchange context, DOC means releases from Word 97 and upwards.</euvoc:xlNote>
   </euvoc:XlNote>
   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/5538c34ea597c1d1ff14bda232485597">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1999-01-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-11-12</dct:created>
      <rdf:value xml:lang="en">A Web Map Service (WMS) is a standard protocol developed by the Open Geospatial Consortium (OGC) for serving georeferenced map images over the Internet. These images are typically produced by a map server from data provided by a geographic information system (GIS) database.</rdf:value>
      <dct:creator>Wikipedia</dct:creator>
      <dct:source>https://en.wikipedia.org/wiki/Web_Map_Service</dct:source>
      <euvoc:xlNote xml:lang="en">A Web Map Service (WMS) is a standard protocol developed by the Open Geospatial Consortium (OGC) for serving georeferenced map images over the Internet. These images are typically produced by a map server from data provided by a geographic information system (GIS) database.</euvoc:xlNote>
   </euvoc:XlNote>
