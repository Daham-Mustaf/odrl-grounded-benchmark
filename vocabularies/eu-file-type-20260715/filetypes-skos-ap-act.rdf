   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/37fba4ff3223d433f6953e9e8f96d680">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-09-27</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-08-25</dct:created>
      <rdf:value xml:lang="en">The General Transit Feed Specification (GTFS) is a data specification that allows public transit agencies to publish their transit data in a format that can be consumed by a wide variety of software applications. GTFS is split into a schedule component that contains schedule, fare, and geographic transit information and a real-time component that contains arrival predictions, vehicle positions and service advisories.</rdf:value>
      <dct:creator>MobilityData</dct:creator>
      <dct:source>https://gtfs.org</dct:source>
      <euvoc:xlNote xml:lang="en">The General Transit Feed Specification (GTFS) is a data specification that allows public transit agencies to publish their transit data in a format that can be consumed by a wide variety of software applications. GTFS is split into a schedule component that contains schedule, fare, and geographic transit information and a real-time component that contains arrival predictions, vehicle positions and service advisories.</euvoc:xlNote>
   </euvoc:XlNote>
