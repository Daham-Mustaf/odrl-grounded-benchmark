   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/c665c80dddf3dab790dff47c581b73f3">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1978-01-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-11-07</dct:created>
      <rdf:value xml:lang="en">An executable file (the main execution point of a computer program) for DOS, OpenVMS, Microsoft Windows, Symbian or OS/2. Besides the executable program, many .exe files contain other components called resources, such as bitmap graphics and icons which the executable program may use for its graphical user interface.</rdf:value>
      <dct:creator>Wikipedia</dct:creator>
      <dct:source>https://en.wikipedia.org/wiki/.exe</dct:source>
      <euvoc:xlNote xml:lang="en">An executable file (the main execution point of a computer program) for DOS, OpenVMS, Microsoft Windows, Symbian or OS/2. Besides the executable program, many .exe files contain other components called resources, such as bitmap graphics and icons which the executable program may use for its graphical user interface.</euvoc:xlNote>
   </euvoc:XlNote>
