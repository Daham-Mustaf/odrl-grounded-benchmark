   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/f19ca202a9a25c30147c311abc4e88c9">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1982-01-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-27</dct:created>
      <rdf:value xml:lang="en">A DXF file is a data file saved in a format developed by Autodesk and used for CAD (computer-aided design) vector image files, such as AutoCAD documents. DXF files are similar to .DWG files, but are more compatible with other programs since they are ASCII (text) based.</rdf:value>
      <dct:creator>The File Information Database</dct:creator>
      <dct:source>https://fileinfo.com/extension/dxf</dct:source>
      <euvoc:xlNote xml:lang="en">A DXF file is a data file saved in a format developed by Autodesk and used for CAD (computer-aided design) vector image files, such as AutoCAD documents. DXF files are similar to .DWG files, but are more compatible with other programs since they are ASCII (text) based.</euvoc:xlNote>
   </euvoc:XlNote>
