   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/5667be97827960bb8fa61b94f18e8743">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2010-01-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-02-11</dct:created>
      <rdf:value xml:lang="en">ArcGIS ungenerate creates a text file of x,y coordinates from the input coverage. It provides a useful mechanism to create simple coordinate files from coverages. This allows you to easily transfer coverages to other mapping systems or view and update individual coordinates using your computer’s text editor.</rdf:value>
      <dct:creator>ESRI</dct:creator>
      <dct:source>https://desktop.arcgis.com/en/arcmap/10.3/tools/coverage-toolbox/ungenerate.htm</dct:source>
      <euvoc:xlNote xml:lang="en">ArcGIS ungenerate creates a text file of x,y coordinates from the input coverage. It provides a useful mechanism to create simple coordinate files from coverages. This allows you to easily transfer coverages to other mapping systems or view and update individual coordinates using your computer’s text editor.</euvoc:xlNote>
   </euvoc:XlNote>
