      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-09-27</euvoc:startDate>
      <euvoc:status rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT"/>
      <euvoc:xlDefinition rdf:resource="http://publications.europa.eu/resource/authority/file-type/37fba4ff3223d433f6953e9e8f96d680"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/01c4754c1979219e2dcbc62966ca042a"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/36db591fbde83d5470d96078b88d9a82"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-08-25</dct:created>
      <dct:dateAccepted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-09-16</dct:dateAccepted>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-09-01</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">General Transit Feed Specification</skos:altLabel>
      <skos:definition xml:lang="en">The General Transit Feed Specification (GTFS) is a data specification that allows public transit agencies to publish their transit data in a format that can be consumed by a wide variety of software applications. GTFS is split into a schedule component that contains schedule, fare, and geographic transit information and a real-time component that contains arrival predictions, vehicle positions and service advisories.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/zip</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.zip</skos:notation>
      <skos:prefLabel xml:lang="et">GTFS</skos:prefLabel>
      <skos:prefLabel xml:lang="en">GTFS</skos:prefLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos-xl:altLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/22c798aa24eae8a49c493b2c22a430e0"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/c7c49c7bc2fce4ac411215674b8b53be"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/fd30a258a320b24ed68841329d04184e"/>
      <dc:identifier>GTFS</dc:identifier>
      <at:op-code>GTFS</at:op-code>
      <atold:op-code>GTFS</atold:op-code>
      <at:start.use>2006-09-27</at:start.use>
      <at:authority-code>GTFS</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>file-extension</dc:source>
            <at:legacy-code>.zip</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <euvoc:isCompressedFormat rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</euvoc:isCompressedFormat>
      <euvoc:isPackageFormat rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</euvoc:isPackageFormat>
      <euvoc:isGeographicalFormat rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</euvoc:isGeographicalFormat>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/file-type/BZIP2"
                 at:deprecated="false">
