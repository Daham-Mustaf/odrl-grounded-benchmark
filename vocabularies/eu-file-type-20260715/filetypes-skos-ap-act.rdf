   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/note_eca34b11">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-01-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-02-11</dct:created>
      <rdf:value xml:lang="en">rule-based validation language for making assertions about the structure and content of XML documents; it is expressed in XML using a small number of elements and XPath; it has been standardised as part of ISO/IEC 19757</rdf:value>
      <dct:creator>Publications Office of the European Union</dct:creator>
      <euvoc:xlNote xml:lang="en">rule-based validation language for making assertions about the structure and content of XML documents; it is expressed in XML using a small number of elements and XPath; it has been standardised as part of ISO/IEC 19757</euvoc:xlNote>
   </euvoc:XlNote>
