      <euvoc:status rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT"/>
      <euvoc:xlDefinition rdf:resource="http://publications.europa.eu/resource/authority/file-type/3ee36290b275c374dbacdda62a8fca23"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/064dc587146871645fcbcadb8ddf9cd6"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/eb40ecf30c3dbd28469d554208c367a3"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-05-15</dct:created>
      <dct:dateAccepted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-06-04</dct:dateAccepted>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-05-19</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">bzip2 compressed file</skos:altLabel>
      <skos:definition xml:lang="en">An open source, patent- and royalty-free compression format. The compression algorithm is a Burrows-Wheeler transform followed by a move-to-front transform and finally Huffman coding.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/x-bzip2</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.bz2</skos:notation>
      <skos:prefLabel xml:lang="en">bzip2</skos:prefLabel>
      <skos:prefLabel xml:lang="et">bzip2</skos:prefLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos-xl:altLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/18242ae506ac4d9df92e14da0725d8b3"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/da518859e90f6c4ed544c74517dd9a67"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/5941e4a971a3f3b4e05c682bbbafcc43"/>
      <dc:identifier>BZIP2</dc:identifier>
      <at:op-code>BZIP2</at:op-code>
      <atold:op-code>BZIP2</atold:op-code>
      <at:start.use>1996-07-18</at:start.use>
