   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/3ee36290b275c374dbacdda62a8fca23">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1996-07-18</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-05-29</dct:created>
      <rdf:value xml:lang="en">An open source, patent- and royalty-free compression format. The compression algorithm is a Burrows-Wheeler transform followed by a move-to-front transform and finally Huffman coding.</rdf:value>
      <dct:creator>Wikipedia</dct:creator>
      <dct:source>https://en.wikipedia.org/wiki/List_of_archive_formats</dct:source>
      <euvoc:xlNote xml:lang="en">An open source, patent- and royalty-free compression format. The compression algorithm is a Burrows-Wheeler transform followed by a move-to-front transform and finally Huffman coding.</euvoc:xlNote>
   </euvoc:XlNote>
