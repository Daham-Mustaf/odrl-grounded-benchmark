   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/fd6eef664767f5a14d8dbd596e1cf10a">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
