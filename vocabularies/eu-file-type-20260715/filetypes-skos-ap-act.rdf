      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2000-01-01</euvoc:startDate>
      <euvoc:status rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT"/>
      <euvoc:xlDefinition rdf:resource="http://publications.europa.eu/resource/authority/file-type/eb13ab3f09d1d4a7cd8a6637f25298a7"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/936d913b32574f9cd1f0729a4615b42d"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/222204781108ad25167f6ab6ec7b1f20"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-27</dct:created>
      <dct:dateAccepted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-16</dct:dateAccepted>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-01</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">DGN file</skos:altLabel>
      <skos:definition xml:lang="en">A DGN file is a 2D/3D drawing created by various construction CAD software, such as MicroStation and Intergraph Interactive Graphics Design System. It may be saved in one of two formats, either the Intergraph Standard File Format (ISFF) or the newer V8 DGN standard. DGN files are typically used to save designs for construction projects for highways, bridges, and buildings.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/octet-stream</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.dgn</skos:notation>
      <skos:prefLabel xml:lang="et">DGN</skos:prefLabel>
      <skos:prefLabel xml:lang="en">DGN</skos:prefLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos-xl:altLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/ac7c98ab5fae9a309cf408d54222b58d"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/ec2de81be9c3b88be007d3b7b2d18654"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/c9dffc1a6f7c6f302fa906934fc3a376"/>
      <dc:identifier>DGN</dc:identifier>
      <at:op-code>DGN</at:op-code>
      <atold:op-code>DGN</atold:op-code>
      <at:start.use>2000-01-01</at:start.use>
