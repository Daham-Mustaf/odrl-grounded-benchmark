      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2014-02-19</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">Compressed Tarball File</skos:altLabel>
      <skos:definition xml:lang="en">TAR – tape archive – is a computer software utility for collecting many files into one archive file, often referred to as a tarball, for distribution or backup purposes. GZ – gzip – is a file format and a software application used for file compression and decompression.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/gzip</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.tar.gz</skos:notation>
      <skos:prefLabel xml:lang="en">TAR GZ</skos:prefLabel>
      <skos:prefLabel xml:lang="et">TAR GZ</skos:prefLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
