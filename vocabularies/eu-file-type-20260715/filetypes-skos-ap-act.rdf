      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/15aa953103d58482329c6948728cd220"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-02-10</dct:created>
      <dct:dateAccepted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-03-02</dct:dateAccepted>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-02-16</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">Resource Description Framework in Attributes</skos:altLabel>
      <skos:definition xml:lang="en">RDFa is a technique that provides a set of markup attributes to augment the visual information on the Web with machine-readable hints.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/rdfa</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.rdfa</skos:notation>
      <skos:prefLabel xml:lang="et">RDFa</skos:prefLabel>
      <skos:prefLabel xml:lang="en">RDFa</skos:prefLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos-xl:altLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/fc06c6f2d1788f6d39b430334341035b"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/52910f89e5abbf08666ca60173c544b4"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/1917e6abe1a15ef287398d127020dadf"/>
      <dc:identifier>RDFA</dc:identifier>
