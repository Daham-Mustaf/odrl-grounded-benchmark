      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2013-09-26</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">MOPAC Input Format</skos:altLabel>
      <skos:definition xml:lang="en">MOP is a chemical file format used by MOPAC. MOPAC is a popular computer program used in computational chemistry. It is designed to implement semi-empirical quantum chemistry algorithms.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.mop</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">chemical/x-mopac-input</skos:notation>
      <skos:prefLabel xml:lang="en">MOP</skos:prefLabel>
      <skos:prefLabel xml:lang="et">MOP</skos:prefLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
