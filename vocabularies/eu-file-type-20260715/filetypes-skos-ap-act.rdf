   </euvoc:XlNotation>
   <skos-xl:Label rdf:about="http://publications.europa.eu/resource/authority/file-type/3f62724faa1ee66c48d4780efdf931ed">
      <rdf:type rdf:resource="http://www.w3.org/2008/05/skos-xl#Label"/>
