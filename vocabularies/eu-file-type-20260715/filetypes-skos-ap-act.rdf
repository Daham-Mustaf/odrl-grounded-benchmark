      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-02-10</dct:created>
      <rdf:value xml:lang="en">TriG allows an RDF dataset to be completely written in a compact and natural text form, with abbreviations for common usage patterns and datatypes. TriG is an extension of the Turtle format.</rdf:value>
