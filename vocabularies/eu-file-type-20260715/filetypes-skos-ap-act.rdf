      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/264414bafd0a4a84bac6a314c609cc7c"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/6644673dfdb4944951b44fc748e07acb"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-04-07</dct:created>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-04-22</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">Statistical Data and Metadata eXchange</skos:altLabel>
      <skos:definition xml:lang="en">SDMX is an initiative to foster standards for the exchange of statistical information. The SDMX message formats have two basic expressions, SDMX-ML (using XML syntax) and SDMX-EDI (using EDIFACT syntax and based on the GESMES/TS statistical message).</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.xml</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/xml</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/EDIFACT</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.edi</skos:notation>
      <skos:prefLabel xml:lang="et">SDMX</skos:prefLabel>
      <skos:prefLabel xml:lang="en">SDMX</skos:prefLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos-xl:altLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/6dd6bafbec7daf31a30f4df207b3b206"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/801e2f3bfba1a8d44077c7126659f1dc"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/d855c024e40fe82dc493bd976fc79206"/>
