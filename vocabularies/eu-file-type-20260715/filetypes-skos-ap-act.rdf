   <skos-xl:Label rdf:about="http://publications.europa.eu/resource/authority/file-type/89036a68bfc1cd0e898a762ebd7f6df1">
      <rdf:type rdf:resource="http://www.w3.org/2008/05/skos-xl#Label"/>
