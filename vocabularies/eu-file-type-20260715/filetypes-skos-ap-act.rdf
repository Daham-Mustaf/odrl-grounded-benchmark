      <euvoc:status rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT"/>
      <euvoc:xlDefinition rdf:resource="http://publications.europa.eu/resource/authority/file-type/bda73e2a46f1d42925cced17242261a1"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/cff8c86e877ba62fdf662e1e94bbea0b"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/4196cc4de59e9339d3ebf54c26db0ed1"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/30601881fc771e542fcb647f858d5a30"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-27</dct:created>
      <dct:dateAccepted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-16</dct:dateAccepted>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-01</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">DWG file</skos:altLabel>
      <skos:definition xml:lang="en">A DWG file is a 2D or 3D drawing created with Autodesk AutoCAD, a professional CAD program. It contains vector image data and metadata that AutoCAD and other CAD applications use to load a drawing. DWG files are related to .DXF files, which are ASCII versions of DWG files.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">image/vnd.dwg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/dwg</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.dwg</skos:notation>
      <skos:prefLabel xml:lang="en">DWG</skos:prefLabel>
      <skos:prefLabel xml:lang="et">DWG</skos:prefLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos-xl:altLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/fd1e5a9107ebd84c33d8ae712de8a5cc"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/53f70ce1ee69102721a0a6d17deaf01d"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/aedc24e03996354a3b1e7bc0278c893e"/>
      <dc:identifier>DWG</dc:identifier>
      <at:op-code>DWG</at:op-code>
      <atold:op-code>DWG</atold:op-code>
      <at:start.use>1982-01-01</at:start.use>
      <at:authority-code>DWG</at:authority-code>
      <at:op-mapped-code>
         <at:MappedCode>
            <dc:source>file-extension</dc:source>
            <at:legacy-code>.dwg</at:legacy-code>
         </at:MappedCode>
      </at:op-mapped-code>
      <euvoc:isImageFormat rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</euvoc:isImageFormat>
   </skos:Concept>
