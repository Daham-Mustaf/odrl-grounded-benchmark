      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/bd104b1b2168d48c47e990d9d750c134"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-05-08</dct:created>
      <dct:dateAccepted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-06-04</dct:dateAccepted>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-05-20</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">Header Dictionary Triples</skos:altLabel>
      <skos:definition xml:lang="en">HDT (Header, Dictionary, Triples) is a compact data structure and binary serialization format for Resource Description Framework (RDF) that keeps big datasets compressed to save space while maintaining search and browse operations without prior decompression.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/vnd.hdt</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.hdt</skos:notation>
      <skos:prefLabel xml:lang="et">HDT</skos:prefLabel>
      <skos:prefLabel xml:lang="en">HDT</skos:prefLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos-xl:altLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/5e8879d1451d4de27a88e85dd2ce7a55"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/f136224b707315f7b2c251ebf1228556"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/bac835ee35f9ea7c17409000c52a652a"/>
      <dc:identifier>HDT</dc:identifier>
      <at:op-code>HDT</at:op-code>
      <atold:op-code>HDT</atold:op-code>
