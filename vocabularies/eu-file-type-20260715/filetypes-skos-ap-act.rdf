   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/910224d4f42ddc86134e873f78588e74">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
