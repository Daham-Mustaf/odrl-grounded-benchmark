   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/302705702d290cccd7a360a9fadff59d">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2000-12-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-02-26</dct:created>
      <rdf:value xml:lang="en">MPEG-2 – Moving Picture Experts Group – is a standard for the generic coding of moving pictures and associated audio information. It describes a combination of lossy video compression and lossy audio data compression methods, which permit storage and transmission of movies using currently available storage media and transmission bandwidth.</rdf:value>
      <dct:creator>Wikipedia</dct:creator>
      <euvoc:xlNote xml:lang="en">MPEG-2 – Moving Picture Experts Group – is a standard for the generic coding of moving pictures and associated audio information. It describes a combination of lossy video compression and lossy audio data compression methods, which permit storage and transmission of movies using currently available storage media and transmission bandwidth.</euvoc:xlNote>
   </euvoc:XlNote>
