      <euvoc:isDocumentFormat rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</euvoc:isDocumentFormat>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/file-type/TAB"
                 at:deprecated="false">
