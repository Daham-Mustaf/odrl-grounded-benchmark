      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/63f857a8a99a851df808407368446e51"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-11-06</dct:created>
      <dct:dateAccepted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-11-28</dct:dateAccepted>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-11-14</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">Roshal Archive</skos:altLabel>
      <skos:definition xml:lang="en">RAR is a proprietary archive file format that supports data compression, error recovery and file spanning.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.r01</skos:notation>
