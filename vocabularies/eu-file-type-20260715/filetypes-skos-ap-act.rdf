   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/20f2e5a9ac9c69c436a954ea17170180">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2006-01-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-11-12</dct:created>
      <rdf:value xml:lang="en">The Open Geospatial Consortium Web Feature Service (WFS) Interface Standard provides an interface allowing requests for geospatial features across the web using platform-independent mechanisms and is independent of the underlying data store.</rdf:value>
      <dct:creator>Wikipedia</dct:creator>
      <dct:source>https://en.wikipedia.org/wiki/Web_Feature_Service</dct:source>
      <euvoc:xlNote xml:lang="en">The Open Geospatial Consortium Web Feature Service (WFS) Interface Standard provides an interface allowing requests for geospatial features across the web using platform-independent mechanisms and is independent of the underlying data store.</euvoc:xlNote>
   </euvoc:XlNote>
