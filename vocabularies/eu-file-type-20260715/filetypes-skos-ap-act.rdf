      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-08-22</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">Mbox</skos:altLabel>
      <skos:definition xml:lang="en">MBOX is a generic term for a family of related file formats used for holding collections of email messages. All messages in an mbox mailbox are concatenated and stored as plain text in a single file.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/mbox</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.mbox</skos:notation>
      <skos:prefLabel xml:lang="et">MBOX</skos:prefLabel>
      <skos:prefLabel xml:lang="en">MBOX</skos:prefLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
