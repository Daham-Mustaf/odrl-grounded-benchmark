   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/5e19f9dbca8aaa853aada80723cba2a8">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2012-07-15</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-11-04</dct:created>
      <rdf:value xml:lang="en">PDF/UA (PDF/Universal Accessibility), formally ISO 14289, is an International Organization for Standardization (ISO) standard for accessible PDF technology. A technical specification intended for developers implementing PDF writing and processing software, PDF/UA provides definitive terms and requirements for accessibility in PDF documents and applications. For those equipped with appropriate software, conformance with PDF/UA ensures accessibility for people with disabilities who use assistive technology such as screen readers, screen magnifiers, joysticks and other technologies to navigate and read electronic content.</rdf:value>
      <dct:creator>Wikipedia</dct:creator>
      <dct:source>https://en.wikipedia.org/wiki/PDF/UA</dct:source>
      <euvoc:xlNote xml:lang="en">PDF/UA (PDF/Universal Accessibility), formally ISO 14289, is an International Organization for Standardization (ISO) standard for accessible PDF technology. A technical specification intended for developers implementing PDF writing and processing software, PDF/UA provides definitive terms and requirements for accessibility in PDF documents and applications. For those equipped with appropriate software, conformance with PDF/UA ensures accessibility for people with disabilities who use assistive technology such as screen readers, screen magnifiers, joysticks and other technologies to navigate and read electronic content.</euvoc:xlNote>
   </euvoc:XlNote>
