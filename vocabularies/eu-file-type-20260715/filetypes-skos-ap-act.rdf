      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1982-01-01</euvoc:startDate>
      <euvoc:status rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT"/>
      <euvoc:xlDefinition rdf:resource="http://publications.europa.eu/resource/authority/file-type/f19ca202a9a25c30147c311abc4e88c9"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/108690c6bb410a8c44bbf57ce7a01aa7"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/fa7db03ab760e51f47a04cc572ead02c"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-08-27</dct:created>
      <dct:dateAccepted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-16</dct:dateAccepted>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-09-01</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">Drawing Interchange Format</skos:altLabel>
      <skos:definition xml:lang="en">A DXF file is a data file saved in a format developed by Autodesk and used for CAD (computer-aided design) vector image files, such as AutoCAD documents. DXF files are similar to .DWG files, but are more compatible with other programs since they are ASCII (text) based.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.dxf</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">image/vnd.dxf</skos:notation>
      <skos:prefLabel xml:lang="et">DXF</skos:prefLabel>
      <skos:prefLabel xml:lang="en">DXF</skos:prefLabel>
      <skos:topConceptOf rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos-xl:altLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/3658ffe5e4d37cee6f4c942240c2ea6b"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/13415259c91956a7c1dfb2c029b7985c"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/2208d4f95222a219d5b1429fc4919406"/>
      <dc:identifier>DXF</dc:identifier>
      <at:op-code>DXF</at:op-code>
      <atold:op-code>DXF</atold:op-code>
      <at:start.use>1982-01-01</at:start.use>
      <at:authority-code>DXF</at:authority-code>
