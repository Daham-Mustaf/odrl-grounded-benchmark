   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/c2b9f2a0fc6d868d3e14c1f065508e9c">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2011-03-30</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2019-05-08</dct:created>
      <rdf:value xml:lang="en">HDT (Header, Dictionary, Triples) is a compact data structure and binary serialization format for Resource Description Framework (RDF) that keeps big datasets compressed to save space while maintaining search and browse operations without prior decompression.</rdf:value>
      <dct:creator>RDF/HDT</dct:creator>
      <dct:source>http://www.rdfhdt.org/what-is-hdt/</dct:source>
      <euvoc:xlNote xml:lang="en">HDT (Header, Dictionary, Triples) is a compact data structure and binary serialization format for Resource Description Framework (RDF) that keeps big datasets compressed to save space while maintaining search and browse operations without prior decompression.</euvoc:xlNote>
   </euvoc:XlNote>
