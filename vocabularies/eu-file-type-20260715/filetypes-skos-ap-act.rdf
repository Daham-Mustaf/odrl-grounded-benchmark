   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/639a42b29675fce2fcac641a2307b1bb">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1986-01-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2022-02-11</dct:created>
      <rdf:value xml:lang="en">MapInfo interchange format is a map and database exporting file format of MapInfo software product. The MIF-file filename usually ends with .mif-suffix. Some MIF-files also have a related MID-file. The filename of a MID-file usually ends with .mid-suffix.</rdf:value>
      <dct:creator>Wikipedia</dct:creator>
      <dct:source>https://en.wikipedia.org/wiki/MapInfo_Interchange_Format</dct:source>
      <euvoc:xlNote xml:lang="en">MapInfo interchange format is a map and database exporting file format of MapInfo software product. The MIF-file filename usually ends with .mif-suffix. Some MIF-files also have a related MID-file. The filename of a MID-file usually ends with .mid-suffix.</euvoc:xlNote>
   </euvoc:XlNote>
