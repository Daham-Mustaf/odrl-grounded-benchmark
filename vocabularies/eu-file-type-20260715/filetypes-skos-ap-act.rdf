   <euvoc:XlNote rdf:about="http://publications.europa.eu/resource/authority/file-type/5b88ef5107aa958bb03a2153c082b8f3">
      <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#XlNote"/>
      <euvoc:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">1999-04-01</euvoc:startDate>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2018-02-26</dct:created>
      <rdf:value xml:lang="en">Formex describes the format for the exchange of data between the Publication Office and its contractors. In particular, it defines the logical markup for documents which are published in the different series of the Offical Journal of the European Union. Formex 3 was a previous version of Formex actually used.</rdf:value>
      <dct:creator>Wikipedia</dct:creator>
      <euvoc:xlNote xml:lang="en">Formex describes the format for the exchange of data between the Publication Office and its contractors. In particular, it defines the logical markup for documents which are published in the different series of the Offical Journal of the European Union. Formex 3 was a previous version of Formex actually used.</euvoc:xlNote>
      <euvoc:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2004-04-30</euvoc:endDate>
   </euvoc:XlNote>
