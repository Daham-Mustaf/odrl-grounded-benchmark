      <euvoc:status rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT"/>
      <euvoc:xlDefinition rdf:resource="http://publications.europa.eu/resource/authority/file-type/c5eed180687905612b53792b406a0017"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/13fa075dcad324b713aa2829e6b8eb5e"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/b334c2acf9bc8664959f57932deedb05"/>
      <euvoc:xlNotation rdf:resource="http://publications.europa.eu/resource/authority/file-type/a3a2aa9f9897ee26bd21dd3a81122933"/>
      <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-04-21</dct:created>
      <dct:dateSubmitted rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2015-04-22</dct:dateSubmitted>
      <owl:versionInfo>20260715-0</owl:versionInfo>
      <skos:altLabel xml:lang="en">Atom Syndication Format</skos:altLabel>
      <skos:definition xml:lang="en">The Atom Feed or Atom Syndication Format is an XML language used for web feeds. Web feeds allow software programs to check for updates published on a website.</skos:definition>
      <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.xml</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#FILE_EXT">.atom</skos:notation>
      <skos:notation rdf:datatype="http://publications.europa.eu/ontology/euvoc#IANA_MT">application/atom+xml</skos:notation>
      <skos:prefLabel xml:lang="et">Atom voog</skos:prefLabel>
      <skos:prefLabel xml:lang="en">Atom Feed</skos:prefLabel>
