      <euvoc:isDocumentFormat rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</euvoc:isDocumentFormat>
      <euvoc:isPackageFormat rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</euvoc:isPackageFormat>
      <euvoc:xlHistoryNote rdf:resource="http://publications.europa.eu/resource/authority/file-type/6e0e8cd6bb76f676bfbe237bc6354a8c"/>
      <euvoc:xlHistoryNote rdf:resource="http://publications.europa.eu/resource/authority/file-type/72b95097446e5d1bf0f184d5ce827084"/>
      <skos:historyNote xml:lang="en">PDF/A-1 is based on the PDF Reference Version 1.4 from Adobe Systems Inc. implemented in Adobe Acrobat 5 and latest versions. PDF/A-1 is also called "web optimised".</skos:historyNote>
      <skos:historyNote xml:lang="en">ISO 19005-1</skos:historyNote>
   </skos:Concept>
   <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/file-type/GEOTIFF"
                 at:deprecated="false">
      <rdf:type rdf:resource="http://publications.europa.eu/ontology/euvoc#FileType"/>
      <lemon:context rdf:resource="http://publications.europa.eu/resource/authority/use-context/IMMC"/>
