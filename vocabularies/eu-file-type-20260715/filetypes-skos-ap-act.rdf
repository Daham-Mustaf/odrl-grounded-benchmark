      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/31fcc61a9ac21d613320f05010a8d501"/>
      <skos-xl:prefLabel rdf:resource="http://publications.europa.eu/resource/authority/file-type/119e528be775568c8649c2b617c3055e"/>
      <dc:identifier>UNGEN</dc:identifier>
      <at:op-code>UNGEN</at:op-code>
      <atold:op-code>UNGEN</atold:op-code>
